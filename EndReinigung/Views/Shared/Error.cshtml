@model ErrorViewModel
@{
    ViewData["Title"] = "Fehler – Zürich Endreinigung";
    ViewData["Description"] = "Es ist ein Fehler aufgetreten.";
}

<div class="min-h-screen flex items-center justify-center bg-gray-100">
    <div class="text-center px-4">
        <h1 class="text-4xl font-bold mb-4">Etwas ist schiefgelaufen</h1>
        <p class="text-xl text-gray-600 mb-4">Bitte versuchen Sie es erneut oder kehren Sie zur Startseite zurück.</p>
        <a href="/" class="text-blue-500 hover:text-blue-700 underline">
            Zurück zur Startseite
        </a>
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/_Footer.cshtml")
