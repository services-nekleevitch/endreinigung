<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Endreinigung Zürich | 100% Abnahmegarantie")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Professionelle Endreinigung & Umzugsreinigung in Zürich mit 100% Abnahmegarantie. Fixpreis, persönliche Anwesenheit bei der Übergabe. Jetzt buchen!")" />
    @if (ViewData["Keywords"] != null)
    {
        <meta name="keywords" content="@ViewData["Keywords"]" />
    }
    @{
        var canonicalUrl = (string)(ViewData["Canonical"] ?? "https://zurich-endreinigung.ch/");
        var canonicalBase = canonicalUrl.Contains('?') ? canonicalUrl.Substring(0, canonicalUrl.IndexOf('?')) : canonicalUrl;
        var sep = canonicalBase.Contains('?') ? "&" : "?";
    }
    <link rel="canonical" href="@canonicalUrl" />
    <link rel="alternate" hreflang="de" href="@(canonicalBase)@(sep)culture=de" />
    <link rel="alternate" hreflang="en" href="@(canonicalBase)@(sep)culture=en" />
    <link rel="alternate" hreflang="x-default" href="@(canonicalBase)@(sep)culture=de" />

    <!-- Open Graph -->
    <meta property="og:title" content="@(ViewData["Title"] ?? "Endreinigung Zürich | 100% Abnahmegarantie")" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Professionelle Endreinigung & Umzugsreinigung in Zürich mit 100% Abnahmegarantie.")" />
    <meta property="og:url" content="@(ViewData["Canonical"] ?? "https://zurich-endreinigung.ch/")" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS (pre-built) -->
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />

    <!-- Site CSS (variables + base styles) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Head", required: false)

    <!-- JSON-LD Schema -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "LocalBusiness",
        "additionalType": "https://schema.org/HouseCleaningService",
        "name": "Zürich Endreinigung",
        "url": "https://zurich-endreinigung.ch",
        "telephone": "+41765017738",
        "email": "info@zurich-endreinigung.ch",
        "address": {
            "@@type": "PostalAddress",
            "streetAddress": "Seewadelstrasse 5",
            "addressLocality": "Affoltern am Albis",
            "postalCode": "8910",
            "addressCountry": "CH"
        },
        "areaServed": {
            "@@type": "State",
            "name": "Kanton Zürich"
        },
        "priceRange": "CHF 320 - CHF 1350+",
        "aggregateRating": {
            "@@type": "AggregateRating",
            "ratingValue": "4.9",
            "reviewCount": "50",
            "bestRating": "5"
        }
    }
    </script>
</head>
<body>
    @await Html.PartialAsync("_Navigation")

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
