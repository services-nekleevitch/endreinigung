<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Endreinigung Zürich | 100% Abnahmegarantie")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Professionelle Endreinigung & Umzugsreinigung in Zürich mit 100% Abnahmegarantie. Fixpreis, persönliche Anwesenheit bei der Übergabe. Jetzt buchen!")" />
    @if (ViewData["Keywords"] != null)
    {
        <meta name="keywords" content="@ViewData["Keywords"]" />
    }
    @{
        var canonicalUrl = (string)(ViewData["Canonical"] ?? "https://zurich-endreinigung.ch/");
        var canonicalBase = canonicalUrl.Contains('?') ? canonicalUrl.Substring(0, canonicalUrl.IndexOf('?')) : canonicalUrl;
        var hasQuery = Context.Request.Query.Any();
    }
    @if (hasQuery)
    {
        <meta name="robots" content="noindex,follow" />
    }
    <link rel="canonical" href="@canonicalBase" />

    <!-- Open Graph -->
    <meta property="og:title" content="@(ViewData["Title"] ?? "Endreinigung Zürich | 100% Abnahmegarantie")" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Professionelle Endreinigung & Umzugsreinigung in Zürich mit 100% Abnahmegarantie.")" />
    <meta property="og:url" content="@canonicalBase" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Google Analytics: stub functions + Consent Mode v2 defaults only.
         The gtag.js script itself is injected by _CookieConsent.cshtml after the
         user accepts cookies, so visitors who decline (or haven't decided yet)
         never download or execute the ~50 KiB tag manager script. -->
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('consent', 'default', {
            'ad_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied',
            'analytics_storage': 'denied'
        });
    </script>

    <!-- Inter Font: non-blocking via media="print" + onload swap.
         display=swap renders fallback text immediately; this avoids blocking the
         critical render path on the 200ms+ Google Fonts chain. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" /></noscript>

    <!-- Tailwind CSS (pre-built) -->
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />

    <!-- Site CSS inlined: design tokens + base styles + FAQ/carousel.
         Tiny payload (~3 KiB) but saves a round-trip — was the last item in the critical path. -->
    <style>:root{--background:0 0% 100%;--foreground:210 25% 15%;--card:0 0% 100%;--card-foreground:210 25% 15%;--popover:0 0% 100%;--popover-foreground:210 25% 15%;--primary:210 95% 25%;--primary-foreground:0 0% 100%;--primary-light:210 90% 40%;--primary-glow:210 100% 60%;--secondary:210 15% 96%;--secondary-foreground:210 25% 15%;--muted:210 15% 96%;--muted-foreground:210 15% 45%;--accent:45 100% 95%;--accent-foreground:210 25% 15%;--destructive:0 84.2% 60.2%;--destructive-foreground:0 0% 100%;--border:210 20% 90%;--input:210 20% 90%;--ring:210 95% 25%;--swiss-blue:210 95% 25%;--swiss-blue-light:210 85% 45%;--swiss-blue-dark:210 100% 15%;--cleaning-green:150 75% 45%;--trust-gold:45 95% 55%;--booking-orange:25 95% 65%;--booking-orange-light:35 100% 70%;--booking-orange-dark:20 85% 55%;--navy-bg:218 63% 15%;--navy-border:218 55% 24%;--navy-muted:216 36% 47%;--navy-text:213 40% 68%;--navy-light:213 70% 87%;--red-accent:1 78% 55%;--gold-rating:37 91% 55%;--gradient-hero:linear-gradient(135deg,hsl(var(--swiss-blue)),hsl(var(--swiss-blue-light)));--gradient-card:linear-gradient(145deg,hsl(0 0% 100%),hsl(210 20% 98%));--gradient-accent:linear-gradient(90deg,hsl(var(--trust-gold)),hsl(45 85% 65%));--gradient-pricing:linear-gradient(135deg,hsl(var(--booking-orange)),hsl(var(--booking-orange-light)));--shadow-card:0 4px 20px hsl(var(--swiss-blue)/0.08);--shadow-hero:0 8px 40px hsl(var(--swiss-blue)/0.15);--shadow-button:0 2px 8px hsl(var(--swiss-blue)/0.2);--font-heading:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;--font-body:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;--radius:0.75rem;--section-padding:6rem;--container-padding:2rem;--transition-smooth:all 0.3s cubic-bezier(0.4,0,0.2,1);--transition-bounce:all 0.5s cubic-bezier(0.68,-0.55,0.265,1.55)}*{border-color:hsl(var(--border));font-family:var(--font-body)}body{background-color:hsl(var(--background));color:hsl(var(--foreground));-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;margin:0}h1,h2,h3,h4,h5,h6{font-family:var(--font-heading)}html{scroll-behavior:smooth}*:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--swiss-blue)),0 0 0 4px hsl(var(--background))}a:visited h3{color:inherit}.faq-item .faq-answer{max-height:0;overflow:hidden;transition:max-height 0.3s ease-out,padding 0.3s ease-out}.faq-item.open .faq-answer{max-height:2000px;transition:max-height 0.5s ease-in}.faq-item .faq-chevron{transition:transform 0.3s ease}.faq-item.open .faq-chevron{transform:rotate(180deg)}.carousel-container{position:relative;overflow:hidden}.carousel-track{display:flex;transition:transform 0.5s ease;-webkit-user-select:none;user-select:none}.carousel-slide{flex:0 0 100%;min-width:0}@@media(min-width:768px){.carousel-slide.third{flex:0 0 50%}}@@media(min-width:1024px){.carousel-slide.third{flex:0 0 33.333%}}.carousel-track img{-webkit-user-drag:none;pointer-events:none}</style>

    @{
        var heroPreload = (string?)ViewData["HeroPreload"];
        var heroPreloadMobile = (string?)ViewData["HeroPreloadMobile"];
        var heroPreloadType = (string?)ViewData["HeroPreloadType"] ?? "image/webp";
    }
    @if (!string.IsNullOrEmpty(heroPreload))
    {
        if (!string.IsNullOrEmpty(heroPreloadMobile))
        {
            <link rel="preload" as="image" imagesrcset="@heroPreloadMobile 768w, @heroPreload 1920w" imagesizes="100vw" type="@heroPreloadType" fetchpriority="high" />
        }
        else
        {
            <link rel="preload" as="image" href="@heroPreload" type="@heroPreloadType" fetchpriority="high" />
        }
    }

    @RenderSection("Head", required: false)

    <!-- JSON-LD Schema -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "LocalBusiness",
        "inLanguage": "de-CH",
        "additionalType": "https://schema.org/HouseCleaningService",
        "name": "Zürich Endreinigung",
        "url": "https://zurich-endreinigung.ch",
        "telephone": "+41765017738",
        "email": "info@zurich-endreinigung.ch",
        "address": {
            "@@type": "PostalAddress",
            "streetAddress": "Seewadelstrasse 5",
            "addressLocality": "Affoltern am Albis",
            "postalCode": "8910",
            "addressCountry": "CH"
        },
        "areaServed": {
            "@@type": "State",
            "name": "Kanton Zürich"
        },
        "priceRange": "CHF 320 - CHF 1350+",
        "aggregateRating": {
            "@@type": "AggregateRating",
            "ratingValue": "4.9",
            "reviewCount": "50",
            "bestRating": "5"
        }
    }
    </script>
</head>
<body>
    @await Html.PartialAsync("_Navigation")

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await Html.PartialAsync("_WhatsAppFloat")
    @await Html.PartialAsync("_CookieConsent")
    @RenderSection("Scripts", required: false)
</body>
</html>
