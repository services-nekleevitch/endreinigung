<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Endreinigung Zürich | 100% Abnahmegarantie")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Professionelle Endreinigung & Umzugsreinigung in Zürich mit 100% Abnahmegarantie. Fixpreis, persönliche Anwesenheit bei der Übergabe. Jetzt buchen!")" />
    @if (ViewData["Keywords"] != null)
    {
        <meta name="keywords" content="@ViewData["Keywords"]" />
    }
    @{
        var canonicalUrl = (string)(ViewData["Canonical"] ?? "https://zurich-endreinigung.ch/");
        var canonicalBase = canonicalUrl.Contains('?') ? canonicalUrl.Substring(0, canonicalUrl.IndexOf('?')) : canonicalUrl;
        var hasQuery = Context.Request.Query.Any();
    }
    @if (hasQuery)
    {
        <meta name="robots" content="noindex,follow" />
    }
    <link rel="canonical" href="@canonicalBase" />

    <!-- Open Graph -->
    <meta property="og:title" content="@(ViewData["Title"] ?? "Endreinigung Zürich | 100% Abnahmegarantie")" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Professionelle Endreinigung & Umzugsreinigung in Zürich mit 100% Abnahmegarantie.")" />
    <meta property="og:url" content="@canonicalBase" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS (pre-built) -->
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />

    <!-- Site CSS (variables + base styles) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Head", required: false)

    <!-- JSON-LD Schema -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "LocalBusiness",
        "additionalType": "https://schema.org/HouseCleaningService",
        "name": "Zürich Endreinigung",
        "url": "https://zurich-endreinigung.ch",
        "telephone": "+41765017738",
        "email": "info@zurich-endreinigung.ch",
        "address": {
            "@@type": "PostalAddress",
            "streetAddress": "Seewadelstrasse 5",
            "addressLocality": "Affoltern am Albis",
            "postalCode": "8910",
            "addressCountry": "CH"
        },
        "areaServed": {
            "@@type": "State",
            "name": "Kanton Zürich"
        },
        "priceRange": "CHF 320 - CHF 1350+",
        "aggregateRating": {
            "@@type": "AggregateRating",
            "ratingValue": "5",
            "reviewCount": "50",
            "bestRating": "5"
        }
    }
    </script>
</head>
<body>
    @await Html.PartialAsync("_Navigation")

    <main role="main">
        @RenderBody()
    </main>

    <a href="https://wa.me/41765017738"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="WhatsApp +41 76 501 77 38"
       class="fixed bottom-5 left-5 z-50 w-14 h-14 rounded-full bg-[#25D366] hover:bg-[#1ebe57] shadow-[0_6px_20px_rgba(37,211,102,0.45)] flex items-center justify-center transition-colors">
        <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
        </svg>
    </a>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
