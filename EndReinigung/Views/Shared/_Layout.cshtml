<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Endreinigung Zürich | 100% Abnahmegarantie")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Professionelle Endreinigung & Umzugsreinigung in Zürich mit 100% Abnahmegarantie. Fixpreis, persönliche Anwesenheit bei der Übergabe. Jetzt buchen!")" />
    @if (ViewData["Keywords"] != null)
    {
        <meta name="keywords" content="@ViewData["Keywords"]" />
    }
    @{
        var canonicalUrl = (string)(ViewData["Canonical"] ?? "https://zurich-endreinigung.ch/");
        var canonicalBase = canonicalUrl.Contains('?') ? canonicalUrl.Substring(0, canonicalUrl.IndexOf('?')) : canonicalUrl;
        var hasQuery = Context.Request.Query.Any();
    }
    @if (hasQuery)
    {
        <meta name="robots" content="noindex,follow" />
    }
    <link rel="canonical" href="@canonicalBase" />

    <!-- Open Graph -->
    <meta property="og:title" content="@(ViewData["Title"] ?? "Endreinigung Zürich | 100% Abnahmegarantie")" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Professionelle Endreinigung & Umzugsreinigung in Zürich mit 100% Abnahmegarantie.")" />
    <meta property="og:url" content="@canonicalBase" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Google Analytics: stub functions + Consent Mode v2 defaults only.
         The gtag.js script itself is injected by _CookieConsent.cshtml after the
         user accepts cookies, so visitors who decline (or haven't decided yet)
         never download or execute the ~50 KiB tag manager script. -->
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('consent', 'default', {
            'ad_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied',
            'analytics_storage': 'denied'
        });
    </script>

    <!-- Inter Font: non-blocking via media="print" + onload swap.
         display=swap renders fallback text immediately; this avoids blocking the
         critical render path on the 200ms+ Google Fonts chain. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" /></noscript>

    <!-- Tailwind CSS (pre-built) -->
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />

    <!-- Site CSS (variables + base styles) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @{
        var heroPreload = (string?)ViewData["HeroPreload"];
        var heroPreloadType = (string?)ViewData["HeroPreloadType"] ?? "image/webp";
    }
    @if (!string.IsNullOrEmpty(heroPreload))
    {
        <link rel="preload" as="image" href="@heroPreload" type="@heroPreloadType" fetchpriority="high" />
    }

    @RenderSection("Head", required: false)

    <!-- JSON-LD Schema -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "LocalBusiness",
        "additionalType": "https://schema.org/HouseCleaningService",
        "name": "Zürich Endreinigung",
        "url": "https://zurich-endreinigung.ch",
        "telephone": "+41765017738",
        "email": "info@zurich-endreinigung.ch",
        "address": {
            "@@type": "PostalAddress",
            "streetAddress": "Seewadelstrasse 5",
            "addressLocality": "Affoltern am Albis",
            "postalCode": "8910",
            "addressCountry": "CH"
        },
        "areaServed": {
            "@@type": "State",
            "name": "Kanton Zürich"
        },
        "priceRange": "CHF 320 - CHF 1350+",
        "aggregateRating": {
            "@@type": "AggregateRating",
            "ratingValue": "4.9",
            "reviewCount": "50",
            "bestRating": "5"
        }
    }
    </script>
</head>
<body>
    @await Html.PartialAsync("_Navigation")

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await Html.PartialAsync("_WhatsAppFloat")
    @await Html.PartialAsync("_CookieConsent")
    @RenderSection("Scripts", required: false)
</body>
</html>
