<!-- Trust Bar -->
<section class="py-6 md:py-12 bg-background border-y border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8">
            <!-- Haftpflichtversichert -->
            <div class="flex flex-col items-center text-center">
                <div class="w-10 h-10 md:w-14 md:h-14 bg-primary/10 rounded-full flex items-center justify-center mb-3 md:mb-4">
                    <svg class="w-5 h-5 md:w-7 md:h-7 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <h2 class="text-sm md:text-base font-semibold text-foreground">@SharedLocalizer["trust.insured"]</h2>
                <p class="text-xs md:text-sm text-muted-foreground mt-1">@SharedLocalizer["trust.insured_sub"]</p>
            </div>
            <!-- 100% Abnahmegarantie -->
            <div class="flex flex-col items-center text-center">
                <div class="w-10 h-10 md:w-14 md:h-14 bg-primary/10 rounded-full flex items-center justify-center mb-3 md:mb-4">
                    <svg class="w-5 h-5 md:w-7 md:h-7 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                </div>
                <h2 class="text-sm md:text-base font-semibold text-foreground">@SharedLocalizer["trust.guarantee"]</h2>
                <p class="text-xs md:text-sm text-muted-foreground mt-1">@SharedLocalizer["trust.guarantee_sub"]</p>
            </div>
            <!-- Expat-Friendly -->
            <div class="flex flex-col items-center text-center">
                <div class="w-10 h-10 md:w-14 md:h-14 bg-primary/10 rounded-full flex items-center justify-center mb-3 md:mb-4">
                    <svg class="w-5 h-5 md:w-7 md:h-7 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4-4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                </div>
                <h2 class="text-sm md:text-base font-semibold text-foreground">@SharedLocalizer["trust.expat"]</h2>
                <p class="text-xs md:text-sm text-muted-foreground mt-1">@SharedLocalizer["trust.expat_sub"]</p>
            </div>
            <!-- Sofort-Buchung -->
            <div class="flex flex-col items-center text-center">
                <div class="w-10 h-10 md:w-14 md:h-14 bg-primary/10 rounded-full flex items-center justify-center mb-3 md:mb-4">
                    <svg class="w-5 h-5 md:w-7 md:h-7 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <h2 class="text-sm md:text-base font-semibold text-foreground">@SharedLocalizer["trust.booking"]</h2>
                <p class="text-xs md:text-sm text-muted-foreground mt-1">@SharedLocalizer["trust.booking_sub"]</p>
            </div>
        </div>
    </div>
</section>
