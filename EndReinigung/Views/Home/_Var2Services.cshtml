<!-- Additional Services -->
<section class="py-12 md:py-24 bg-gradient-to-b from-secondary to-background">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8 md:mb-12">
            <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-foreground mb-4">
                @SharedLocalizer["services.title_1"] <span class="text-primary">@SharedLocalizer["services.title_2"]</span>
            </h2>
            <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto">@SharedLocalizer["services.subtitle"]</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            @{
                var services = new[] {
                    new { Img = "/img/services/umzugsreinigung.jpg", Cat = "UMZUGSREINIGUNG", Name = "Umzugsreinigung", Desc = "Professionelle Umzugsreinigung mit Fixpreis und 100% Abnahmegarantie — Kaution zurück garantiert.", Href = "/umzugsreinigung-zuerich" },
                    new { Img = "/img/services/baureinigung.avif", Cat = "BAUREINIGUNG", Name = "Baureinigung", Desc = "Professionelle Reinigung nach Umbau oder Renovation — staubfrei und bezugsbereit.", Href = "/baureinigung" },
                    new { Img = "/img/services/fensterreinigung.jpg", Cat = "SPEZIALREINIGUNG", Name = "Fensterreinigung", Desc = "Streifenfreie Fenster innen & aussen, inkl. Rahmen und Fensterbänke.", Href = "/fensterreinigung" },
                    new { Img = "/img/services/bueroreinigung.jpg", Cat = "REINIGUNG", Name = "Büroreinigung", Desc = "Regelmässige Büroreinigung für saubere Arbeitsplätze — flexibel und zuverlässig.", Href = "/bueroreinigung" },
                    new { Img = "/img/services/tapeten-entfernen.avif", Cat = "RENOVATION", Name = "Tapeten entfernen", Desc = "Fachgerechtes Entfernen alter Tapeten — sauber und rückstandsfrei.", Href = "/tapeten-entfernen" },
                    new { Img = "/img/services/praxisreinigung.jpg", Cat = "SPEZIALREINIGUNG", Name = "Praxisreinigung", Desc = "Hygienische Reinigung für Arztpraxen, Zahnarztpraxen und Therapieräume.", Href = "/praxisreinigung" },
                    new { Img = "/img/services/event-reinigung.jpg", Cat = "REINIGUNG", Name = "Event Reinigung", Desc = "After-Party Reinigung für Veranstaltungen und Feiern jeder Grösse.", Href = "/event-reinigung" },
                    new { Img = "/img/services/polsterreinigung.avif", Cat = "SPEZIALREINIGUNG", Name = "Polsterreinigung", Desc = "Tiefenreinigung für Sofas, Sessel und Polstermöbel — hygienisch sauber.", Href = "/polsterreinigung" },
                    new { Img = "/img/services/teppichreinigung.avif", Cat = "SPEZIALREINIGUNG", Name = "Teppichreinigung", Desc = "Professionelle Teppichreinigung mit Fleckenentfernung und Auffrischung.", Href = "/teppichreinigung" },
                    new { Img = "/img/services/matratzenreinigung.jpg", Cat = "SPEZIALREINIGUNG", Name = "Matratzenreinigung", Desc = "Hygienische Tiefenreinigung für Matratzen — gegen Milben und Allergene.", Href = "/matratzenreinigung" },
                    new { Img = "/img/services/grundreinigung.jpg", Cat = "REINIGUNG", Name = "Grundreinigung", Desc = "Intensive Komplettreinigung aller Räume für ein strahlendes Zuhause.", Href = "/grundreinigung" },
                    new { Img = "/img/services/airbnb-reinigung.jpg", Cat = "REINIGUNG", Name = "Airbnb Reinigung", Desc = "Zuverlässige Reinigung zwischen Gästewechseln für Top-Bewertungen.", Href = "/airbnb-reinigung-zuerich" },
                    new { Img = "/img/services/boot-reinigung.jpg", Cat = "SPEZIALREINIGUNG", Name = "Boot Reinigung", Desc = "Professionelle Innen- und Aussenreinigung für Boote am Zürichsee.", Href = "/boot-reinigung" }
                };
                var idx = 0;
            }
            @foreach (var svc in services) {
                <a href="@svc.Href" class="group flex flex-col bg-card rounded-2xl overflow-hidden transition-all duration-300 animate-slide-up hover:shadow-lg hover:-translate-y-1 border border-border" style="animation-delay: @(idx * 80)ms">
                    <div class="aspect-[16/10] overflow-hidden">
                        <img src="@svc.Img" alt="@svc.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                    </div>
                    <div class="p-4 flex flex-col flex-1">
                        <span class="text-xs font-bold tracking-wider text-primary mb-2">@svc.Cat</span>
                        <h3 class="text-base font-bold text-foreground mb-2 group-hover:text-primary transition-colors">@svc.Name</h3>
                        <p class="text-xs text-muted-foreground leading-relaxed mb-4 flex-1">@svc.Desc</p>
                        <span class="inline-flex items-center text-sm font-semibold text-primary group-hover:gap-2 transition-all">
                            @SharedLocalizer["services.learn_more"]
                            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </span>
                    </div>
                </a>
                idx++;
            }
        </div>
    </div>
</section>
