@using System.Globalization
@{
    var isDe = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != "en";
    var serviceCards = new[] {
        new { Img = "/img/services/fensterreinigung.jpg", Cat = isDe ? "SPEZIALREINIGUNG" : "SPECIAL CLEANING", Name = isDe ? "Spezialreinigung" : "Special Cleaning", Desc = isDe ? "Fenster, Teppich, Polster, Matratzen und mehr" : "Windows, carpets, upholstery, mattresses and more", Href = "/spezialreinigung", Link = isDe ? "Alle Spezialreinigungen →" : "All Special Cleaning →" },
        new { Img = "/img/services/bueroreinigung.jpg", Cat = isDe ? "GEWERBEREINIGUNG" : "COMMERCIAL CLEANING", Name = isDe ? "Gewerbereinigung" : "Commercial Cleaning", Desc = isDe ? "Büro, Praxis und Geschäftsräume" : "Offices, practices and commercial spaces", Href = "/gewerbereinigung", Link = isDe ? "Alle Gewerbereinigungen →" : "All Commercial Cleaning →" },
        new { Img = "/img/zurich-cityscape.jpg", Cat = isDe ? "EINSATZGEBIETE" : "SERVICE AREAS", Name = isDe ? "Standorte" : "Locations", Desc = isDe ? "Alle Bezirke im Kanton Zürich" : "All districts in the Canton of Zürich", Href = "/standorte", Link = isDe ? "Alle Einsatzgebiete →" : "All Service Areas →" }
    };
    var directLinks = new[] {
        new { Label = isDe ? "Umzugsreinigung Zürich" : "Move-out Cleaning Zürich", Href = "/umzugsreinigung-stadt-zuerich" },
        new { Label = isDe ? "Grundreinigung" : "Deep Cleaning", Href = "/grundreinigung" },
        new { Label = isDe ? "Fensterreinigung" : "Window Cleaning", Href = "/fensterreinigung" },
        new { Label = isDe ? "Baureinigung" : "Construction Cleaning", Href = "/baureinigung" }
    };
}
<!-- Additional Services -->
<section class="py-12 md:py-24 bg-gradient-to-b from-secondary to-background">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8 md:mb-12">
            <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-foreground mb-4">
                @(isDe ? "Weitere Reinigungsservices in Zürich" : "More Cleaning Services in Zürich")
            </h2>
            <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto">@(isDe ? "Unser gesamtes Angebot, übersichtlich in drei Bereichen." : "Our complete range, clearly divided into three categories.")</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            @for (var i = 0; i < serviceCards.Length; i++)
            {
                var svc = serviceCards[i];
                <a href="@svc.Href" class="group flex flex-col bg-card rounded-2xl overflow-hidden transition-all duration-300 animate-slide-up hover:shadow-lg hover:-translate-y-1 border border-border" style="animation-delay: @(i * 80)ms">
                    <div class="aspect-[16/10] overflow-hidden">
                        <img src="@svc.Img" alt="@svc.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                    </div>
                    <div class="p-4 flex flex-col flex-1">
                        <span class="text-xs font-bold tracking-wider text-primary mb-2">@svc.Cat</span>
                        <h3 class="text-base font-bold text-foreground mb-2 group-hover:text-primary transition-colors">@svc.Name</h3>
                        <p class="text-xs text-muted-foreground leading-relaxed mb-4 flex-1">@svc.Desc</p>
                        <span class="inline-flex items-center text-sm font-semibold text-primary group-hover:gap-2 transition-all">@svc.Link</span>
                    </div>
                </a>
            }
        </div>

        <div class="mt-8 md:mt-12 text-center">
            <p class="text-sm text-muted-foreground">
                <span class="font-medium text-foreground">@(isDe ? "Direkt zu:" : "Direct to:")</span>
                @for (var i = 0; i < directLinks.Length; i++)
                {
                    <a href="@directLinks[i].Href" class="text-primary hover:underline">@directLinks[i].Label</a>@if (i < directLinks.Length - 1) {<span class="text-muted-foreground mx-1">·</span>}
                }
            </p>
        </div>
    </div>
</section>
