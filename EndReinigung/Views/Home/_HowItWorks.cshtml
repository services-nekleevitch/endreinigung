<!-- How It Works -->
<section class="py-10 md:py-14 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-foreground text-center mb-8 md:mb-10">
            @SharedLocalizer["how.title_1"] <span class="text-swiss-blue">@SharedLocalizer["how.title_2"]</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
            <!-- Step 1 -->
            <div class="flex flex-col items-center text-center animate-slide-up">
                <div class="w-12 h-12 rounded-full bg-swiss-blue/10 flex items-center justify-center mb-3">
                    <svg class="w-6 h-6 text-swiss-blue" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>
                </div>
                <h3 class="text-base md:text-lg font-bold text-foreground mb-1.5">@SharedLocalizer["how.step1_title"]</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">@SharedLocalizer["how.step1_desc"]</p>
            </div>
            <!-- Step 2 -->
            <div class="flex flex-col items-center text-center animate-slide-up" style="animation-delay: 150ms">
                <div class="w-12 h-12 rounded-full bg-booking-orange/10 flex items-center justify-center mb-3">
                    <svg class="w-6 h-6 text-booking-orange" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>
                </div>
                <h3 class="text-base md:text-lg font-bold text-foreground mb-1.5">@SharedLocalizer["how.step2_title"]</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">@SharedLocalizer["how.step2_desc"]</p>
            </div>
            <!-- Step 3 -->
            <div class="flex flex-col items-center text-center animate-slide-up" style="animation-delay: 300ms">
                <div class="w-12 h-12 rounded-full bg-cleaning-green/15 flex items-center justify-center mb-3">
                    <svg class="w-6 h-6 text-cleaning-green" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/></svg>
                </div>
                <h3 class="text-base md:text-lg font-bold text-foreground mb-1.5">@SharedLocalizer["how.step3_title"]</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">@SharedLocalizer["how.step3_desc"]</p>
            </div>
        </div>
    </div>
</section>
