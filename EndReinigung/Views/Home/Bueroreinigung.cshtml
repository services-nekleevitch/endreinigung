<script>
    (function () {
        var form = document.getElementById('bueroreinigung-form');
        if (!form) return;

        form.addEventListener('submit', function (e) {
            e.preventDefault();

            // Basic HTML5 validation
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            // Checkbox group: at least 1 required
            var checked = form.querySelectorAll('.service-checkbox:checked');
            var errEl = document.getElementById('services-error');
            if (checked.length === 0) {
                if (errEl) errEl.classList.remove('hidden');
                return;
            }
            if (errEl) errEl.classList.add('hidden');

            // Collect values
            var name    = document.getElementById('form-name').value.trim();
            var phone   = document.getElementById('form-phone').value.trim();
            var email   = document.getElementById('form-email').value.trim();
            var size    = document.getElementById('form-size').value;
            var message = document.getElementById('form-message').value.trim();
            var services = Array.from(checked).map(function(cb){ return cb.value; }).join(', ');

            var body = '[Büroreinigung Anfrage]\n'
                + 'Name: ' + name + '\n'
                + 'Telefon: ' + phone + '\n'
                + 'E-Mail: ' + email + '\n'
                + 'Bürofläche: ' + size + '\n'
                + 'Reinigungstyp: ' + services + '\n'
                + (message ? 'Nachricht: ' + message : '');

            var mailto = 'mailto:info@zurich-endreinigung.ch'
                + '?subject=' + encodeURIComponent('Büroreinigung Anfrage – zurich-endreinigung.ch')
                + '&body='    + encodeURIComponent(body);

            window.location.href = mailto;
        });
    })();
</script>

