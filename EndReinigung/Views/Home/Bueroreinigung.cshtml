        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Service",
        "name": "Büroreinigung Zürich",
        "provider": {
            "@@type": "ProfessionalService",
            "@@id": "https://zurich-endreinigung.ch/bueroreinigung#business",
            "name": "Zürich Endreinigung"
        },
        "areaServed": { "@@type": "AdministrativeArea", "name": "Kanton Zürich" },
        "priceRange": "CHF 50–60",
