                    "priceSpecification": { "@@type": "UnitPriceSpecification", "price": "5-7", "priceCurrency": "CHF", "unitCode": "MTK" }
                },
                {
                    "@@type": "Offer",
                    "itemOffered": { "@@type": "Service", "name": "Desinfektionsreinigung" },
                    "priceSpecification": { "@@type": "UnitPriceSpecification", "price": "8-12", "priceCurrency": "CHF", "unitCode": "MTK" }
                }
            ]
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "Wie viel kostet Büroreinigung in Zürich?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Unser Stundenansatz beginnt bei CHF 50. Die Preise variieren je nach Büroaufteilung, Anzahl Sanitärbereichen, Verschmutzungsgrad und Reinigungsfrequenz. Ein 150 m² Büro 3×/Woche kostet je nach Ausstattung CHF 1'300–1'950/Monat. Ihre exakte Offerte erhalten Sie innerhalb von 2 Stunden — kostenlos und unverbindlich."
                }
            },
            {
                "@@type": "Question",
                "name": "Warum erhalte ich keinen Fixpreis auf der Website?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Jedes Büro ist anders. Büroaufteilung, Sanitärbereiche, Bodenbeläge und Nutzung beeinflussen den Aufwand stark. Unsere Richtpreise geben Orientierung, die verbindliche Offerte erstellen wir nach kurzer Besichtigung oder telefonischer Abklärung — kostenlos und unverbindlich innerhalb von 2 Stunden."
                }
            },
            {
                "@@type": "Question",
                "name": "Wie oft sollte mein Büro gereinigt werden?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Das hängt von Bürogrösse, Mitarbeiterzahl und Branche ab. Für die meisten Büros empfehlen wir eine Unterhaltsreinigung 1–3× pro Woche, ergänzt durch eine jährliche Grundreinigung."
                }
            },
            {
                "@@type": "Question",
                "name": "Können Sie nachts oder am Wochenende reinigen?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Ja. Einsätze ausserhalb der Geschäftszeiten (vor 07:00, nach 18:00) oder am Wochenende haben einen Aufschlag von 20–30%. So stören wir Ihre Mitarbeitenden nicht und Sie starten täglich in saubere Räume."
                }
            },
            {
                "@@type": "Question",
                "name": "Sind Ihre Mitarbeiter versichert?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Ja, wir sind vollständig betriebshaftpflichtversichert mit einer Deckung von CHF 5 Mio. Alle unsere Mitarbeitenden verfügen über einen aktuellen Strafregisterauszug und werden persönlich von uns geschult."
                }
            },
            {
                "@@type": "Question",
                "name": "Was mache ich, wenn ich nicht zufrieden bin?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Unsere 100% Zufriedenheitsgarantie greift sofort: Melden Sie sich innerhalb von 24 Stunden, und wir reinigen kostenlos nach. Ohne Diskussion, ohne zusätzliche Kosten."
                }
            },
            {
                "@@type": "Question",
                "name": "Wie lange dauert eine Büroreinigung?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Als Richtwert: ca. 45–60 Minuten pro 50 m² und 90–120 Minuten pro 150 m² für die Unterhaltsreinigung. Eine Grundreinigung dauert deutlich länger und wird im Voraus geplant."
                }
            },
            {
                "@@type": "Question",
                "name": "Kann ich den Vertrag jederzeit kündigen?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Ja. Unsere Verträge sind monatlich kündbar — keine Mindestlaufzeit, keine Kündigungsfristen über einen Monat hinaus."
                }
            },
            {
                "@@type": "Question",
                "name": "Wie schnell erhalte ich eine Offerte?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Innerhalb von 2 Stunden während unserer Geschäftszeiten (Mo–Fr 08:00–19:00, Sa 08:00–16:00). Bei Anfragen ausserhalb dieser Zeiten am nächsten Werktag bis spätestens 10:00 Uhr."
                }
            }
        ]
    }
    </script>
}

