    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "Was kostet eine Fensterreinigung in Zürich?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Unsere Fixpreise für die Fensterreinigung in Zürich (Stand 2026): ab 249 CHF für 1-1.5 Zimmer, ab 289 CHF für 2-2.5 Zimmer, ab 389 CHF für 3-3.5 Zimmer, ab 459 CHF für 4-4.5 Zimmer und ab 529 CHF für 5-5.5 Zimmer."
                }
            },
            {
                "@@type": "Question",
                "name": "Was ist in der Fensterreinigung enthalten?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Unsere Fensterreinigung umfasst alle Fenster innen und aussen, inklusive Rahmen, Fensterbänke und Fenstersimse. Wir entfernen Schmutz, Kalkablagerungen und Rückstände für ein streifenfreies, kristallklares Ergebnis."
                }
            },
            {
                "@@type": "Question",
                "name": "Wie lange dauert eine Fensterreinigung?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Die Dauer hängt von der Anzahl und Grösse der Fenster ab. Für eine 2-Zimmer-Wohnung ca. 1.5-2 Stunden, für eine 3-Zimmer-Wohnung ca. 2-3 Stunden. Bei einem Einfamilienhaus sollten Sie mit 3-5 Stunden rechnen."
                }
            },
            {
                "@@type": "Question",
                "name": "Wie oft sollte man Fenster professionell reinigen lassen?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Wir empfehlen 2-4 Reinigungen pro Jahr — idealerweise im Frühling und Herbst. An stark befahrenen Strassen oder bei viel Pollenflug kann eine häufigere Reinigung sinnvoll sein."
                }
            },
            {
                "@@type": "Question",
                "name": "Was ist der Unterschied zwischen Standard und ECO Reinigung?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Bei der Standard-Reinigung setzen wir hochwirksame, professionelle Reinigungsmittel für maximale Sauberkeit ein. Die ECO-Option verwendet ausschliesslich umweltfreundliche, biologisch abbaubare Produkte."
                }
            },
            {
                "@@type": "Question",
                "name": "Werden auch Lamellenstoren und Jalousien gereinigt?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Die Reinigung von Lamellenstoren ist als Zusatzleistung möglich und wird separat kalkuliert."
                }
            },
            {
                "@@type": "Question",
                "name": "Reinigen Sie auch Dachfenster, Wintergärten und schwer erreichbare Fenster?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Ja, wir reinigen auch Dachfenster, Wintergärten, Oberlichter und schwer zugängliche Fenster. Unser Team verfügt über professionelle Ausrüstung für sicherheitsgerechte Höhenarbeit."
                }
            },
            {
                "@@type": "Question",
                "name": "Kann man Fenster auch im Winter reinigen lassen?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Ja, professionelle Fensterreinigung ist auch im Winter möglich — vorausgesetzt, die Temperaturen liegen über dem Gefrierpunkt."
                }
            }
        ]
    }
    </script>
}

