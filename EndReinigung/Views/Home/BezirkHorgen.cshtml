<script>
    (function () {
        var form = document.getElementById('horgen-hero-form');
        if (!form) return;
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var rooms = document.getElementById('horgen-room-size').value;
            var zip   = document.getElementById('horgen-zip-code').value.trim();
            var err   = document.getElementById('horgen-hero-error');
            if (!rooms && !zip) { err.textContent = 'Bitte Zimmerzahl und PLZ eingeben.'; return; }
            if (!rooms) { err.textContent = 'Bitte Zimmerzahl wählen.'; return; }
            if (!zip)   { err.textContent = 'Bitte PLZ eingeben.'; return; }
            err.textContent = '';
            window.location.href = '/calculator?rooms=' + encodeURIComponent(rooms) + '&zip=' + encodeURIComponent(zip);
        });
    })();
</script>
