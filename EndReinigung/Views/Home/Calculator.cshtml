@{
    ViewData["Title"] = "Endreinigung Kosten Zürich | Fixpreise ab CHF 345 | Zürich Endreinigung";
    ViewData["Description"] = "Endreinigung Kosten in Zürich sofort berechnen. Fixpreis für Umzugsreinigung mit 100% Abnahmegarantie, inkl. Backofen, Fenster, Balkon — ab CHF 345.";
    ViewData["Canonical"] = "https://zurich-endreinigung.ch/calculator";
    ViewData["Keywords"] = "Endreinigung Kosten Zürich, Endreinigung Preise, Umzugsreinigung Fixpreis, Endreinigung Rechner, Kostenrechner Reinigung";
}

@section Head {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Service",
        "serviceType": "Endreinigung",
        "provider": {
            "@@type": "CleaningService",
            "name": "Zürich Endreinigung",
            "telephone": "+41765017738",
            "email": "info@zurich-endreinigung.ch",
            "url": "https://zurich-endreinigung.ch",
            "areaServed": { "@@type": "State", "name": "Kanton Zürich" }
        },
        "name": "Endreinigung mit 100% Abnahmegarantie",
        "description": "Professionelle Endreinigung und Umzugsreinigung in Zürich zum Fixpreis, inkl. Backofen, Fenster, Balkon und persönlicher Übergabe.",
        "offers": {
            "@@type": "AggregateOffer",
            "priceCurrency": "CHF",
            "lowPrice": "345",
            "highPrice": "3099",
            "offerCount": 24,
            "offers": [
                { "@@type": "Offer", "name": "Wohnung 1 Zimmer", "price": "345", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Wohnung 1.5 Zimmer", "price": "385", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Wohnung 2 Zimmer", "price": "495", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Wohnung 2.5 Zimmer", "price": "535", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Wohnung 3 Zimmer", "price": "645", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Wohnung 3.5 Zimmer", "price": "685", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Wohnung 4 Zimmer", "price": "780", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Wohnung 4.5 Zimmer", "price": "839", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Wohnung 5 Zimmer", "price": "940", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Wohnung 5.5 Zimmer", "price": "990", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Wohnung 6 Zimmer", "price": "1350", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Haus 3 Zimmer", "price": "1299", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Haus 4 Zimmer", "price": "1599", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Haus 5 Zimmer", "price": "1899", "priceCurrency": "CHF" }
            ]
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "Was kostet eine Endreinigung in Zürich?",
                "acceptedAnswer": { "@@type": "Answer", "text": "Eine professionelle Endreinigung in Zürich kostet ab CHF 345 für eine 1-Zimmer-Wohnung. Der Fixpreis richtet sich nach Zimmerzahl und gewählten Extras wie Balkon, Badezimmer oder Teppichreinigung." }
            },
            {
                "@@type": "Question",
                "name": "Sind die Preise inkl. MwSt. und Abnahmegarantie?",
                "acceptedAnswer": { "@@type": "Answer", "text": "Ja. Alle angegebenen Fixpreise enthalten die Mehrwertsteuer sowie die 100% Abnahmegarantie. Sollten Mängel bei der Übergabe beanstandet werden, reinigen wir kostenlos nach." }
            },
            {
                "@@type": "Question",
                "name": "Wie lange dauert die Endreinigung einer Wohnung?",
                "acceptedAnswer": { "@@type": "Answer", "text": "Eine 3-Zimmer-Wohnung dauert typischerweise 4–6 Stunden, eine 5-Zimmer-Wohnung 6–8 Stunden. Die Dauer hängt vom Verschmutzungsgrad und den gewählten Extras ab." }
            },
            {
                "@@type": "Question",
                "name": "Welche Zahlungsarten akzeptieren Sie?",
                "acceptedAnswer": { "@@type": "Answer", "text": "Wir akzeptieren TWINT, Banküberweisung (Vorauszahlung) sowie Barzahlung bei der Übergabe." }
            },
            {
                "@@type": "Question",
                "name": "Was ist im Fixpreis enthalten?",
                "acceptedAnswer": { "@@type": "Answer", "text": "Grundreinigung aller Räume, Küche & Bad inkl. Backofen und Kühlschrank, Böden saugen und wischen, Oberflächen abstauben, Fensterrahmen und Fensterbänke, Storen/Jalousien, Briefkasten, 1× Balkon sowie persönliche Anwesenheit bei der Übergabe und kostenlose Nachbesserung bei Beanstandung." }
            }
        ]
    }
    </script>
}

<main class="min-h-screen pt-16 md:pt-[6.25rem] bg-background">

    <!-- SEO Hero -->
    <section class="py-10 md:py-14 bg-gradient-to-b from-muted/60 to-background">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-3xl md:text-5xl font-bold text-foreground mb-4">
                Endreinigung Kosten <span class="text-swiss-blue">Zürich</span>
            </h1>
            <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto">
                Berechnen Sie Ihren Fixpreis in 2 Minuten — transparent, unverbindlich, inkl. 100% Abnahmegarantie.
            </p>
        </div>
    </section>

    <!-- Calculator Wizard -->
    <section id="calculator" class="py-10 md:py-16 bg-secondary">
        <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- Progress steps -->
            <div id="calc-progress" class="flex items-center justify-center mb-6">
                @for (var i = 1; i <= 4; i++)
                {
                    <div class="flex items-center">
                        <button type="button" data-progress-step="@i" aria-label="Schritt @i"
                                class="w-10 h-10 rounded-full flex items-center justify-center font-semibold transition-all bg-border text-muted-foreground">
                            @i
                        </button>
                        @if (i < 4)
                        {
                            <div data-progress-bar="@i" class="w-8 sm:w-14 h-1 mx-1 transition-all bg-border"></div>
                        }
                    </div>
                }
            </div>

            <!-- Step labels -->
            <div class="flex justify-between mb-6 text-sm">
                <button type="button" data-progress-label="1" class="flex-1 text-center font-medium text-primary">Grösse</button>
                <button type="button" data-progress-label="2" class="flex-1 text-center text-muted-foreground">Extras</button>
                <button type="button" data-progress-label="3" class="flex-1 text-center text-muted-foreground">Festpreis &amp; Termine</button>
                <button type="button" data-progress-label="4" class="flex-1 text-center text-muted-foreground">Buchung</button>
            </div>

            <!-- Card -->
            <div class="bg-card rounded-2xl shadow-hero border border-border p-6 sm:p-8">

                <!-- STEP 1 — Size -->
                <section data-step="1" class="space-y-6">
                    <div class="text-center mb-2">
                        <div class="inline-flex items-center justify-center w-12 h-12 bg-primary/10 rounded-full mb-3">
                            <svg data-property-icon="apartment" class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 22V4a2 2 0 012-2h8a2 2 0 012 2v18z"/><path d="M6 12H4a2 2 0 00-2 2v8h4"/><path d="M18 9h2a2 2 0 012 2v11h-4"/><path d="M10 6h4M10 10h4M10 14h4M10 18h4"/></svg>
                            <svg data-property-icon="house" class="w-6 h-6 text-primary hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                        </div>
                        <h2 class="text-2xl font-bold text-foreground" data-label-size-title>Wohnungsgrösse wählen</h2>
                    </div>

                    <div class="flex justify-center gap-3">
                        <button type="button" data-property-type="apartment"
                                class="flex items-center gap-2 px-5 py-3 rounded-xl border-2 font-medium transition-all border-primary bg-primary/10 text-primary">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 22V4a2 2 0 012-2h8a2 2 0 012 2v18z"/><path d="M10 6h4M10 10h4M10 14h4M10 18h4"/></svg>
                            Wohnung
                        </button>
                        <button type="button" data-property-type="house"
                                class="flex items-center gap-2 px-5 py-3 rounded-xl border-2 font-medium transition-all border-border bg-card text-muted-foreground hover:border-booking-orange/50">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            Haus
                        </button>
                    </div>

                    <!-- Apartment room grid -->
                    <div data-room-grid="apartment" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                        @{
                            var apartments = new (string Value, string Label, int Price)[] {
                                ("1", "1 Zimmer", 345), ("1.5", "1.5 Zimmer", 385), ("2", "2 Zimmer", 495), ("2.5", "2.5 Zimmer", 535),
                                ("3", "3 Zimmer", 645), ("3.5", "3.5 Zimmer", 685), ("4", "4 Zimmer", 780), ("4.5", "4.5 Zimmer", 839),
                                ("5", "5 Zimmer", 940), ("5.5", "5.5 Zimmer", 990), ("6", "6 Zimmer", 1350), ("6.5", "6.5 Zimmer", 1450),
                            };
                            foreach (var (value, label, price) in apartments)
                            {
                                <button type="button" data-room="@value" data-price="@price"
                                        class="p-4 rounded-xl border-2 border-border bg-card transition-all text-center hover:border-primary/50">
                                    <div class="font-semibold text-foreground">@label</div>
                                    <div class="text-sm text-muted-foreground mt-1">ab CHF @price</div>
                                </button>
                            }
                        }
                    </div>

                    <!-- House room grid -->
                    <div data-room-grid="house" class="hidden grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                        @{
                            var houses = new (string Value, string Label, int Price)[] {
                                ("3", "3 Zimmer", 1299), ("3.5", "3.5 Zimmer", 1799), ("4", "4 Zimmer", 1599), ("4.5", "4.5 Zimmer", 2099),
                                ("5", "5 Zimmer", 1899), ("5.5", "5.5 Zimmer", 2399), ("6", "6 Zimmer", 2199), ("6.5", "6.5 Zimmer", 2699),
                                ("7", "7 Zimmer", 2399), ("7.5", "7.5 Zimmer", 2899), ("8", "8 Zimmer", 2599), ("8.5", "8.5 Zimmer", 3099),
                            };
                            foreach (var (value, label, price) in houses)
                            {
                                <button type="button" data-room="@value" data-price="@price"
                                        class="p-4 rounded-xl border-2 border-border bg-card transition-all text-center hover:border-booking-orange/50">
                                    <div class="font-semibold text-foreground">@label</div>
                                    <div class="text-sm text-muted-foreground mt-1">ab CHF @price</div>
                                </button>
                            }
                        }
                    </div>

                    <p data-room-error class="text-sm text-red-600 hidden"></p>

                    <div class="max-w-[160px]">
                        <label for="calc-zip" class="text-2xl font-bold text-navy mb-2 block">PLZ</label>
                        <input type="text" inputmode="numeric" maxlength="4" id="calc-zip" placeholder="z.B. 8001"
                               class="w-full h-12 px-4 text-lg rounded-xl border-2 border-border focus:border-booking-orange outline-none transition-colors" />
                        <p data-zip-error class="text-sm text-red-600 mt-1 hidden"></p>
                    </div>

                    <button type="button" data-action="next-1"
                            class="w-full h-14 text-lg font-semibold bg-booking-orange hover:bg-booking-orange-dark text-white rounded-lg transition-colors">
                        Weiter zu Extras →
                    </button>
                </section>

                <!-- STEP 2 — Extras -->
                <section data-step="2" class="space-y-6 hidden">
                    <div class="text-center mb-2">
                        <div class="inline-flex items-center justify-center w-12 h-12 bg-primary/10 rounded-full mb-3">
                            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        </div>
                        <h2 class="text-2xl font-bold text-foreground">Extras wählen</h2>
                        <div class="mt-3 inline-flex items-center gap-3 bg-cleaning-green/10 text-cleaning-green rounded-2xl px-6 py-3 text-lg font-bold border border-cleaning-green/30">
                            <svg class="w-5 h-5" data-summary-icon="apartment" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 22V4a2 2 0 012-2h8a2 2 0 012 2v18z"/></svg>
                            <svg class="w-5 h-5 hidden" data-summary-icon="house" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
                            <span data-summary-line>—</span>
                        </div>
                        <p class="text-sm text-muted-foreground mt-1" data-summary-incl>—</p>
                    </div>

                    <!-- Zürich-Garantie card -->
                    <div class="bg-secondary rounded-xl p-5 border border-border">
                        <div class="flex items-center gap-2 mb-1">
                            <svg class="w-5 h-5 text-booking-orange" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            <h3 class="font-semibold text-foreground">Unsere Zürich-Garantie</h3>
                        </div>
                        <p class="text-amber-500 font-bold text-sm mb-4">100% Abnahme-Garantie inklusive</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 text-sm text-foreground/80">
                            <ul class="space-y-2.5">
                                @foreach (var item in new[] { "Grundreinigung aller Räume", "Küche & Bad reinigen", "Böden saugen & wischen", "Oberflächen abstauben", "Fensterrahmen & Fensterbänke", "Storen / Jalousien" })
                                {
                                    <li class="flex items-start gap-2">
                                        <svg class="w-4 h-4 text-cleaning-green mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                        <span>@item</span>
                                    </li>
                                }
                            </ul>
                            <ul class="space-y-2.5">
                                <li class="flex items-start gap-2"><svg class="w-4 h-4 text-cleaning-green mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                    <span>Backofen &amp; Kühlschrank<br><span class="text-muted-foreground">innen &amp; aussen</span></span>
                                </li>
                                @foreach (var item in new[] { "Briefkasten innen & aussen", "1× Balkon / Terrasse", "Anwesenheit bei Übergabe", "Nachbesserung bei Beanstandung" })
                                {
                                    <li class="flex items-start gap-2">
                                        <svg class="w-4 h-4 text-cleaning-green mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                        <span>@item</span>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="flex items-start gap-2 pt-3 mt-3 border-t border-border">
                            <svg class="w-4 h-4 text-swiss-blue mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
                            <span class="text-sm font-semibold text-foreground">Persönliche Anwesenheit bei der Übergabe</span>
                        </div>
                    </div>

                    <!-- Optional extras -->
                    <div>
                        <label class="text-base font-medium text-foreground mb-3 block">Optionale Zusatzleistungen</label>
                        <div class="grid gap-3" data-extras-container>
                            <!-- Toggle add-on: Estrich -->
                            <div data-extra-toggle="basement" data-extra-price="50"
                                 class="flex items-center justify-between p-4 rounded-xl border-2 border-border bg-card cursor-pointer transition-all hover:border-booking-orange/50">
                                <div class="flex items-center gap-3">
                                    <div class="w-4 h-4 rounded border-2 border-slate-300 flex items-center justify-center shrink-0" data-check></div>
                                    <span class="font-medium text-foreground">Estrich</span>
                                </div>
                                <span class="text-orange-600 font-semibold">+CHF 50</span>
                            </div>

                            @{
                                var countables = new (string Key, string Label, int Price, string? Unit)[] {
                                    ("balcony", "Extra Balkon / Terrasse", 45, null),
                                    ("utility_balcony", "Nebenbalkon", 35, null),
                                    ("bath", "Anzahl Badezimmer", 65, null),
                                    ("wc", "Separates WC", 40, null),
                                    ("carpet", "Teppich Shampoo-Reinigung", 120, "Zimmer"),
                                    ("balcony_pressure", "Balkon / Terrasse Hochdruckreinigung", 50, null),
                                    ("garage_pressure", "Garage / Carport Hochdruckreinigung", 65, null),
                                };
                                foreach (var (key, label, price, unit) in countables)
                                {
                                    var unitSuffix = unit is null ? "" : $" / {unit}";
                                    <div data-extra-countable="@key" data-extra-price="@price" data-max="3"
                                         class="p-4 rounded-xl border-2 border-slate-200 bg-white cursor-pointer transition-all hover:border-orange-300">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-3">
                                                <div class="w-4 h-4 rounded border-2 border-slate-300 flex items-center justify-center" data-check></div>
                                                <span class="font-medium text-slate-900">@label</span>
                                            </div>
                                            <span class="text-orange-600 font-semibold" data-extra-price-label>+CHF @price@unitSuffix</span>
                                        </div>
                                        <div data-extra-counter class="hidden flex items-center gap-3 mt-3 pt-3 border-t border-orange-200">
                                            <span class="text-sm text-slate-600">Anzahl:</span>
                                            <div class="flex items-center gap-1">
                                                @for (var n = 1; n <= 3; n++)
                                                {
                                                    <button type="button" data-count="@n"
                                                            class="w-10 h-10 rounded-lg font-semibold text-sm transition-all bg-slate-100 text-slate-700 hover:bg-slate-200">
                                                        @n
                                                    </button>
                                                }
                                            </div>
                                            <span class="text-sm text-orange-600 font-medium ml-auto" data-extra-total>+CHF 0</span>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <button type="button" data-action="back-2" class="h-14 px-6 rounded-lg border-2 border-border bg-card text-foreground font-medium hover:bg-muted transition-colors">← Zurück</button>
                        <button type="button" data-action="next-2" class="flex-1 h-14 text-lg font-semibold bg-booking-orange hover:bg-booking-orange-dark text-white rounded-lg transition-colors">Weiter zum Preis →</button>
                    </div>
                </section>

                <!-- STEP 3 — Price & Dates -->
                <section data-step="3" class="space-y-6 hidden">
                    <div class="text-center mb-2">
                        <div class="inline-flex items-center justify-center w-12 h-12 bg-cleaning-green/15 rounded-full mb-3">
                            <svg class="w-6 h-6 text-cleaning-green" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        </div>
                        <h2 class="text-2xl font-bold text-foreground">Ihr Fixpreis</h2>
                        <p class="text-muted-foreground mt-1">Keine versteckten Kosten. Alles inklusive.</p>
                    </div>

                    <div class="bg-gradient-to-br from-cleaning-green/15 to-cleaning-green/5 rounded-2xl p-8 text-center text-foreground">
                        <div class="text-5xl font-bold mb-2">CHF <span data-price-total>0</span></div>
                        <p class="text-cleaning-green font-medium">Fixpreis inkl. MwSt. &amp; Abnahmegarantie</p>
                        <div class="mt-6 pt-6 border-t border-cleaning-green/20 grid grid-cols-3 gap-4 text-sm">
                            <div>
                                <svg class="w-5 h-5 mx-auto mb-1 text-cleaning-green" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                <span class="text-muted-foreground">Haftpflicht­versichert</span>
                            </div>
                            <div>
                                <svg class="w-5 h-5 mx-auto mb-1 text-cleaning-green" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 3l2 7h7l-5.5 4 2 7L12 17l-5.5 4 2-7L3 10h7z"/></svg>
                                <span class="text-muted-foreground">Abnahme­garantiert</span>
                            </div>
                            <div>
                                <svg class="w-5 h-5 mx-auto mb-1 text-cleaning-green" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                <span class="text-muted-foreground">Pünktlich</span>
                            </div>
                        </div>
                    </div>

                    <div class="p-5 bg-secondary border-0 rounded-xl">
                        <h3 class="font-semibold text-foreground mb-3">Zusammenfassung</h3>
                        <div class="space-y-2 text-sm" data-summary-list>
                            <!-- populated by JS -->
                        </div>
                    </div>

                    <div>
                        <label class="text-base font-bold text-primary mb-2 block">Wunschtermin Reinigung *</label>
                        <input type="date" id="calc-cleaning-date" class="w-full h-14 px-4 text-base rounded-xl border-2 border-border focus:border-primary outline-none transition-colors" />
                        <p data-cleaning-date-error class="text-sm text-red-600 mt-1 hidden"></p>
                    </div>

                    <div>
                        <label class="text-base font-bold text-primary mb-2 block">Wunschtermin Übergabe</label>
                        <div class="flex gap-3">
                            <input type="date" id="calc-handover-date" class="flex-1 h-14 px-4 text-base rounded-xl border-2 border-border focus:border-primary outline-none transition-colors" />
                            <select id="calc-handover-time" class="w-[140px] h-14 px-3 text-base rounded-xl border-2 border-border focus:border-primary outline-none transition-colors">
                                <option value="">Zeit</option>
                                @for (var h = 8; h <= 17; h++)
                                {
                                    <option value="@($"{h:D2}:00")">@($"{h:D2}:00")</option>
                                    <option value="@($"{h:D2}:30")">@($"{h:D2}:30")</option>
                                }
                            </select>
                        </div>
                        <p data-handover-date-error class="text-sm text-red-600 mt-1 hidden"></p>
                        <label class="flex items-center gap-2 mt-3 cursor-pointer select-none">
                            <input type="checkbox" id="calc-handover-not-fixed" class="w-4 h-4 rounded border-border accent-primary" />
                            <span class="text-sm text-muted-foreground">Übergabedatum noch nicht fix</span>
                        </label>
                    </div>

                    <div class="flex gap-3">
                        <button type="button" data-action="back-3" class="h-14 px-6 rounded-lg border-2 border-border bg-card text-foreground font-medium hover:bg-muted transition-colors">← Zurück</button>
                        <button type="button" data-action="next-3" class="flex-1 h-14 text-lg font-semibold bg-booking-orange hover:bg-booking-orange-dark text-white rounded-lg transition-colors">Weiter zur Buchung →</button>
                    </div>
                    <p class="text-center text-xs text-muted-foreground">Kostenlose Stornierung bis 48 h vor dem Termin.</p>
                </section>

                <!-- STEP 4 — Booking -->
                <section data-step="4" class="space-y-6 hidden">
                    <form id="calc-booking-form" asp-controller="Calculator" asp-action="Book" method="post" class="space-y-6">
                        <!-- Hidden state (populated by JS before submit) -->
                        <input type="hidden" name="PropertyType" data-hidden="PropertyType" />
                        <input type="hidden" name="RoomSize" data-hidden="RoomSize" />
                        <input type="hidden" name="ZipCode" data-hidden="ZipCode" />
                        <input type="hidden" name="Balcony" data-hidden="Balcony" value="0" />
                        <input type="hidden" name="UtilityBalcony" data-hidden="UtilityBalcony" value="0" />
                        <input type="hidden" name="Bath" data-hidden="Bath" value="0" />
                        <input type="hidden" name="Wc" data-hidden="Wc" value="0" />
                        <input type="hidden" name="Carpet" data-hidden="Carpet" value="0" />
                        <input type="hidden" name="BalconyPressure" data-hidden="BalconyPressure" value="0" />
                        <input type="hidden" name="GaragePressure" data-hidden="GaragePressure" value="0" />
                        <input type="hidden" name="Basement" data-hidden="Basement" value="false" />
                        <input type="hidden" name="CleaningDate" data-hidden="CleaningDate" />
                        <input type="hidden" name="HandoverDate" data-hidden="HandoverDate" />
                        <input type="hidden" name="HandoverTime" data-hidden="HandoverTime" />
                        <input type="hidden" name="HandoverDateNotFixed" data-hidden="HandoverDateNotFixed" value="false" />
                        <input type="hidden" name="QuotedTotal" data-hidden="QuotedTotal" value="0" />
                        <input type="hidden" name="PaymentMethod" data-hidden="PaymentMethod" />
                        <input type="hidden" name="SameAsCustomer" data-hidden="SameAsCustomer" value="false" />

                        <!-- Compact summary -->
                        <div class="p-4 bg-secondary border-0 rounded-xl text-sm space-y-1.5">
                            <div class="flex justify-between"><span class="text-muted-foreground">Objekt</span><span class="font-medium" data-booking-room>—</span></div>
                            <div class="flex justify-between"><span class="text-muted-foreground">Termin</span><span class="font-medium" data-booking-date>—</span></div>
                            <div class="flex justify-between"><span class="text-muted-foreground">PLZ</span><span class="font-medium" data-booking-zip>—</span></div>
                            <div class="pt-2 border-t border-border flex justify-between font-semibold text-base">
                                <span>Total</span><span class="text-cleaning-green">CHF <span data-booking-total>0</span></span>
                            </div>
                        </div>

                        <!-- Personal data -->
                        <div>
                            <h3 class="text-xl font-bold text-foreground mb-4">Ihre Kontaktdaten</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label for="bk-firstname" class="block text-sm font-medium text-foreground mb-1.5">Vorname *</label>
                                    <input type="text" id="bk-firstname" name="FirstName" required placeholder="Max"
                                           class="w-full h-12 px-4 rounded-lg border-2 border-input focus:border-primary outline-none transition-colors" />
                                </div>
                                <div>
                                    <label for="bk-lastname" class="block text-sm font-medium text-foreground mb-1.5">Nachname *</label>
                                    <input type="text" id="bk-lastname" name="LastName" required placeholder="Muster"
                                           class="w-full h-12 px-4 rounded-lg border-2 border-input focus:border-primary outline-none transition-colors" />
                                </div>
                                <div>
                                    <label for="bk-email" class="block text-sm font-medium text-foreground mb-1.5">E-Mail *</label>
                                    <input type="email" id="bk-email" name="Email" required placeholder="max@beispiel.ch"
                                           class="w-full h-12 px-4 rounded-lg border-2 border-input focus:border-primary outline-none transition-colors" />
                                </div>
                                <div>
                                    <label for="bk-phone" class="block text-sm font-medium text-foreground mb-1.5">Telefon *</label>
                                    <input type="tel" id="bk-phone" name="Phone" required placeholder="+41 79 123 45 67"
                                           class="w-full h-12 px-4 rounded-lg border-2 border-input focus:border-primary outline-none transition-colors" />
                                </div>
                            </div>
                        </div>

                        <!-- Customer address -->
                        <div>
                            <h3 class="text-lg font-bold text-foreground mb-4">Rechnungsadresse</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div class="sm:col-span-2">
                                    <label for="bk-cstreet" class="block text-sm font-medium text-foreground mb-1.5">Strasse &amp; Nr. *</label>
                                    <input type="text" id="bk-cstreet" name="CustomerStreet" required placeholder="Bahnhofstrasse 1"
                                           class="w-full h-12 px-4 rounded-lg border-2 border-input focus:border-primary outline-none transition-colors" />
                                </div>
                                <div>
                                    <label for="bk-cplz" class="block text-sm font-medium text-foreground mb-1.5">PLZ *</label>
                                    <input type="text" id="bk-cplz" name="CustomerPlz" required inputmode="numeric" maxlength="4" placeholder="8000"
                                           class="w-full h-12 px-4 rounded-lg border-2 border-input focus:border-primary outline-none transition-colors" />
                                </div>
                                <div>
                                    <label for="bk-ccity" class="block text-sm font-medium text-foreground mb-1.5">Ort *</label>
                                    <input type="text" id="bk-ccity" name="CustomerCity" required placeholder="Zürich"
                                           class="w-full h-12 px-4 rounded-lg border-2 border-input focus:border-primary outline-none transition-colors" />
                                </div>
                            </div>
                        </div>

                        <!-- Same address toggle -->
                        <label class="flex items-center gap-3 py-3 px-4 bg-secondary rounded-xl border border-border cursor-pointer">
                            <input type="checkbox" id="bk-same-address" class="w-4 h-4 rounded border-border accent-primary" />
                            <span class="text-sm">Objektadresse entspricht der Rechnungsadresse</span>
                        </label>

                        <!-- Object address -->
                        <div data-object-address>
                            <h3 class="text-lg font-bold text-foreground mb-4">Objektadresse (zu reinigendes Objekt)</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div class="sm:col-span-2">
                                    <label for="bk-ostreet" class="block text-sm font-medium text-foreground mb-1.5">Strasse &amp; Nr. *</label>
                                    <input type="text" id="bk-ostreet" name="ObjectStreet" placeholder="Musterstrasse 10"
                                           class="w-full h-12 px-4 rounded-lg border-2 border-input focus:border-primary outline-none transition-colors" />
                                </div>
                                <div>
                                    <label for="bk-oplz" class="block text-sm font-medium text-foreground mb-1.5">PLZ *</label>
                                    <input type="text" id="bk-oplz" name="ObjectPlz" inputmode="numeric" maxlength="4" placeholder="8000"
                                           class="w-full h-12 px-4 rounded-lg border-2 border-input focus:border-primary outline-none transition-colors" />
                                </div>
                                <div>
                                    <label for="bk-ocity" class="block text-sm font-medium text-foreground mb-1.5">Ort *</label>
                                    <input type="text" id="bk-ocity" name="ObjectCity" placeholder="Zürich"
                                           class="w-full h-12 px-4 rounded-lg border-2 border-input focus:border-primary outline-none transition-colors" />
                                </div>
                            </div>
                        </div>

                        <!-- Notes -->
                        <div>
                            <label for="bk-notes" class="block text-sm font-medium text-foreground mb-1.5">Anmerkungen</label>
                            <textarea id="bk-notes" name="Notes" rows="3" placeholder="z.B. Schlüsselübergabe, Parkplatz, Haustiere …"
                                      class="w-full px-4 py-3 rounded-lg border-2 border-input focus:border-primary outline-none transition-colors resize-none"></textarea>
                        </div>

                        <!-- Payment method -->
                        <div>
                            <label class="text-base font-medium text-foreground mb-3 block">Zahlungsart *</label>
                            <div class="grid grid-cols-3 gap-3">
                                <button type="button" data-payment="twint" class="p-3 sm:p-4 rounded-xl border-2 border-border bg-card transition-all text-center hover:border-booking-orange/50">
                                    <svg class="w-5 h-5 sm:w-6 sm:h-6 mx-auto mb-1.5 text-foreground/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                                    <div class="font-medium text-[11px] sm:text-sm text-foreground">TWINT</div>
                                </button>
                                <button type="button" data-payment="bank" class="p-3 sm:p-4 rounded-xl border-2 border-border bg-card transition-all text-center hover:border-booking-orange/50">
                                    <svg class="w-5 h-5 sm:w-6 sm:h-6 mx-auto mb-1.5 text-foreground/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                                    <div class="font-medium text-[11px] sm:text-sm text-foreground">Vorzahlung</div>
                                </button>
                                <button type="button" data-payment="cash" class="p-3 sm:p-4 rounded-xl border-2 border-border bg-card transition-all text-center hover:border-booking-orange/50">
                                    <svg class="w-5 h-5 sm:w-6 sm:h-6 mx-auto mb-1.5 text-foreground/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/></svg>
                                    <div class="font-medium text-[11px] sm:text-sm text-foreground">Barzahlung</div>
                                </button>
                            </div>
                            <p data-payment-error class="text-sm text-red-600 mt-2 hidden">Bitte wählen Sie eine Zahlungsart.</p>
                            <p class="text-sm text-muted-foreground mt-3 italic">Die Zahlung erfolgt nach erfolgreicher Übergabe — unabhängig von der gewählten Zahlungsart.</p>
                        </div>

                        <!-- Terms -->
                        <label class="flex items-start gap-3 cursor-pointer">
                            <input type="checkbox" id="bk-terms" name="TermsAccepted" value="true" required class="mt-1 w-4 h-4 rounded border-border accent-primary" />
                            <span class="text-sm leading-relaxed">
                                Ich akzeptiere die <a href="/agb" target="_blank" rel="noopener" class="text-primary underline">Allgemeinen Geschäftsbedingungen</a> und die <a href="/datenschutz" target="_blank" rel="noopener" class="text-primary underline">Datenschutzerklärung</a>.
                            </span>
                        </label>

                        <!-- Submission status banner -->
                        <div data-submit-error class="hidden p-3 rounded-lg bg-red-50 border border-red-300 text-red-900 text-sm"></div>

                        <div class="flex gap-3">
                            <button type="button" data-action="back-4" class="h-14 px-6 rounded-lg border-2 border-border bg-card text-foreground font-medium hover:bg-muted transition-colors">← Zurück</button>
                            <button type="submit" data-action="submit" class="flex-1 h-14 text-lg font-semibold bg-booking-orange hover:bg-booking-orange-dark text-white rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                                Buchung bestätigen ✓
                            </button>
                        </div>
                    </form>
                </section>

                <!-- STEP 5 — Success -->
                <section data-step="5" class="space-y-6 hidden text-center py-8">
                    <div class="inline-flex items-center justify-center w-20 h-20 bg-cleaning-green/15 rounded-full mb-2">
                        <svg class="w-10 h-10 text-cleaning-green" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </div>
                    <h2 class="text-3xl font-bold text-foreground">Vielen Dank für Ihre Buchung!</h2>
                    <p class="text-muted-foreground max-w-lg mx-auto">
                        Ihre Anfrage ist bei uns eingegangen. Wir melden uns innerhalb von 24 Stunden mit der Terminbestätigung.
                    </p>
                    <div class="max-w-md mx-auto p-5 bg-secondary rounded-xl text-left text-sm space-y-2">
                        <div class="flex justify-between"><span class="text-muted-foreground">Buchungsnummer</span><span class="font-semibold" data-success-id>—</span></div>
                        <div class="flex justify-between"><span class="text-muted-foreground">Reinigungstermin</span><span class="font-semibold" data-success-date>—</span></div>
                        <div class="flex justify-between"><span class="text-muted-foreground">Total</span><span class="font-semibold text-cleaning-green">CHF <span data-success-total>0</span></span></div>
                    </div>
                    <a href="/" class="inline-flex items-center gap-2 mt-4 text-primary font-medium hover:underline">← Zurück zur Startseite</a>
                </section>

            </div>
        </div>
    </section>

    <!-- SSR Pricing Table — indexed content -->
    <section class="py-12 md:py-16 bg-background">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl md:text-3xl font-bold text-foreground mb-2 text-center">Fixpreise Endreinigung Zürich — Preisübersicht</h2>
            <p class="text-muted-foreground text-center mb-8">Alle Preise inkl. MwSt. und 100 % Abnahmegarantie.</p>

            <div class="grid md:grid-cols-2 gap-6">
                <div class="rounded-xl border border-border bg-card shadow-card overflow-hidden">
                    <div class="bg-swiss-blue text-white py-3 px-5">
                        <h3 class="text-lg font-bold">Wohnung</h3>
                    </div>
                    <div class="divide-y">
                        @foreach (var (value, label, price) in new[] {
                            ("1", "1 – 1.5 Zimmer", 345), ("2", "2 – 2.5 Zimmer", 495),
                            ("3", "3 – 3.5 Zimmer", 645), ("4", "4 – 4.5 Zimmer", 780),
                            ("5", "5 – 5.5 Zimmer", 940), ("6", "6+ Zimmer", 1350),
                        })
                        {
                            <div class="flex justify-between items-center px-5 py-3 hover:bg-muted/50">
                                <span class="font-medium">@label</span>
                                <span class="font-bold text-swiss-blue">ab CHF @price</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="rounded-xl border border-border bg-card shadow-card overflow-hidden">
                    <div class="bg-booking-orange text-white py-3 px-5">
                        <h3 class="text-lg font-bold">Haus / Einfamilienhaus</h3>
                    </div>
                    <div class="divide-y">
                        @foreach (var (value, label, price) in new[] {
                            ("3", "3 – 3.5 Zimmer", 1299), ("4", "4 – 4.5 Zimmer", 1599),
                            ("5", "5 – 5.5 Zimmer", 1899), ("6", "6 – 6.5 Zimmer", 2199),
                            ("7", "7 – 7.5 Zimmer", 2399), ("8", "8+ Zimmer", 2599),
                        })
                        {
                            <div class="flex justify-between items-center px-5 py-3 hover:bg-muted/50">
                                <span class="font-medium">@label</span>
                                <span class="font-bold text-booking-orange">ab CHF @price</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- What's included (SEO) -->
    <section class="py-12 bg-secondary/30">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl md:text-3xl font-bold text-foreground mb-6 text-center">Was ist in der Endreinigung enthalten?</h2>
            <div class="grid md:grid-cols-2 gap-4 bg-card rounded-xl p-6 shadow-card">
                @foreach (var item in new[] {
                    "Grundreinigung aller Räume", "Backofen &amp; Kühlschrank innen & aussen",
                    "Küche &amp; Bad intensiv reinigen", "Briefkasten innen & aussen",
                    "Böden saugen &amp; wischen", "1× Balkon / Terrasse",
                    "Oberflächen abstauben", "Fensterrahmen &amp; Fensterbänke",
                    "Storen / Jalousien", "Anwesenheit bei der Übergabe",
                    "Türen &amp; Sockelleisten", "Nachbesserung bei Beanstandung",
                })
                {
                    <div class="flex items-start gap-2">
                        <svg class="w-5 h-5 text-cleaning-green mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        <span class="text-foreground">@Html.Raw(item)</span>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- FAQ (SEO) -->
    <section class="py-12 bg-background">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl md:text-3xl font-bold text-foreground mb-6 text-center">Häufige Fragen zum Endreinigungspreis</h2>
            <div class="rounded-xl bg-card shadow-card overflow-hidden">
                @foreach (var (q, a) in new[] {
                    ("Was kostet eine Endreinigung in Zürich?", "Eine professionelle Endreinigung in Zürich kostet ab CHF 345 für eine 1-Zimmer-Wohnung. Der Fixpreis richtet sich nach Zimmerzahl und gewählten Extras wie Balkon, Badezimmer oder Teppichreinigung."),
                    ("Sind die Preise inkl. MwSt. und Abnahmegarantie?", "Ja. Alle angegebenen Fixpreise enthalten die Mehrwertsteuer sowie die 100 % Abnahmegarantie. Sollten Mängel bei der Übergabe beanstandet werden, reinigen wir kostenlos nach."),
                    ("Wie lange dauert die Endreinigung einer Wohnung?", "Eine 3-Zimmer-Wohnung dauert typischerweise 4–6 Stunden, eine 5-Zimmer-Wohnung 6–8 Stunden. Die Dauer hängt vom Verschmutzungsgrad und den gewählten Extras ab."),
                    ("Welche Zahlungsarten akzeptieren Sie?", "Wir akzeptieren TWINT, Banküberweisung (Vorauszahlung) sowie Barzahlung bei der Übergabe."),
                    ("Was ist im Fixpreis enthalten?", "Grundreinigung aller Räume, Küche und Bad inkl. Backofen und Kühlschrank, Böden saugen und wischen, Oberflächen abstauben, Fensterrahmen und Fensterbänke, Storen/Jalousien, Briefkasten, 1× Balkon sowie persönliche Anwesenheit bei der Übergabe und kostenlose Nachbesserung bei Beanstandung."),
                })
                {
                    <details class="border-b border-border last:border-b-0 group">
                        <summary class="px-5 py-4 text-left font-medium text-foreground cursor-pointer hover:bg-secondary/50 flex items-center justify-between">
                            <span>@q</span>
                            <svg class="w-4 h-4 text-muted-foreground transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                        </summary>
                        <div class="px-5 pb-4 text-muted-foreground text-sm leading-relaxed">@a</div>
                    </details>
                }
            </div>
        </div>
    </section>

    <!-- Noscript fallback -->
    <noscript>
        <section class="py-10 bg-amber-50 border-y border-amber-200">
            <div class="max-w-2xl mx-auto px-4 text-center">
                <p class="text-amber-900 font-medium">Der interaktive Kostenrechner benötigt JavaScript. Bitte aktivieren Sie JavaScript oder kontaktieren Sie uns direkt:</p>
                <a href="tel:+41765017738" class="inline-flex items-center gap-2 mt-4 px-6 py-3 bg-booking-orange text-white font-semibold rounded-lg">📞 +41 76 501 77 38</a>
            </div>
        </section>
    </noscript>

    @await Html.PartialAsync("_Contact")
</main>

@await Html.PartialAsync("~/Views/Shared/_Footer.cshtml")

@section Scripts {
    <script src="~/js/calculator.js" asp-append-version="true" defer></script>
}
