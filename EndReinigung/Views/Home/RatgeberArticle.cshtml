@model EndReinigung.Models.RatgeberArticle
@{
    var titleTag = $"{Model.TitleDe} | Ratgeber Zürich Endreinigung";
    var description = Model.IntroDe.Length > 160 ? Model.IntroDe.Substring(0, 157) + "..." : Model.IntroDe;
    ViewData["Title"] = titleTag;
    ViewData["Description"] = description;
    ViewData["Canonical"] = $"https://zurich-endreinigung.ch/ratgeber/{Model.Slug}";
    ViewData["Keywords"] = $"Ratgeber Endreinigung, {Model.CategoryName}, Endreinigung Zürich";

    int wordCount = 0;
    foreach (var b in Model.Blocks)
    {
        if (!string.IsNullOrEmpty(b.Body))
            wordCount += b.Body.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;
        foreach (var item in b.Items)
            wordCount += item.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;
    }
    int readingTime = Math.Max(1, (int)Math.Round(wordCount / 200.0));
}

@section Head {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Article",
        "inLanguage": "de-CH",
        "headline": "@Model.TitleDe",
        "description": "@description",
        "image": "https://zurich-endreinigung.ch@Model.CoverImage",
        "author": { "@@type": "Organization", "name": "Zürich Endreinigung" },
        "publisher": { "@@type": "Organization", "name": "Zürich Endreinigung", "logo": { "@@type": "ImageObject", "url": "https://zurich-endreinigung.ch/favicon.png" } },
        "mainEntityOfPage": "https://zurich-endreinigung.ch/ratgeber/@Model.Slug"
    }
    </script>
}

<div class="min-h-screen flex flex-col">
    <article class="flex-1 pt-20 md:pt-[7.75rem] pb-10">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Back link -->
            <a href="/ratgeber" class="inline-flex items-center text-sm text-muted-foreground hover:text-primary mb-4 transition-colors">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Zurück zum Ratgeber
            </a>

            <!-- Category badge -->
            @if (!string.IsNullOrEmpty(Model.CategoryName))
            {
                <span class="inline-block text-xs font-semibold uppercase tracking-wider text-primary mb-3">
                    @Model.CategoryName
                </span>
            }

            <!-- Reading time -->
            <div class="flex items-center gap-1.5 text-sm text-muted-foreground mb-4">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/></svg>
                <span>@readingTime min Lesezeit</span>
            </div>

            <!-- Title -->
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-swiss-blue mb-4">
                @Model.TitleDe
            </h1>

            <!-- Intro -->
            <p class="text-base md:text-lg text-foreground/80 mb-8 leading-relaxed">
                @Model.IntroDe
            </p>

            <!-- Cover image -->
            @if (!string.IsNullOrEmpty(Model.CoverImage))
            {
                <img src="@Model.CoverImage" alt="@Model.TitleDe" class="w-full rounded-xl mb-8 object-cover max-h-96" />
            }

            <!-- Content blocks -->
            <div class="space-y-6">
                @foreach (var block in Model.Blocks)
                {
                    if (block.Type == "tip")
                    {
                        <div class="flex gap-3 bg-primary/5 border border-primary/20 rounded-lg p-4">
                            <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18h6M10 22h4M12 2a7 7 0 00-4 12.7c.6.5 1 1.2 1 2V17h6v-.3c0-.8.4-1.5 1-2A7 7 0 0012 2z"/></svg>
                            <div>
                                <p class="text-sm font-semibold text-primary mb-1">Profi-Tipp</p>
                                <p class="text-sm text-foreground">@block.Body</p>
                            </div>
                        </div>
                    }
                    else if (block.Type == "checklist" && block.Items.Count > 0)
                    {
                        <div>
                            @if (!string.IsNullOrEmpty(block.Heading))
                            {
                                <h2 class="text-xl font-bold text-foreground mb-3 mt-2">@block.Heading</h2>
                            }
                            <div class="bg-muted/50 rounded-lg p-4 space-y-2">
                                @foreach (var item in block.Items)
                                {
                                    <div class="flex items-start gap-2">
                                        <svg class="w-4 h-4 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        <span class="text-sm text-foreground">@item</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div>
                            @if (!string.IsNullOrEmpty(block.Heading))
                            {
                                <h2 class="text-xl font-bold text-foreground mb-3 mt-2">@block.Heading</h2>
                            }
                            <p class="text-foreground leading-relaxed">@block.Body</p>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- CTA -->
            <div class="mt-10 bg-primary/5 border border-primary/20 rounded-xl p-5 md:p-8 text-center">
                <h2 class="text-lg font-bold text-foreground mb-2">
                    Professionelle Reinigung gewünscht?
                </h2>
                <p class="text-sm text-muted-foreground mb-4">
                    Jetzt kostenloses und unverbindliches Angebot einholen.
                </p>
                <a href="tel:+41765017738" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-booking-orange to-booking-orange-dark text-white font-semibold rounded-lg shadow-button hover:shadow-hero transition-all duration-200">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                    Angebot anfordern
                </a>
            </div>
        </div>
    </article>
</div>

@await Html.PartialAsync("~/Views/Shared/_Footer.cshtml")
