@{
    ViewData["Title"] = "Frühlingsreinigung Zürich | Gründlicher Frühlingsputz zum Fixpreis";
    ViewData["Description"] = "Professionelle Frühlingsreinigung in Zürich zum Fixpreis. Fenster, Böden, Küche & Bad — alles inklusive. Jetzt Preis berechnen.";
    ViewData["Canonical"] = "https://zurich-endreinigung.ch/fruehlingsputz-zuerich";
    ViewData["Keywords"] = "Frühlingsreinigung Zürich, Frühlingsputz Zürich, Frühjahrsputz, Grundreinigung Frühling";
    ViewData["Contact.Title"] = "Kostenloses Angebot für Ihre Frühlingsreinigung in Zürich und Umgebung erhalten";
}

@section Head {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "Start", "item": "https://zurich-endreinigung.ch/" },
            { "@@type": "ListItem", "position": 2, "name": "Frühlingsreinigung Zürich", "item": "https://zurich-endreinigung.ch/fruehlingsputz-zuerich" }
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "AggregateOffer",
        "name": "Frühlingsreinigung Zürich – Fixpreise",
        "priceCurrency": "CHF",
        "lowPrice": "390",
        "highPrice": "1190",
        "offerCount": "8",
        "offers": [
            { "@@type": "Offer", "name": "Wohnung 1-1.5 Zimmer", "price": "390", "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/fruehlingsputz-zuerich" },
            { "@@type": "Offer", "name": "Wohnung 2-2.5 Zimmer", "price": "490", "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/fruehlingsputz-zuerich" },
            { "@@type": "Offer", "name": "Wohnung 3-3.5 Zimmer", "price": "590", "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/fruehlingsputz-zuerich" },
            { "@@type": "Offer", "name": "Wohnung 4-4.5 Zimmer", "price": "740", "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/fruehlingsputz-zuerich" },
            { "@@type": "Offer", "name": "Wohnung 5-5.5 Zimmer", "price": "890", "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/fruehlingsputz-zuerich" },
            { "@@type": "Offer", "name": "Einfamilienhaus 3-3.5 Zimmer", "price": "790", "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/fruehlingsputz-zuerich" },
            { "@@type": "Offer", "name": "Einfamilienhaus 4-4.5 Zimmer", "price": "990", "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/fruehlingsputz-zuerich" },
            { "@@type": "Offer", "name": "Einfamilienhaus 5-5.5 Zimmer", "price": "1190", "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/fruehlingsputz-zuerich" }
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "Was kostet eine Frühlingsreinigung in Zürich?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Eine professionelle Frühlingsreinigung kostet ab 390 CHF für eine 1–1.5-Zimmer-Wohnung. Der genaue Preis richtet sich nach Grösse und gewähltem Reinigungspaket (Standard oder ECO)."
                }
            },
            {
                "@@type": "Question",
                "name": "Was umfasst eine professionelle Frühlingsreinigung?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Eine professionelle Frühlingsreinigung umfasst die gründliche Reinigung aller Räume, Fenster innen und aussen, Böden wischen und pflegen, Küche und Sanitär intensiv reinigen, Staub und Spinnweben entfernen, Schränke aussen abwischen sowie Heizkörper und Lüftungsgitter reinigen."
                }
            },
            {
                "@@type": "Question",
                "name": "Wie lange dauert eine Frühlingsreinigung?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Eine professionelle Frühlingsreinigung dauert je nach Grösse der Wohnung oder des Hauses zwischen 4 und 8 Stunden."
                }
            },
            {
                "@@type": "Question",
                "name": "Ist eine professionelle Frühlingsreinigung sinnvoll?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Ja, denn ein Profi-Team reinigt gründlicher, schneller und mit professionellen Mitteln. Sie erhalten ein strahlendes Zuhause ohne eigenen Aufwand — ideal für den Frühjahrsputz."
                }
            },
            {
                "@@type": "Question",
                "name": "Was ist der Unterschied zwischen Standard und ECO Frühlingsreinigung?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Beim Standard-Paket verwenden wir bewährte Reinigungsmittel für ein optimales Ergebnis. Das ECO-Paket setzt ausschliesslich auf umweltfreundliche, biologisch abbaubare Reinigungsmittel — schonend für Mensch, Tier und Natur."
                }
            },
            {
                "@@type": "Question",
                "name": "Wann ist der beste Zeitpunkt für eine Frühlingsreinigung?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Der ideale Zeitpunkt ist zwischen März und Mai, wenn die Tage länger werden und man frisch durch den Frühling starten möchte. Wir empfehlen eine frühzeitige Buchung, da dieser Zeitraum sehr gefragt ist."
                }
            }
        ]
    }
    </script>
}

