    <main>

        <!-- ═══ PRICING ═══ -->
        <section id="preise" class="py-16 px-4 sm:px-6 lg:px-8 bg-muted/30 scroll-mt-16 md:scroll-mt-[6.25rem]">
            <div class="max-w-5xl mx-auto">
                <div class="text-center mb-8">
                    <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">Fixpreise Frühlingsreinigung</h2>
                    <p class="text-lg text-muted-foreground max-w-2xl mx-auto">Transparente Festpreise für Ihre Frühlingsreinigung in Zürich — alles inklusive.</p>
                </div>

                @{
                    var includedServices = new[] {
                        "Gründliche Reinigung aller Räume",
                        "Fenster innen & aussen reinigen",
                        "Böden gründlich wischen & pflegen",
                        "Küche & Sanitäranlagen intensiv reinigen",
                        "Staub & Spinnweben entfernen",
                        "Schränke aussen auswischen",
                    };
                    var wohnungPricing = new (string Size, int Standard, int Eco, bool Popular)[] {
                        ("1-1.5 Zimmer", 390, 490, false),
                        ("2-2.5 Zimmer", 490, 610, false),
                        ("3-3.5 Zimmer", 590, 740, true),
                        ("4-4.5 Zimmer", 740, 920, false),
                        ("5-5.5 Zimmer", 890, 1110, false),
                    };
                    var hausPricing = new (string Size, int Standard, int Eco)[] {
                        ("3-3.5 Zimmer", 790, 990),
                        ("4-4.5 Zimmer", 990, 1240),
                        ("5-5.5 Zimmer", 1190, 1490),
                    };
