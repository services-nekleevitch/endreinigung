        const typeBtns = document.querySelectorAll('[data-cleaning-type]');
        const sizeLabels = document.querySelectorAll('[data-selected-size-label]');
        const typeLabel = document.querySelector('[data-selected-type-label]');
        const priceStandardEl = document.querySelector('[data-price-standard]');
        const priceEcoEl = document.querySelector('[data-price-eco]');
        const finalPriceEl = document.querySelector('[data-final-price]');
        const finalTypeLabel = document.querySelector('[data-final-type-label]');

        let state = { size: null, type: null, standard: 0, eco: 0, cleaning: null };

        function setPriceLabels() {
            priceStandardEl.textContent = state.standard + ' CHF';
            priceEcoEl.textContent = state.eco + ' CHF';
        }

        function updateFinal() {
            if (!state.cleaning) {
                finalPriceEl.textContent = '—';
                finalTypeLabel.textContent = 'Bitte Reinigungsart wählen';
                return;
            }
            const price = state.cleaning === 'eco' ? state.eco : state.standard;
            finalPriceEl.textContent = price;
            finalTypeLabel.textContent = state.cleaning === 'eco' ? 'ECO Reinigung' : 'Standard Reinigung';
        }

        function setCleaningButtonsActive() {
            typeBtns.forEach(b => {
                const isActive = b.getAttribute('data-cleaning-type') === state.cleaning;
                b.classList.remove('border-primary', 'bg-primary/5', 'shadow-md', 'border-cleaning-green', 'bg-cleaning-green/5');
                if (isActive) {
                    if (state.cleaning === 'eco') b.classList.add('border-cleaning-green', 'bg-cleaning-green/5', 'shadow-md');
                    else b.classList.add('border-primary', 'bg-primary/5', 'shadow-md');
                }
            });
        }

        function selectCard(card) {
            state.size = card.getAttribute('data-size');
            state.type = card.getAttribute('data-property-type');
            state.standard = parseInt(card.getAttribute('data-standard'), 10);
            state.eco = parseInt(card.getAttribute('data-eco'), 10);
            state.cleaning = null;

            sizeLabels.forEach(el => { el.textContent = state.size; });
            if (typeLabel) typeLabel.textContent = state.type === 'haus' ? 'Einfamilienhaus' : 'Wohnung';
            setPriceLabels();
            setCleaningButtonsActive();
            updateFinal();

            cleaningSection.classList.remove('hidden');
            setTimeout(() => {
                cleaningSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 80);

            // Highlight selected card
            cards.forEach(c => {
                c.classList.remove('ring-2', 'ring-primary/20', 'ring-booking-orange/20');
            });
            if (state.type === 'haus') card.classList.add('ring-2', 'ring-booking-orange/20');
            else card.classList.add('ring-2', 'ring-primary/20');
        }

        cards.forEach(c => c.addEventListener('click', () => selectCard(c)));
        typeBtns.forEach(b => b.addEventListener('click', () => {
            state.cleaning = b.getAttribute('data-cleaning-type');
            setCleaningButtonsActive();
            updateFinal();
        }));
    })();
</script>

@await Html.PartialAsync("~/Views/Shared/_Footer.cshtml")
