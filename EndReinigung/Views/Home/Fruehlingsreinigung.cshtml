<script>
    function showTab(tab) {
        var wohnungTab = document.getElementById('tab-wohnung');
        var hausTab = document.getElementById('tab-haus');
        var btnWohnung = document.getElementById('btn-wohnung');
        var btnHaus = document.getElementById('btn-haus');

        if (tab === 'wohnung') {
            wohnungTab.classList.remove('hidden');
            hausTab.classList.add('hidden');
            btnWohnung.classList.add('bg-card', 'text-foreground', 'shadow-sm');
            btnWohnung.classList.remove('text-muted-foreground');
            btnHaus.classList.remove('bg-card', 'text-foreground', 'shadow-sm');
            btnHaus.classList.add('text-muted-foreground');
        } else {
            hausTab.classList.remove('hidden');
            wohnungTab.classList.add('hidden');
            btnHaus.classList.add('bg-card', 'text-foreground', 'shadow-sm');
            btnHaus.classList.remove('text-muted-foreground');
            btnWohnung.classList.remove('bg-card', 'text-foreground', 'shadow-sm');
            btnWohnung.classList.add('text-muted-foreground');
        }
    }
</script>

