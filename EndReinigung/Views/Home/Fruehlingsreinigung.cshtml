                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
                        @foreach (var p in wohnungPricing)
                        {
                            <button type="button"
                                    data-pricing-card data-property-type="wohnung"
                                    data-size="@p.Size" data-standard="@p.Standard" data-eco="@p.Eco"
                                    class="relative p-4 sm:p-6 bg-white rounded-lg border-2 hover:shadow-xl transition-all duration-300 cursor-pointer text-left @(p.Popular ? "border-swiss-blue shadow-lg" : "border-border")">
                                @if (p.Popular)
                                {
                                    <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
                                        <div class="bg-swiss-blue text-white text-xs font-bold px-4 py-1.5 rounded-full">Beliebt</div>
                                    </div>
                                }
                                <div class="absolute top-4 right-4">
                                    <div class="text-white text-xs font-bold px-3 py-1 rounded-full @(p.Popular ? "bg-cleaning-green" : "bg-trust-gold")">Fixpreis</div>
                                </div>
                                <div class="text-center mb-6">
                                    <div class="flex items-center justify-center mb-4">
                                        <svg class="w-8 h-8 text-swiss-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="9" y1="22" x2="9" y2="2"/><line x1="15" y1="22" x2="15" y2="2"/></svg>
                                    </div>
                                    <h3 class="text-xl font-bold text-foreground mb-1">@p.Size</h3>
                                    <p class="text-xs text-muted-foreground mb-2">Frühlingsreinigung in Zürich und Kanton</p>
                                    <div class="text-3xl font-bold text-swiss-blue mb-1">@p.Standard CHF</div>
                                    <p class="text-xs text-muted-foreground">Fixpreis inkl. Anfahrt, Material</p>
                                </div>
                                <div class="space-y-2 mb-6">
                                    @foreach (var feature in includedServices)
                                    {
                                        <div class="flex items-start">
                                            <svg class="w-4 h-4 text-cleaning-green mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                            <span class="text-xs text-foreground">@feature</span>
                                        </div>
                                    }
                                </div>
                                <span class="flex items-center justify-center w-full bg-swiss-blue hover:bg-swiss-blue/90 text-white text-sm font-medium px-4 py-2 rounded-md transition-colors">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    Jetzt Fixpreis berechnen
                                </span>
                            </button>
                        }
                    </div>
                </div>

                <!-- Einfamilienhaus cards -->
