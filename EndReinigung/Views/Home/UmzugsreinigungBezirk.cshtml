@{
    var bezirkName       = ViewData["BezirkName"]        as string ?? "Bezirk";
    var badgeLabel       = ViewData["BezirkBadgeLabel"]  as string ?? bezirkName;
    var h1               = ViewData["H1"]                as string ?? $"Endreinigung im {bezirkName} — Umzugsreinigung mit 100% Abnahmegarantie";
    var h2               = ViewData["H2"]                as string ?? $"Ihr Reinigungspartner im {bezirkName}";
    var hyperLocalH2     = ViewData["HyperLocalH2"]      as string ?? $"Alle Gemeinden im {bezirkName}";
    var localValueProp   = ViewData["LocalValueProp"]    as string ?? $"Lokale Reinigungsprofis im gesamten {bezirkName}";
    var examplePlz       = ViewData["ExamplePlz"]        as string ?? "8000";
    var heroImage        = ViewData["HeroImage"]         as string ?? "";
    var heroIntroLine    = ViewData["HeroIntroLine"]     as string ?? "";
    var logisticsParagraph = ViewData["LogisticsParagraph"] as string ?? "";
    var regionalAvailability = ViewData["RegionalAvailability"] as string ?? "";
    var paragraphs       = ViewData["Paragraphs"]        as string[] ?? Array.Empty<string>();
    var gemeindenSubtitle= ViewData["GemeindenSubtitle"] as string ?? $"Wir reinigen in allen Gemeinden im {bezirkName}.";
    var gemeindenRaw     = ViewData["Gemeinden"]         as string ?? "";
    var canonical        = ViewData["Canonical"]         as string ?? "";

    // Parse "Name:PLZ,Name:PLZ" pairs
    var gemeinden = gemeindenRaw
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(pair => {
            var parts = pair.Trim().Split(':', 2);
            return new { Name = parts[0].Trim(), Plz = parts.Length > 1 ? parts[1].Trim() : "" };
        })
        .ToList();

    // Split H1 on em-dash (—) for two-line gradient hero headline
    var h1Parts = h1.Split('—', 2);
    var h1Line1 = h1Parts[0].TrimEnd();
    var h1Line2 = h1Parts.Length > 1 ? h1Parts[1].TrimStart() : "";
}

@section Head {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@@type": "ListItem",
                "position": 1,
                "name": "Start",
                "item": "https://zurich-endreinigung.ch/"
            },
            {
                "@@type": "ListItem",
                "position": 2,
                "name": "Einsatzgebiete",
                "item": "https://zurich-endreinigung.ch/standorte"
            },
            {
                "@@type": "ListItem",
                "position": 3,
                "name": "@bezirkName",
                "item": "@canonical"
            }
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Service",
        "@@id": "@(canonical)#service",
        "url": "@canonical",
        "inLanguage": "de-CH",
        "serviceType": "Umzugsreinigung",
        "name": "Umzugsreinigung @bezirkName – Fixpreise nach Wohnungsgrösse",
        "provider": { "@@id": "https://zurich-endreinigung.ch/#business" },
        "areaServed": { "@@type": "AdministrativeArea", "name": "@bezirkName" },
        "offers": {
            "@@type": "AggregateOffer",
            "url": "@canonical",
            "priceCurrency": "CHF",
            "lowPrice": 550,
            "highPrice": 1290,
            "offerCount": 5,
            "offers": [
                { "@@type": "Offer", "name": "1.5–2 Zimmer", "price": 550,  "priceCurrency": "CHF", "url": "@canonical" },
                { "@@type": "Offer", "name": "2.5–3 Zimmer", "price": 690,  "priceCurrency": "CHF", "url": "@canonical" },
                { "@@type": "Offer", "name": "3.5–4 Zimmer", "price": 850,  "priceCurrency": "CHF", "url": "@canonical" },
                { "@@type": "Offer", "name": "4.5–5 Zimmer", "price": 1050, "priceCurrency": "CHF", "url": "@canonical" },
                { "@@type": "Offer", "name": "5.5+ Zimmer",  "price": 1290, "priceCurrency": "CHF", "url": "@canonical" }
            ]
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "inLanguage": "de-CH",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "Was kostet eine Umzugsreinigung im @bezirkName?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Unsere Fixpreise im @bezirkName beginnen bei CHF 550 für 1.5–2 Zimmer und gehen bis CHF 1'290 für 5.5+ Zimmer. Anfahrt und Material sind im Preis enthalten — auch bei Einsätzen in entlegeneren Gemeinden des @bezirkName."
                }
            },
            {
                "@@type": "Question",
                "name": "Wie funktioniert die Abnahmegarantie im @bezirkName?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Wir nehmen den Übergabetermin im @bezirkName persönlich wahr. Beanstandet der Vermieter Mängel, reinigen wir innerhalb von 24 Stunden kostenlos nach. So bleibt Ihre Mietkaution geschützt — typische Kautionsabzüge in der Region liegen zwischen CHF 500 und CHF 1'500."
                }
            },
            {
                "@@type": "Question",
                "name": "Welche Gemeinden im @bezirkName decken Sie ab?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "@(localValueProp). Wir reinigen in sämtlichen Gemeinden des @bezirkName — von kleinen Ortschaften bis zu den grösseren Zentren. Die Anfahrt ist im Fixpreis inkludiert, unabhängig von der PLZ."
                }
            },
            {
                "@@type": "Question",
                "name": "Wie schnell ist eine Nachreinigung im @bezirkName möglich?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Bei Beanstandungen durch die Verwaltung sind wir im @bezirkName in der Regel innerhalb von 24 Stunden wieder vor Ort. An Werktagen halten wir Reserve-Kapazitäten ausschliesslich für Nachreinigungen bereit, damit der Übergabeprozess nicht verzögert wird."
                }
            },
            {
                "@@type": "Question",
                "name": "Müssen wir bei der Wohnungsübergabe selbst anwesend sein?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Nein — viele Kundinnen und Kunden im @bezirkName übergeben uns die Schlüssel im Voraus und sind bei der Abnahme nicht selbst dabei (z. B. wegen Auslandumzug). Wir führen die Übergabe mit der Verwaltung durch und stellen Ihnen das Übergabeprotokoll digital zu."
                }
            }
        ]
    }
    </script>
}

<div class="min-h-screen flex flex-col">

    <!-- Breadcrumb -->
    <nav class="bg-background border-b border-border pt-20 md:pt-[6.5rem]" aria-label="Breadcrumb">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
            <ol class="flex items-center gap-2 text-sm text-muted-foreground flex-wrap">
                <li>
                    <a href="/" class="hover:text-swiss-blue transition-colors">Home</a>
                </li>
                <li>
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </li>
                <li>
                    <a href="/standorte" class="hover:text-swiss-blue transition-colors">Einsatzgebiete</a>
                </li>
                <li>
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </li>
                <li class="font-medium text-foreground" aria-current="page">@bezirkName</li>
            </ol>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="relative pt-20 md:pt-[7.75rem] pb-12 overflow-hidden">
        @if (!string.IsNullOrEmpty(heroImage))
        {
            <img src="@heroImage" alt="Umzugsreinigung @bezirkName" loading="eager" fetchpriority="high" width="1920" height="1080" class="absolute inset-0 w-full h-full object-cover" />
        }
        <div class="absolute inset-0 bg-gradient-hero opacity-75"></div>
        <div class="absolute inset-0 bg-black/20"></div>
        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-white">
            <div class="max-w-3xl">

                <!-- Badges -->
                <div class="flex flex-wrap gap-3 mb-3 sm:mb-6">
                    <div class="inline-flex items-center px-4 py-2 bg-primary-foreground/10 backdrop-blur-sm rounded-full border border-primary-foreground/20 animate-fade-in">
                        <span class="text-primary-foreground/90 text-sm font-medium">🌍 Expat Friendly</span>
                    </div>
                    <div class="inline-flex items-center px-4 py-2 bg-booking-orange rounded-full border border-booking-orange shadow-lg animate-fade-in animate-pulse">
                        <span class="text-primary-foreground text-sm font-bold">🏠 Wir sind bei der Abgabe dabei</span>
                    </div>
                    <div class="inline-flex items-center px-4 py-2 bg-cleaning-green rounded-full border border-cleaning-green shadow-lg animate-fade-in">
                        <span class="text-primary-foreground text-sm font-bold">💰 Fixpreis</span>
                    </div>
                    <div class="inline-flex items-center px-4 py-2 bg-booking-orange rounded-full animate-fade-in">
                        <svg class="w-4 h-4 text-primary-foreground mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0116 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <span class="text-primary-foreground text-sm font-bold">@badgeLabel</span>
                    </div>
                </div>

                <!-- H1 Headline -->
                <h1 class="text-3xl md:text-5xl font-bold text-primary-foreground mb-2 md:mb-4 leading-tight animate-slide-up font-heading">
                    @h1Line1
                    @if (!string.IsNullOrEmpty(h1Line2))
                    {
                        <br />
                        <span class="bg-gradient-accent bg-clip-text text-transparent">@h1Line2</span>
                    }
                </h1>

                <!-- Hero Intro Line -->
                @if (!string.IsNullOrEmpty(heroIntroLine))
                {
                    <p class="text-primary-foreground/90 text-base md:text-lg mb-6 animate-slide-up" style="animation-delay: 100ms">
                        @Html.Raw(heroIntroLine)
                    </p>
                }

                <!-- Bulleted Benefits -->
                <ul class="space-y-1.5 sm:space-y-3 mb-8 md:mb-10 animate-slide-up" style="animation-delay: 200ms">
                    <li class="flex items-center text-primary-foreground/90 text-base md:text-xl">
                        <span class="mr-3 text-lg">✅</span>
                        <span class="font-medium">Schweizer Qualität &amp; faire Preise</span>
                    </li>
                    <li class="flex items-center text-primary-foreground/90 text-base md:text-xl">
                        <span class="mr-3 text-lg">✅</span>
                        <span class="font-medium">Kaution zurück nach Ihrer Umzugsreinigung — garantiert</span>
                    </li>
                    <li class="flex items-center text-primary-foreground/90 text-base md:text-xl">
                        <span class="mr-3 text-lg">✅</span>
                        <span class="font-medium">@localValueProp</span>
                    </li>
                </ul>

                <!-- Mini Calculator Form -->
                <div class="bg-primary-foreground/10 backdrop-blur-sm rounded-2xl border border-primary-foreground/20 p-4 sm:p-6 max-w-2xl animate-slide-up" style="animation-delay: 400ms">
                    <p class="text-primary-foreground/80 text-sm font-medium mb-4">Fixpreis sofort berechnen:</p>
                    <form id="bezirk-hero-form" class="grid grid-cols-1 sm:grid-cols-[1.5fr_1fr_auto] gap-3">
                        <!-- Wohnungsgröße -->
                        <div class="relative">
                            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground pointer-events-none z-10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            <select id="bezirk-room-size" class="w-full h-12 rounded-xl bg-white text-foreground pl-10 pr-4 border-2 border-border focus:ring-2 focus:ring-booking-orange focus:border-booking-orange outline-none appearance-none text-sm cursor-pointer">
                                <option value="">Zimmerzahl wählen</option>
                                <option value="1.5">1.5 Zimmer</option>
                                <option value="2">2 Zimmer</option>
                                <option value="2.5">2.5 Zimmer</option>
                                <option value="3">3 Zimmer</option>
                                <option value="3.5">3.5 Zimmer</option>
                                <option value="4">4 Zimmer</option>
                                <option value="4.5">4.5 Zimmer</option>
                                <option value="5">5 Zimmer</option>
                                <option value="5.5">5.5 Zimmer</option>
                                <option value="6">6 Zimmer</option>
                                <option value="6.5+">6.5+ Zimmer</option>
                            </select>
                        </div>
                        <!-- PLZ -->
                        <div class="relative">
                            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0116 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            <input type="text" id="bezirk-zip-code" placeholder="z.B. @examplePlz" maxlength="4"
                                   class="w-full h-12 rounded-xl border-2 bg-white text-foreground pl-10 pr-4 placeholder:text-muted-foreground focus:ring-2 focus:ring-booking-orange focus:border-booking-orange outline-none text-sm border-border" />
                        </div>
                        <!-- Calculate Button -->
                        <button type="submit" class="h-12 px-6 text-sm rounded-xl bg-gradient-to-r from-booking-orange to-booking-orange-dark text-white font-semibold shadow-button hover:shadow-hero transition-all duration-200 hover:scale-105 whitespace-nowrap">
                            Preis berechnen
                        </button>
                    </form>
                    <p id="bezirk-hero-error" class="text-[13px] font-medium text-booking-orange-dark mt-2 min-h-[1.25rem]"></p>

                    <!-- Google Rating -->
                    <div class="mt-4 pt-4 border-t border-primary-foreground/20">
                        <a href="https://share.google/f60Gr7soQQux5lExT" target="_blank" rel="noopener noreferrer"
                           class="flex items-center gap-1 hover:opacity-80 transition-opacity">
                            <span class="text-trust-gold text-lg">★★★★★</span>
                            <span class="text-primary-foreground/80 text-sm ml-2">5/5 Bewertung auf Google</span>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </header>

    @await Html.PartialAsync("_TrustBar")

    <!-- TLDR Section -->
    <section class="py-10 md:py-12 bg-muted/40">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <ul class="flex flex-col sm:flex-row gap-4 sm:gap-8 justify-center">
                <li class="flex items-start gap-3">
                    <span class="text-2xl leading-none mt-0.5">✅</span>
                    <div>
                        <span class="font-bold text-foreground">Fixpreise ab CHF 550</span>
                        <p class="text-sm text-muted-foreground">Transparente Preise — keine versteckten Kosten</p>
                    </div>
                </li>
                <li class="flex items-start gap-3">
                    <span class="text-2xl leading-none mt-0.5">🏅</span>
                    <div>
                        <span class="font-bold text-foreground">100% Abnahmegarantie</span>
                        <p class="text-sm text-muted-foreground">Wir sind bei der Wohnungsabgabe persönlich dabei</p>
                    </div>
                </li>
                <li class="flex items-start gap-3">
                    <span class="text-2xl leading-none mt-0.5">🛡️</span>
                    <div>
                        <span class="font-bold text-foreground">5 Mio. CHF Versicherung</span>
                        <p class="text-sm text-muted-foreground">Vollversicherter Betrieb für Ihre Sicherheit</p>
                    </div>
                </li>
            </ul>
        </div>
    </section>

    <!-- Local Content Block -->
    <section class="py-16 md:py-20 bg-background">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl md:text-3xl font-bold text-foreground mb-6 font-heading">
                @h2
            </h2>
            <div class="prose prose-lg max-w-none text-muted-foreground space-y-4">
                @foreach (var para in paragraphs)
                {
                    @Html.Raw($"<p>{para}</p>")
                }
            </div>
        </div>
    </section>

    <!-- Logistics Section -->
    @if (!string.IsNullOrEmpty(logisticsParagraph))
    {
        <section class="py-14 md:py-18 bg-muted/30">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="text-xl md:text-2xl font-bold text-foreground mb-4 font-heading">
                    Lokale Logistik im @badgeLabel: Verwaltungen, Zufahrt, Parkplätze
                </h2>
                <div class="prose prose-base max-w-none text-muted-foreground">
                    <p>@Html.Raw(logisticsParagraph)</p>
                </div>
            </div>
        </section>
    }

    <!-- Regional Availability Section -->
    @if (!string.IsNullOrEmpty(regionalAvailability))
    {
        <section class="py-14 md:py-18 bg-background">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="text-xl md:text-2xl font-bold text-foreground mb-4 font-heading">
                    Regional verfügbar im @badgeLabel
                </h2>
                <div class="prose prose-base max-w-none text-muted-foreground">
                    <p>@Html.Raw(regionalAvailability)</p>
                </div>
            </div>
        </section>
    }

    @await Html.PartialAsync("_FixedPricing")

    <!-- Municipality Links Grid -->
    @if (gemeinden.Any())
    {
        <section class="py-16 md:py-20 bg-background">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="text-2xl md:text-3xl font-bold text-foreground mb-3 font-heading text-center">
                    @hyperLocalH2
                </h2>
                <p class="text-center text-muted-foreground mb-10 max-w-xl mx-auto">
                    @gemeindenSubtitle
                </p>
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                    @foreach (var g in gemeinden)
                    {
                        <a href="/calculator?zip=@g.Plz"
                           class="flex items-center justify-between p-4 rounded-xl border border-border bg-card hover:border-swiss-blue hover:shadow-md transition-all duration-200 text-left group">
                            <div>
                                <span class="font-semibold text-foreground group-hover:text-swiss-blue transition-colors">@g.Name</span>
                                <span class="block text-xs text-muted-foreground">@g.Plz</span>
                            </div>
                            <svg class="w-4 h-4 text-muted-foreground group-hover:text-swiss-blue transition-colors flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    @await Html.PartialAsync("_Var2Services")

    <!-- CTA Section -->
    <section class="py-16 md:py-20 bg-swiss-blue">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-2xl md:text-3xl font-bold text-primary-foreground mb-4 font-heading">
                Bereit für Ihre Endreinigung im @bezirkName?
            </h2>
            <p class="text-primary-foreground/80 text-lg mb-8 max-w-xl mx-auto">
                Fixpreis, persönliche Abnahmebegleitung und 100% Abnahmegarantie — ohne Risiko.
            </p>
            <a href="/calculator"
               class="inline-flex items-center justify-center px-8 py-4 bg-booking-orange text-white text-lg font-bold rounded-xl shadow-button hover:bg-booking-orange-dark transition-colors duration-200 hover:scale-105">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Kostenlose Offerte anfordern
            </a>
        </div>
    </section>

</div>

@await Html.PartialAsync("~/Views/Shared/_Footer.cshtml")

<!-- Sticky Call Button (mobile) -->
<a href="tel:+41765017738"
   class="fixed bottom-4 left-4 right-4 z-50 flex items-center justify-center gap-2 bg-swiss-blue text-primary-foreground font-bold py-4 rounded-2xl shadow-hero md:hidden animate-fade-in">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
    Jetzt anrufen
</a>

<script>
    (function () {
        var form = document.getElementById('bezirk-hero-form');
        if (!form) return;
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var rooms = document.getElementById('bezirk-room-size').value;
            var zip   = document.getElementById('bezirk-zip-code').value.trim();
            var err   = document.getElementById('bezirk-hero-error');
            if (!rooms && !zip) { err.textContent = 'Bitte Zimmerzahl und PLZ eingeben.'; return; }
            if (!rooms) { err.textContent = 'Bitte Zimmerzahl wählen.'; return; }
            if (!zip)   { err.textContent = 'Bitte PLZ eingeben.'; return; }
            err.textContent = '';
            window.location.href = '/calculator?rooms=' + encodeURIComponent(rooms) + '&zip=' + encodeURIComponent(zip);
        });
    })();
</script>
