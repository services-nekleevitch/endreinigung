<script>
(function () {
    var rates = { Terrasse: 12, "Sitzplatz/Pflaster": 10, Balkon: 18, Einfahrt: 9, Hauseingang: 15, Pool: 15, Gartenmauer: 13 };

    function calcUpdate() {
        var m2 = Math.max(0, parseFloat(document.getElementById('calc-flaeche').value) || 0);
        var objekt = document.getElementById('calc-objekt').value;
        var rate = rates[objekt] || 14;
        var G = m2 * rate;
        var V = G * (parseFloat(document.getElementById('calc-verschmutzung').value) || 0);
        var matVal = document.getElementById('calc-material').value;
        var matPct = matVal === '0.20b' ? 0.20 : parseFloat(matVal) || 0;
        var M = G * matPct;
        var m2f = m2;
        var Z = 0;
        if (document.getElementById('calc-impraegnierung').checked) Z += m2f * 7;
        if (document.getElementById('calc-fugensand').checked) Z += m2f * 5;
        if (document.getElementById('calc-oelfleck').checked) Z += 100;
        var anfahrtVal = document.getElementById('calc-anfahrt').value;
        var anfrage = anfahrtVal === 'anfragen';
        var A = anfrage ? 0 : (parseFloat(anfahrtVal) || 0);
        var RFruehling = document.getElementById('calc-fruehling').checked ? -G * 0.1 : 0;
        var RBuendel = document.getElementById('calc-buendel').checked ? -G * 0.05 : 0;
        var sum = G + V + M + Z + A + RFruehling + RBuendel;
        var final = Math.max(290, sum);
        var el = document.getElementById('calc-result');
        if (anfrage) {
            el.textContent = 'Bitte anfragen';
        } else {
            el.textContent = 'CHF ' + Math.round(final).toLocaleString('de-CH').replace(/ /g, "'") + '.–';
        }
    }
    window.calcUpdate = calcUpdate;
    calcUpdate();

    window.hochdruckSubmit = function (e) {
        e.preventDefault();
        var f = e.target;
        var subject = encodeURIComponent('[Hochdruckreinigung] Offerte von ' + f.name.value);
        var body = encodeURIComponent(
            'Name: ' + f.name.value + '\n' +
            'E-Mail: ' + f.email.value + '\n' +
            'Telefon: ' + (f.phone.value || '—') + '\n' +
            'Objekt-Typ: ' + f.objektTyp.value + '\n' +
            'Fläche: ' + f.flaeche.value + ' m²\n' +
            'Paket: ' + f.paket.value + '\n' +
            'PLZ: ' + f.plz.value + '\n' +
            'Nachricht: ' + (f.message.value || '—')
        );
        window.location.href = 'mailto:info@zurich-endreinigung.ch?subject=' + subject + '&body=' + body;
    };
})();
</script>

</div>
