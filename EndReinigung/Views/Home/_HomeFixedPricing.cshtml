<section class="py-5 bg-light">
    <div class="container-xl py-3">
        <div class="text-center mb-5">
            <h2 class="fw-bold display-6 mb-2">Fixpreise Reinigung inkl. Wohnungsabgabe</h2>
            <p class="text-muted-foreground fs-5 mb-0">Transparente Festpreise für Ihre End-of-Lease Reinigung - Alles inklusive</p>
        </div>

        <div class="row g-4">
            @{
                var plans = new[]
                {
                        new { Size="1-1.5 Zimmer", Price="550 CHF", Popular=false },
                        new { Size="2-2.5 Zimmer", Price="650 CHF", Popular=false },
                        new { Size="3-3.5 Zimmer", Price="850 CHF", Popular=true  },
                        new { Size="4-4.5 Zimmer", Price="970 CHF", Popular=false },
                        new { Size="5-5.5 Zimmer", Price="1150 CHF", Popular=false },
                        };
                var features = new[]
                {
                        "Komplettreinigung",
                        "Wohnungsabgabe-fertig",
                        "Alle Räume & Küche",
                        "Fenster innen & außen",
                        "Rollläden und Storen",
                        "Abnahmegarantie"
                        };
            }

            @foreach (var p in plans)
            {
                <div class="col-12 col-md-6 col-lg-4 col-xl-2">
                    <div class="pricing-card p-4 h-100 position-relative @(p.Popular ? "popular" : "")">
                        @if (p.Popular)
                        {
                            <div class="position-absolute top-0 start-50 translate-middle mt-0">
                                <span class="badge rounded-pill px-3 py-2" style="background:var(--swiss-blue);">Am beliebtesten</span>
                            </div>
                        }

                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge rounded-pill px-3 py-2 text-dark"
                                  style="background:@(p.Popular ? "var(--cleaning-green)" : "var(--trust-gold)");">
                                Fix Preis
                            </span>
                        </div>

                        <div class="text-center pt-2">
                            <div class="mb-3" style="font-size:1.6rem;color:var(--swiss-blue);">🏠</div>
                            <div class="fw-bold fs-5">@p.Size</div>
                            <div class="fw-bold" style="font-size:2rem;color:var(--swiss-blue);">@p.Price</div>
                            <div class="small text-muted">alles inkl.</div>
                        </div>

                        <div class="mt-4 small">
                            @foreach (var f in features)
                            {
                                <div class="d-flex align-items-start mb-2">
                                    <i class="bi bi-check2-circle me-2" style="color: var(--cleaning-green); font-weight: bolder; font-size: large"></i>
                                    <span>@f</span>
                                </div>
                            }
                        </div>

                        <a class="btn btn-sm w-100 mt-3" style="background:var(--swiss-blue); color:#fff;" href="/booking/start">
                            📅 Jetzt Buchen
                        </a>
                    </div>
                </div>
            }

            <!-- Custom package -->
            <div class="col-12 col-md-6 col-lg-4 col-xl-2">
                <div class="pricing-card p-4 h-100 position-relative" style="border-color:#ced4da;">
                    <div class="position-absolute top-0 end-0 m-3">
                        <span class="badge rounded-pill px-3 py-2" style="background:#6c757d;">Individuelles Angebot</span>
                    </div>

                    <div class="text-center pt-2">
                        <div class="mb-3" style="font-size:1.6rem;color:var(--swiss-blue);">🏢</div>
                        <div class="fw-bold" style="line-height:1.2;">6+ Zimmer / Haus / Spezialobjekt</div>
                        <div class="fw-bold mt-2" style="font-size:1.4rem;color:var(--swiss-blue);">Individueller Preis</div>
                        <div class="small text-muted">basierend auf Grösse &amp; Zustand</div>
                    </div>

                    <div class="mt-4 small">
                        @{
                            var custom = new[]
                            {
                                                "Komplette Endreinigung","Wohnungsabgabe-fertig","Alle Räume & Küche",
                                                "Fenster innen & aussen","Rollläden und Storen","Keller, Estrich, Garage (falls vorhanden)","Abnahmegarantie"
                                                };
                        }
                        @foreach (var f in custom)
                        {
                            <div class="d-flex align-items-start mb-2">
                                <i class="bi bi-check2-circle me-2" style="color: var(--cleaning-green); font-weight: bolder; font-size: large"></i>
                                <span>@f</span>
                            </div>
                        }
                    </div>

                    <a class="btn btn-sm w-100 mt-3" style="background:var(--swiss-blue); color:#fff;" href="#contact">
                        ✉ Kostenlose Offerte anfordern
                    </a>
                    <div class="text-center mt-2" style="font-size:10px;color:var(--muted-fg);">Antwort innerhalb von 24 Stunden</div>
                </div>
            </div>
        </div>

        <div class="mt-5">
            <div class="bg-white rounded-3 shadow-card p-4 p-md-5">
                <h3 class="fw-bold text-center mb-4">Im Preis enthalten</h3>
                <div class="row g-4 text-center">
                    @{
                        var included = new[]
                        {
                                        new { Title="Komplettreinigung", Desc="Alle Räume gründlich gereinigt" },
                                        new { Title="Küche & Bad", Desc="Tiefenreinigung inklusive" },
                                        new { Title="Fenster", Desc="Innen & außen streifenfrei" },
                                        new { Title="Abnahmegarantie", Desc="100% abnahmebereit" },
                                        new { Title="Rollläden & Storen", Desc="Gründliche Reinigung inklusive" },
                                        new { Title="Festpreis", Desc="Keine versteckten Kosten" },
                                        };
                    }
                    @foreach (var x in included)
                    {
                        <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
                            <div class="mx-auto mb-2 d-flex align-items-center justify-content-center rounded-circle"
                                 style="width:64px;height:64px;background:#f3f4f6;">
                                <i class="bi bi-check2-circle me-2" style="color: var(--cleaning-green); font-size: 2rem"></i>
                            </div>
                            <div class="fw-semibold">@x.Title</div>
                            <div class="small text-muted">@x.Desc</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
