@using Microsoft.AspNetCore.Mvc.ViewFeatures
@{
    ViewData["Title"] = "Umzugsreinigung Zürich | 100% Abnahmegarantie & Fixpreis";
    ViewData["Description"] = "Professionelle Umzugsreinigung in Zürich ab 550 CHF zum Fixpreis. 100% Abnahmegarantie & persönliche Anwesenheit bei der Abnahme. Preis sofort online berechnen!";
    ViewData["Canonical"] = "https://zurich-endreinigung.ch/umzugsreinigung-stadt-zuerich";
    ViewData["Keywords"] = "Umzugsreinigung Zürich, Zügelreinigung Zürich, Wohnungsreinigung Zürich, Umzugsreinigung Kosten, Umzugsreinigung Abnahmegarantie, Wohnungsabgabe Reinigung, Auszugsreinigung Zürich";
    ViewData["HeroPreload"] = "/img/zurich-cityscape.webp";
    ViewData["HeroPreloadMobile"] = "/img/zurich-cityscape-mobile.webp";

    var umzugsFaqs = new (string Q, string A)[] {
        ("Wie viel kostet eine Umzugsreinigung in Zürich?", "Die Kosten für eine Umzugsreinigung in Zürich hängen von der Wohnungsgrösse ab. Bei uns beginnen die Fixpreise ab CHF 550 für eine 1-1.5 Zimmer Wohnung. Eine 3.5 Zimmer Wohnung kostet CHF 850, eine 5.5 Zimmer Wohnung CHF 1'150 und eine 6.5 Zimmer Wohnung CHF 1'350. Alle Preise sind Fixpreise inklusive Material, Anfahrt und 100% Abnahmegarantie. Nicht mehrwertsteuerpflichtig."),
        ("Was beinhaltet die Abnahmegarantie bei einer Umzugsreinigung?", "Unsere 100% Abnahmegarantie bedeutet: Wir sind bei der Wohnungsübergabe persönlich anwesend. Sollte der Vermieter oder die Verwaltung reinigungsbezogene Beanstandungen haben, beheben wir diese kostenlos und wenn möglich direkt vor Ort. Für die Nachbesserung reinigungsbezogener Beanstandungen entstehen keine zusätzlichen Reinigungskosten."),
        ("Was ist der Unterschied zwischen Umzugsreinigung und Endreinigung?", "Es gibt keinen Unterschied. Umzugsreinigung, Endreinigung, Zügelreinigung und Auszugsreinigung sind verschiedene Begriffe für dieselbe Leistung: die gründliche Reinigung einer Wohnung vor der Übergabe an den Vermieter. Bei uns erhalten Sie bei allen Varianten denselben umfassenden Service."),
        ("Wie lange dauert eine professionelle Umzugsreinigung?", "Die Dauer einer Umzugsreinigung hängt von Wohnungsgrösse, Zustand, Ausstattung und Zugänglichkeit ab. Wir planen für jeden Auftrag ausreichend Zeit ein, damit alle vereinbarten Bereiche gründlich gereinigt und vor der Wohnungsübergabe kontrolliert werden können."),
        ("Kann ich eine Umzugsreinigung kurzfristig buchen?", "Ja. Kurzfristige Termine sind nach Verfügbarkeit möglich. Für besonders dringende Fälle bieten wir auch kurzfristigere Termine an. Rufen Sie uns an unter +41 76 501 77 38 oder nutzen Sie unseren Online-Preisrechner."),
        ("Muss die Wohnung leer sein für die Umzugsreinigung?", "Ja. Die Wohnung muss für die Umzugsreinigung vollständig geräumt, frei von Möbeln und Abfällen und für das Reinigungsteam zugänglich sein. Nur so können alle vereinbarten Flächen vollständig und fachgerecht gereinigt werden."),
        ("Bekomme ich meine Kaution zurück mit einer professionellen Umzugsreinigung?", "Eine professionelle Umzugsreinigung kann helfen, reinigungsbedingte Abzüge von der Mietkaution zu vermeiden. Unsere 100% Abnahmegarantie gilt für die Reinigungsleistung und reinigungsbezogene Beanstandungen. Die vollständige Rückzahlung der Kaution können wir nicht garantieren, da auch Schäden, offene Forderungen oder andere Faktoren eine Rolle spielen können."),
        ("Was bedeutet \"besenrein\" bei der Wohnungsübergabe?", "«Besenrein» bezeichnet in der Regel eine einfache Grobreinigung. Welcher Reinigungsstandard bei der Wohnungsrückgabe tatsächlich verlangt wird, richtet sich nach dem Mietvertrag und den konkreten Vorgaben von Vermieter oder Verwaltung. Eine professionelle Umzugsreinigung ist deutlich umfassender und beinhaltet je nach Auftrag unter anderem Küche, Bad, Fenster, Rahmen und Storen."),
        ("Umzugsreinigung selber machen oder Profis beauftragen?", "Eine Umzugsreinigung selbst durchzuführen ist möglich, erfordert jedoch viel Zeit und eine sorgfältige Kontrolle aller relevanten Bereiche. Bei einer professionellen Umzugsreinigung übernehmen wir die vereinbarten Reinigungsarbeiten und sind im Rahmen unserer Abnahmegarantie bei der Wohnungsübergabe persönlich vor Ort. Reinigungsbezogene Beanstandungen beheben wir kostenlos."),
        ("Sind Fenster und Storen in der Umzugsreinigung enthalten?", "Ja. Unsere Umzugsreinigung beinhaltet die Reinigung aller Fenster innen und aussen, Fensterrahmen, Fensterbänke, Rollläden und Storen. Dies ist im Fixpreis enthalten — keine Zusatzkosten."),
        ("Arbeiten Sie auch am Wochenende?", "Ja. Unsere Öffnungszeiten sind Montag bis Freitag 08:00–19:00 und Samstag 09:00–16:00. Auch samstags führen wir Umzugsreinigungen und Wohnungsübergaben durch."),
        ("Was passiert, wenn der Vermieter nach der Reinigung nicht zufrieden ist?", "Dank unserer 100% Abnahmegarantie beheben wir reinigungsbezogene Beanstandungen kostenlos. Da wir bei der Übergabe persönlich vor Ort sind, beheben wir reinigungsbezogene Beanstandungen wenn möglich direkt bei der Wohnungsübergabe."),
        ("Reinigen Sie auch in der Stadt Zürich und in allen 12 Kreisen?", "Ja. Wir sind in allen 12 Stadtkreisen im Einsatz — von Kreis 1 (Altstadt) über Aussersihl, Seefeld und Wiedikon bis Oerlikon und Schwamendingen. Die Fixpreise gelten in der ganzen Stadt Zürich und im gesamten Kanton, ohne Anfahrtszuschlag."),
        ("Kennen Sie die Anforderungen der Zürcher Verwaltungen?", "Bei Wohnungsübergaben begegnen uns unterschiedliche Anforderungen von Verwaltungen. Entscheidend sind der Mietvertrag, das Übergabeprotokoll und die konkreten Vorgaben für das Objekt. Typische Prüfpunkte sind beispielsweise Backofen, Dampfabzug, Storen, Lüftungsschlitze, Kalkränder und Schrankinnenseiten. Diese Bereiche berücksichtigen wir bei der Reinigung entsprechend dem vereinbarten Leistungsumfang."),
        ("Wie läuft die Anfahrt und das Parkieren in der Stadt Zürich?", "Die Anfahrt planen wir im Voraus und sie ist im vereinbarten Fixpreis enthalten. Je nach Lage können in der Stadt Zürich eine Parkbewilligung, eine Tageskarte für die blaue Zone oder andere kostenpflichtige Parkmöglichkeiten erforderlich sein. Falls zusätzliche externe Parkkosten entstehen, informieren wir Sie vorab und vereinbaren diese transparent.")
    };

    var jsonOptions = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var faqSchemaJson = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object> {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["inLanguage"] = "de-CH",
        ["mainEntity"] = umzugsFaqs.Select(f => new Dictionary<string, object> {
            ["@type"] = "Question",
            ["name"] = f.Q,
            ["acceptedAnswer"] = new Dictionary<string, object> { ["@type"] = "Answer", ["text"] = f.A }
        }).ToList()
    }, jsonOptions);
}

