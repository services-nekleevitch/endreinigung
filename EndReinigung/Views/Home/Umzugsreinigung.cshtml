                <div class="bg-card border-2 border-swiss-blue rounded-xl p-6 shadow-lg relative">
                    <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                        <span class="bg-swiss-blue text-white text-xs font-bold px-4 py-1 rounded-full">Unser Service</span>
                    </div>
                    <div class="w-12 h-12 bg-swiss-blue/10 rounded-xl flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-swiss-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-foreground mb-3">Endreinigung</h3>
                    <p class="text-muted-foreground leading-relaxed text-sm">
                        Gebräuchlicher Begriff in der deutschsprachigen Schweiz. Betont den Aspekt der «letzten Reinigung» vor der Wohnungsübergabe. Inhaltlich identisch mit der Umzugsreinigung.
                    </p>
                    <div class="mt-4 pt-4 border-t border-border">
                        <span class="text-xs font-medium text-swiss-blue flex items-center gap-1">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                            Fixpreis ab CHF 550 mit Abnahmegarantie
                        </span>
                    </div>
                </div>

                <!-- Zügelreinigung -->
                <div class="bg-card border border-border rounded-xl p-6 shadow-md">
                    <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-foreground mb-3">Zügelreinigung</h3>
                    <p class="text-muted-foreground leading-relaxed text-sm">
                        Typisch zürichdeutsch — «zügelreinigung» leitet sich von «zügeln» (umziehen) ab. Der Begriff ist in Zürich und der Ostschweiz besonders verbreitet. Inhaltlich identisch mit der Endreinigung.
                    </p>
                    <div class="mt-4 pt-4 border-t border-border">
                        <span class="text-xs font-medium text-cleaning-green flex items-center gap-1">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                            Identisch mit Umzugsreinigung & Endreinigung
                        </span>
                    </div>
                </div>
            </div>
            <p class="text-center text-muted-foreground text-sm max-w-2xl mx-auto mt-10">Bei uns erhalten Sie bei allen drei Varianten denselben umfassenden Service: Komplettreinigung mit Fixpreis und 100% Abnahmegarantie.</p>
        </div>
    </section>

    <!-- Stadt Zürich -->

    <!-- Umzugsreinigung Stadt Zürich — 12 Kreise -->
    <section class="py-16 md:py-24 bg-white" aria-labelledby="stadt-zuerich-kreise">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 id="stadt-zuerich-kreise" class="text-2xl sm:text-3xl md:text-4xl font-bold text-foreground mb-4 text-center">Umzugsreinigung Stadt Zürich — in allen 12 Kreisen</h2>
            <p class="text-muted-foreground text-center mb-10 max-w-3xl mx-auto">Vom Kreis 1 in der Altstadt bis Schwamendingen im Kreis 12: Wir begleiten Ihre Wohnungsabgabe in jedem Quartier der Stadt Zürich — und im ganzen Kanton.</p>

            <div class="space-y-5 mb-12">
                <p class="text-muted-foreground text-base md:text-lg leading-relaxed">Die <strong>Umzugsreinigung Stadt Zürich</strong> berücksichtigt die Eigenheiten des jeweiligen Objekts. Je nach Quartier unterscheiden sich Gebäudetypen, Fensterflächen, Zugänge und Parksituationen. Bei Altbauten können beispielsweise ältere Fenster, Storen oder empfindliche Oberflächen zusätzlichen Reinigungsaufwand verursachen; bei neueren Wohnungen spielen häufig grosse Fensterflächen und moderne Lüftungssysteme eine Rolle.</p>
                <p class="text-muted-foreground text-base md:text-lg leading-relaxed">Bei Wohnungsübergaben begegnen uns unterschiedliche Anforderungen von Verwaltungen. Entscheidend sind der Mietvertrag, das Übergabeprotokoll und die konkreten Vorgaben für das Objekt. Zugang und Parkierung klären wir vorab — je nach Lage etwa eine Bewilligung für die blaue Zone, enge Gassen in der Altstadt oder Höhenlimiten in Tiefgaragen.</p>
                <p class="text-muted-foreground text-base md:text-lg leading-relaxed">Unsere <strong>Umzugsreinigung mit Abnahmegarantie</strong> umfasst Backofen, Dampfabzug, Kalkränder in Bad und Küche, Storen und Rollladen-Kästen, Lüftungsschlitze, Heizkörperrückseiten und Schrankleisten — typische Punkte aus dem Übergabeprotokoll. Kurzfristige Termine sind nach Verfügbarkeit möglich. Fixpreise ab CHF 550.</p>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                @foreach (var k in new[] {
                    ("Kreis 1 (Altstadt)", "8001"),
                    ("Kreis 2 (Enge, Wollishofen)", "8002"),
                    ("Kreis 3 (Wiedikon)", "8003"),
                    ("Kreis 4 (Aussersihl)", "8004"),
                    ("Kreis 5 (Industriequartier)", "8005"),
                    ("Kreis 6 (Oberstrass, Unterstrass)", "8006"),
                    ("Kreis 7 (Fluntern, Hottingen)", "8032"),
                    ("Kreis 8 (Seefeld, Riesbach)", "8008"),
                    ("Kreis 9 (Albisrieden, Altstetten)", "8047"),
                    ("Kreis 10 (Höngg, Wipkingen)", "8037"),
                    ("Kreis 11 (Affoltern, Oerlikon, Seebach)", "8050"),
                    ("Kreis 12 (Schwamendingen)", "8051") }) {
                    <div class="flex items-start gap-2 rounded-xl border border-border bg-secondary/30 px-4 py-3">
                        <svg class="w-4 h-4 text-swiss-blue mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                        <span class="text-sm text-foreground leading-snug">
                            @k.Item1
                            <span class="block text-xs text-muted-foreground">@k.Item2</span>
                        </span>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Personal Presence Banner -->
    @await Html.PartialAsync("_PersonalPresenceBanner")

    <!-- Info + Google Reviews carousel -->
    <section class="py-12 md:py-24" style="background: linear-gradient(180deg, hsl(210 10% 96%) 0%, hsl(210 10% 93%) 60%, hsl(0 0% 100%) 100%)">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-6">
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-foreground mb-10 text-center">
                    Umzugsreinigung in Zürich:<br /><span class="text-swiss-blue">Professionelle Wohnungsreinigung</span>
                </h2>

                <div class="space-y-5 mb-12 max-w-4xl mx-auto">
                    @{
                        var arrowSvg = "<svg class=\"w-5 h-5 text-primary mt-1 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" viewBox=\"0 0 24 24\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg>";
                    }
                    <div class="flex items-start gap-4">
                        @Html.Raw(arrowSvg)
                        <p class="text-muted-foreground text-base md:text-lg leading-relaxed">Unsere <span class="text-primary font-semibold">Umzugsreinigung in Zürich</span> bereitet Ihre Wohnung gründlich und übergabebereit auf die Wohnungsübergabe vor.</p>
                    </div>
                    <div class="flex items-start gap-4">
                        @Html.Raw(arrowSvg)
                        <p class="text-muted-foreground text-base md:text-lg leading-relaxed">Die Umzugsreinigung erfolgt zum <span class="font-semibold">fairen Fixpreis</span> – so gibt es für Sie keine bösen Überraschungen bei den Kosten.</p>
                    </div>
                    <div class="flex items-start gap-4">
                        @Html.Raw(arrowSvg)
                        <p class="text-muted-foreground text-base md:text-lg leading-relaxed">Unsere Abnahmegarantie beinhaltet, dass unser Team bei der Übergabe <span class="font-semibold">persönlich vor Ort</span> ist und reinigungsbezogene Beanstandungen der Verwaltung wenn möglich direkt vor Ort und <span class="font-semibold">kostenlos</span> behebt.</p>
                    </div>
                    <div class="flex items-start gap-4">
                        @Html.Raw(arrowSvg)
                        <p class="text-muted-foreground text-base md:text-lg leading-relaxed">Bei Wohnungsübergaben richten wir uns nach dem Mietvertrag, dem Übergabeprotokoll und den konkreten Vorgaben für das Objekt. <span class="font-semibold">Kurzfristige Termine nach Verfügbarkeit.</span></p>
                    </div>
                </div>

                @await Html.PartialAsync("~/Views/Shared/_GoogleReviewsCarousel.cshtml")
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="py-16 md:py-24 bg-white scroll-mt-16 md:scroll-mt-[6.25rem]" aria-labelledby="faq-umzugsreinigung">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 id="faq-umzugsreinigung" class="text-2xl sm:text-3xl md:text-4xl font-bold text-foreground mb-3 text-center">Häufig gestellte Fragen zur Umzugsreinigung in Zürich</h2>
            <p class="text-muted-foreground text-center mb-12">Alles, was Sie über Ihre Umzugsreinigung im Kanton Zürich wissen müssen</p>

            <div class="space-y-3">
                @foreach (var faq in umzugsFaqs) {
                    <div class="faq-item border border-border rounded-xl px-5 bg-white">
                        <button type="button" class="faq-trigger w-full flex items-center justify-between gap-4 text-left text-sm md:text-base font-semibold text-foreground py-4">
                            <span>@faq.Q</span>
                            <svg class="faq-chevron w-4 h-4 flex-shrink-0 text-muted-foreground" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                        <div class="faq-answer text-sm text-muted-foreground leading-relaxed">
                            <div class="pb-4">@faq.A</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Calculator CTA -->
    <section class="py-8 md:py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <a href="/calculator" class="inline-flex items-center justify-center rounded-md bg-primary px-8 py-3 text-lg font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90">Preis sofort online berechnen</a>
        </div>
    </section>

    <!-- Contact Section -->
    @await Html.PartialAsync("_Contact", null, new ViewDataDictionary(ViewData) {
        ["Contact.Title"] = "Kostenloses Angebot für Ihre Umzugsreinigung",
        ["Contact.Subtitle1"] = "Professionelle Umzugsreinigung in Zürich mit 100% Abnahmegarantie"
    })

</div>

@await Html.PartialAsync("~/Views/Shared/_Footer.cshtml")
