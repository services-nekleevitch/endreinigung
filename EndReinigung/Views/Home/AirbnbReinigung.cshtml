}

<main class="min-h-screen">

    <!-- 1. Hero Section -->
    <section class="relative pt-20 md:pt-[6.25rem] min-h-[48vh] flex items-center overflow-hidden">
        <!-- Background image + dark overlay -->
        <div class="absolute inset-0">
            <img src="/img/airbnb-hero-bg.jpg" alt="" class="w-full h-full object-cover" width="1920" height="1080" />
            <div class="absolute inset-0" style="background: linear-gradient(135deg, hsla(210,100%,15%,0.88) 0%, hsla(210,95%,25%,0.85) 50%, hsla(210,85%,35%,0.80) 100%)"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 w-full">
            <div class="max-w-3xl">
                <!-- Badges -->
                <div class="flex flex-wrap gap-2 mb-3">
                    <div class="inline-flex items-center px-4 py-1.5 bg-white/10 backdrop-blur-sm rounded-full border border-white/20 animate-fade-in">
                        <span class="text-white/90 text-sm font-medium">Expat Friendly</span>
                    </div>
                    <span class="inline-block bg-trust-gold text-white font-semibold text-sm px-4 py-1.5 rounded-full">
                        @T("Fixpreis", "Fixed price")
                    </span>
                    <span class="inline-block border-2 border-white text-white font-semibold text-sm px-4 py-1.5 rounded-full">
                        @T("7 Tage / Woche", "7 days / week")
                    </span>
                    <span class="inline-block bg-cleaning-green text-white font-semibold text-sm px-4 py-1.5 rounded-full">
                        @T("Hotel-Standard", "Hotel standard")
                    </span>
                </div>

                <!-- H1 -->
                <h1 class="text-2xl md:text-4xl font-bold text-white mb-3 leading-tight">
                    @T("Airbnb Reinigung Zürich — Turnover-Reinigung zum Fixpreis", "Airbnb Cleaning Zurich — Turnover Cleaning at a Fixed Price")
                </h1>

                <!-- Subheading -->
                <p class="text-base md:text-lg text-white/80 mb-4 max-w-2xl">
                    @T("Hotel-Standard Reinigung für Airbnb, Booking.com, VRBO und Ferienwohnungen in Zürich, Zug, Aargau und Umgebung. Pünktlich, gründlich, check-in ready — damit Ihre Gäste 5 Sterne vergeben.", "Hotel-standard cleaning for Airbnb, Booking.com, VRBO and holiday flats in Zurich, Zug, Aargau and the surrounding area. Punctual, thorough, check-in ready — so your guests give you 5 stars.")
                </p>

                <!-- Checkmarks -->
                <div class="space-y-1.5 mb-5">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-cleaning-green flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span class="text-white text-base md:text-lg">@T("Fixpreis pro Reinigung — keine versteckten Kosten", "Fixed price per clean — no hidden costs")</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-cleaning-green flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span class="text-white text-base md:text-lg">@T("Bettwäsche, Handtücher, Müll — alles erledigt", "Bed linen, towels, rubbish — all taken care of")</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-cleaning-green flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span class="text-white text-base md:text-lg">@T("Haftpflichtversichert mit 5 Mio. CHF Deckung", "Liability insured with CHF 5 million cover")</span>
                    </div>
                </div>

                <!-- CTAs -->
                <div class="flex flex-col sm:flex-row gap-4 mb-8 items-start">
                    <a href="#pricing" class="inline-flex items-center justify-center text-lg px-8 h-12 rounded-lg bg-booking-orange text-white font-semibold hover:bg-booking-orange-dark transition-colors shadow-button">
                        @T("Angebot und Preise", "Packages and prices")
                    </a>
                    <a href="#service-area" class="inline-flex items-center justify-center text-lg px-6 h-12 rounded-lg border-2 border-white text-swiss-blue bg-white hover:bg-white/90 font-semibold transition-colors gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        @T("Einsatzgebiet prüfen", "Check service area")
                    </a>
                </div>

                <!-- Google review bar -->
                <div class="border-t border-white/20 pt-6">
                    <a href="https://share.google/f60Gr7soQQux5lExT" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 hover:opacity-80 transition-opacity">
                        <svg class="w-5 h-5 text-trust-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        <svg class="w-5 h-5 text-trust-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        <svg class="w-5 h-5 text-trust-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        <svg class="w-5 h-5 text-trust-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        <svg class="w-5 h-5 text-trust-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        <span class="text-white/80 text-sm ml-2">@T("5/5 Bewertung auf Google", "5/5 rating on Google")</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- TL;DR -->
    <section class="py-6 bg-gradient-to-b from-primary/5 to-transparent border-b border-border/40">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="rounded-xl border border-primary/20 bg-white/60 backdrop-blur p-5 md:p-6">
                <div class="flex items-center gap-2 mb-3">
                    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
                    <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-primary">@T("Kurz erklärt", "In a nutshell")</span>
                </div>
                <p class="text-sm md:text-[15px] text-foreground/80 leading-relaxed mb-4">@Html.Raw(T("<strong>Airbnb Reinigung in Zürich</strong> zwischen Gästewechseln zum transparenten Fixpreis. Hotel-Standard-Turnover für Airbnb, Booking.com, VRBO und Ferienwohnungen — pünktlich, gründlich, check-in ready.", "<strong>Airbnb cleaning in Zurich</strong> between guest changeovers at a transparent fixed price. Hotel-standard turnovers for Airbnb, Booking.com, VRBO and holiday flats — punctual, thorough, check-in ready."))</p>
                <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-6 gap-y-2 text-sm text-foreground/80">
                    <li class="flex items-start gap-2"><span class="text-primary mt-0.5">✓</span><span>@T("Fixpreise pro Reinigung ab CHF 89 (Express) bis CHF 389 (Full Service)", "Fixed prices per clean from CHF 89 (Express) to CHF 389 (Full Service)")</span></li>
                    <li class="flex items-start gap-2"><span class="text-primary mt-0.5">✓</span><span>@T("Bettwäsche, Handtücher, Müll und Verbrauchsmaterial inklusive", "Bed linen, towels, rubbish and consumables included")</span></li>
                    <li class="flex items-start gap-2"><span class="text-primary mt-0.5">✓</span><span>@T("Versichert mit 5 Mio. CHF Haftpflichtdeckung", "Insured with CHF 5 million liability cover")</span></li>
                </ul>
            </div>
        </div>
    </section>

    <!-- 2. Pain Points Section -->
    <section class="py-16 md:py-24 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl md:text-4xl font-bold text-center text-foreground mb-12">
                @T("Kennen Sie das?", "Sound familiar?")
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Tight Turnover -->
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-8 text-center border-border">
                    <div class="flex justify-center mb-4">
                        <svg class="w-10 h-10 text-swiss-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    </div>
                    <h3 class="text-xl font-bold text-foreground mb-3">@T("Knappe Turnover-Zeit", "Tight turnover window")</h3>
                    <p class="text-muted-foreground">@T("Check-out um 11, Check-in um 15 Uhr — und dazwischen muss die Wohnung makellos sein. Stress pur.", "Check-out at 11:00, check-in at 15:00 — and in between, the flat has to be spotless. Pure stress.")</p>
                </div>
                <!-- Inconsistent Quality -->
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-8 text-center border-border">
                    <div class="flex justify-center mb-4">
                        <div class="relative w-10 h-10 flex items-center justify-center">
                            <svg class="w-10 h-10 text-swiss-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-swiss-blue"><line x1="3" y1="3" x2="21" y2="21"/></svg>
                            </div>
                        </div>
                    </div>
                    <h3 class="text-xl font-bold text-foreground mb-3">@T("Inkonsistente Qualität", "Inconsistent quality")</h3>
                    <p class="text-muted-foreground">@T("Mal gut, mal nicht. Jeder vergessene Fleck kostet Sie eine Stern-Bewertung — und zukünftige Buchungen.", "Sometimes good, sometimes not. Every missed spot costs you a star in your reviews — and future bookings.")</p>
                </div>
                <!-- Endless Coordination -->
