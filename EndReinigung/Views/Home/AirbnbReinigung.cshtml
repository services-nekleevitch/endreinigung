@using System.Globalization
@{
    var isEn = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    string T(string de, string en) => isEn ? en : de;
    Microsoft.AspNetCore.Html.HtmlString J(string s) => new(System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping.Encode(s));
    Microsoft.AspNetCore.Html.HtmlString JT(string de, string en) => J(T(de, en));

    var pageUrl = T("https://zurich-endreinigung.ch/airbnb-reinigung-zuerich", "https://zurich-endreinigung.ch/en/airbnb-cleaning-zurich");
    var homeUrl = T("https://zurich-endreinigung.ch/", "https://zurich-endreinigung.ch/en");

    ViewData["Title"] = T("Airbnb Reinigung Zürich ✓ Fixpreis pro Turnover, Same-Day", "Airbnb Cleaning Zurich ✓ Fixed Turnover Prices, Same-Day");
    ViewData["Description"] = T("Zuverlässige Airbnb Reinigung in Zürich zwischen Gästewechseln. Für Top-Bewertungen und zufriedene Gäste. Flexible Zeiten, faire Preise.", "Reliable Airbnb cleaning in Zurich between guest turnovers. Flexible scheduling, fair prices and hotel-standard cleaning for expat hosts.");
    ViewData["Canonical"] = pageUrl;
    ViewData["Keywords"] = T("Airbnb Reinigung Zürich, Ferienwohnung Reinigung, Gästewechsel Reinigung, Airbnb Putzdienst", "Airbnb cleaning Zurich, vacation rental cleaning, guest turnover cleaning");

    // FAQ copy is shared by the visible accordion and the FAQPage JSON-LD so both always match.
    var faqs = new[]
    {
        (Q: T("Wie kurzfristig kann ich eine Reinigung buchen?", "How short-notice can I book a clean?"),
         A: T("Bei regelmässigen Kunden stimmen wir den Reinigungsplan fest auf Ihre Buchungen ab. Kurzfristige Einzelbuchungen sind in der Regel innerhalb von 24-48 Stunden möglich. Same-Day-Einsätze auf Anfrage.", "For regular clients, we set a fixed cleaning schedule aligned with your bookings. Short-notice one-off bookings are usually possible within 24-48 hours. Same-day jobs on request.")),
        (Q: T("Was passiert, wenn der Gast erst am gleichen Tag auscheckt?", "What happens if the guest only checks out on the same day?"),
         A: T("Kein Problem. Wir planen genügend Puffer ein und können flexibel reagieren. Informieren Sie uns einfach per WhatsApp über Änderungen — wir passen den Einsatz entsprechend an.", "No problem. We plan in enough buffer time and can react flexibly. Just let us know about any changes via WhatsApp — we'll adjust the job accordingly.")),
        (Q: T("Stellen Sie die Reinigungsmittel?", "Do you provide the cleaning products?"),
         A: T("Ja. Wir bringen alle professionellen Reinigungsmittel und Geräte mit. Sie müssen nichts bereitstellen. Falls Sie bestimmte Produkte bevorzugen (z.B. ökologische Mittel), verwenden wir gerne diese.", "Yes. We bring all professional cleaning products and equipment with us. You don't need to provide anything. If you prefer specific products (e.g. eco-friendly ones), we're happy to use them.")),
        (Q: T("Kann ich den Reinigungsplan ändern, wenn meine Buchungslage schwankt?", "Can I change the cleaning schedule if my bookings fluctuate?"),
         A: T("Natürlich. Wir sind flexibel. Sagen Sie uns einfach Bescheid, wenn sich Ihre Buchungen ändern — wir passen den Plan laufend an. Bei Abo-Kunden berechnen wir nur die tatsächlich durchgeführten Reinigungen.", "Of course. We're flexible. Just let us know when your bookings change — we adjust the schedule on an ongoing basis. For subscription clients, we only charge for the cleans actually carried out.")),
        (Q: T("Bieten Sie auch Wäscheservice an?", "Do you also offer a laundry service?"),
         A: T("Im Turnover- und Full-Service-Paket ist das Waschen und Trocknen der Bettwäsche und Handtücher vor Ort inklusive. Falls Sie einen separaten Abholservice für grössere Mengen benötigen, bieten wir das als Zusatzleistung an.", "The Turnover and Full Service packages include washing and drying the bed linen and towels on site. If you need a separate collection service for larger quantities, we offer this as an add-on service.")),
        (Q: T("Wie funktioniert die Schlüsselübergabe?", "How does the key handover work?"),
         A: T("Wir arbeiten mit Lockboxen, Schlüsseltresoren oder persönlicher Übergabe — ganz wie es für Ihr Objekt am besten passt. Im Full-Service-Paket übernehmen wir das komplette Schlüsselmanagement.", "We work with lockboxes, key safes or in-person handover — whatever suits your property best. With the Full Service package, we take care of the complete key management.")),
        (Q: T("Kann ich die Reinigungskosten als Reinigungsgebühr an Gäste weitergeben?", "Can I pass the cleaning costs on to guests as a cleaning fee?"),
         A: T("Ja, die meisten Hosts verrechnen unsere Fixpreise direkt als Reinigungsgebühr auf Airbnb. Unsere transparenten Preise machen das einfach — Sie wissen genau, was Sie pro Reinigung zahlen und was Sie dem Gast berechnen.", "Yes, most hosts charge our fixed prices directly as the cleaning fee on Airbnb. Our transparent prices make this easy — you know exactly what you pay per clean and what you charge the guest.")),
        (Q: T("Reinigen Sie auch andere Kurzzeitvermietungen (Booking.com, VRBO)?", "Do you also clean other short-term rentals (Booking.com, VRBO)?"),
         A: T("Ja. Unser Service funktioniert für jede Art von Kurzzeitvermietung — Airbnb, Booking.com, VRBO, oder privat vermietete Ferienwohnungen. Der Ablauf ist identisch.", "Yes. Our service works for any type of short-term rental — Airbnb, Booking.com, VRBO, or privately let holiday flats. The process is identical."))
    };
}

@section Head {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "@JT("Start", "Home")", "item": "@homeUrl" },
            { "@@type": "ListItem", "position": 2, "name": "@JT("Airbnb Reinigung", "Airbnb Cleaning")", "item": "@pageUrl" }
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Service",
        "@@id": "@pageUrl#service",
        "url": "@pageUrl",
        "inLanguage": "@T("de-CH", "en")",
        "serviceType": "@JT("Airbnb Reinigung", "Airbnb Cleaning")",
        "name": "@JT("Airbnb Reinigung Zürich – Fixpreise", "Airbnb Cleaning Zurich – Fixed Prices")",
        "provider": { "@@id": "https://zurich-endreinigung.ch/#business" },
        "areaServed": { "@@type": "State", "name": "@JT("Kanton Zürich", "Canton of Zurich")" },
        "offers": {
            "@@type": "AggregateOffer",
            "priceCurrency": "CHF",
            "lowPrice": 89,
            "highPrice": 389,
            "offerCount": 8,
            "offers": [
                { "@@type": "Offer", "name": "@JT("Express – Studio/1 Zi", "Express – Studio/1 room")", "price": 89, "priceCurrency": "CHF", "availability": "https://schema.org/InStock", "url": "@pageUrl" },
                { "@@type": "Offer", "name": "@JT("Express – 2 Zi", "Express – 2 rooms")", "price": 119, "priceCurrency": "CHF", "availability": "https://schema.org/InStock", "url": "@pageUrl" },
                { "@@type": "Offer", "name": "@JT("Express – 3 Zi", "Express – 3 rooms")", "price": 149, "priceCurrency": "CHF", "availability": "https://schema.org/InStock", "url": "@pageUrl" },
                { "@@type": "Offer", "name": "@JT("Turnover – Studio/1 Zi", "Turnover – Studio/1 room")", "price": 129, "priceCurrency": "CHF", "availability": "https://schema.org/InStock", "url": "@pageUrl" },
                { "@@type": "Offer", "name": "@JT("Turnover – 2 Zi", "Turnover – 2 rooms")", "price": 159, "priceCurrency": "CHF", "availability": "https://schema.org/InStock", "url": "@pageUrl" },
                { "@@type": "Offer", "name": "@JT("Turnover – 3 Zi", "Turnover – 3 rooms")", "price": 199, "priceCurrency": "CHF", "availability": "https://schema.org/InStock", "url": "@pageUrl" },
                { "@@type": "Offer", "name": "@JT("Full Service – Studio/1 Zi", "Full Service – Studio/1 room")", "price": 199, "priceCurrency": "CHF", "availability": "https://schema.org/InStock", "url": "@pageUrl" },
                { "@@type": "Offer", "name": "@JT("Full Service – 3 Zi", "Full Service – 3 rooms")", "price": 389, "priceCurrency": "CHF", "availability": "https://schema.org/InStock", "url": "@pageUrl" }
            ]
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "inLanguage": "@T("de-CH", "en")",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "@J(faqs[0].Q)",
                "acceptedAnswer": { "@@type": "Answer", "text": "@J(faqs[0].A)" }
            },
            {
                "@@type": "Question",
                "name": "@J(faqs[1].Q)",
                "acceptedAnswer": { "@@type": "Answer", "text": "@J(faqs[1].A)" }
            },
            {
                "@@type": "Question",
                "name": "@J(faqs[2].Q)",
                "acceptedAnswer": { "@@type": "Answer", "text": "@J(faqs[2].A)" }
            },
            {
                "@@type": "Question",
                "name": "@J(faqs[3].Q)",
                "acceptedAnswer": { "@@type": "Answer", "text": "@J(faqs[3].A)" }
            },
            {
                "@@type": "Question",
                "name": "@J(faqs[4].Q)",
                "acceptedAnswer": { "@@type": "Answer", "text": "@J(faqs[4].A)" }
            },
            {
                "@@type": "Question",
                "name": "@J(faqs[5].Q)",
                "acceptedAnswer": { "@@type": "Answer", "text": "@J(faqs[5].A)" }
            },
            {
                "@@type": "Question",
                "name": "@J(faqs[6].Q)",
                "acceptedAnswer": { "@@type": "Answer", "text": "@J(faqs[6].A)" }
            },
            {
                "@@type": "Question",
                "name": "@J(faqs[7].Q)",
                "acceptedAnswer": { "@@type": "Answer", "text": "@J(faqs[7].A)" }
            }
        ]
