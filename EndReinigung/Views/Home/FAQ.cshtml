@{
    ViewData["Title"] = "Endreinigung Zürich FAQ ✓ Fixpreise, Abnahme, Garantie";
    ViewData["Description"] = "Antworten auf die wichtigsten Fragen zu Endreinigung, Kosten, Abnahmegarantie, Wohnungsübergabe und Umzugsreinigung in Zürich.";
    ViewData["Canonical"] = "https://zurich-endreinigung.ch/faq";
    ViewData["Keywords"] = "Endreinigung FAQ, Umzugsreinigung Fragen, Abnahmegarantie FAQ, Endreinigung Kosten Zürich";
}

@section Head {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "inLanguage": "de-CH",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "Wie viel kostet eine Endreinigung in Zürich?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Eine professionelle Endreinigung in Zürich kostet bei uns CHF 550 für 1–1.5 Zimmer, CHF 650 für 2–2.5 Zimmer und CHF 850 für 3–3.5 Zimmer. Der Fixpreis umfasst die vereinbarten Leistungen inklusive 100% Abnahmegarantie, und wir sind persönlich bei der Wohnungsübergabe vor Ort."
                }
            },
            {
                "@@type": "Question",
                "name": "Ist die Abnahmegarantie wirklich sicher?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Unsere 100% Abnahmegarantie gilt für die Reinigungsleistung: Reinigungsbezogene Beanstandungen beheben wir kostenlos und wenn möglich direkt bei der Übergabe. Die Garantie bezieht sich nicht auf Schäden oder andere mietrechtliche Themen."
                }
            },
            {
                "@@type": "Question",
                "name": "Wie kurzfristig kann ich einen Termin buchen?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Kurzfristige Termine sind je nach Auslastung möglich. Für Ihren Wunschtermin empfehlen wir eine möglichst frühe Buchung, besonders zum Monatsende."
                }
            },
            {
                "@@type": "Question",
                "name": "Mein Objekt ist nicht gelistet — was nun?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Auch für besondere Objekte erstellen wir gerne eine individuelle Offerte. Senden Sie uns die wichtigsten Angaben und Fotos über das Anfrageformular oder kontaktieren Sie uns per E-Mail oder Telefon."
                }
            }
        ]
    }
    </script>
}

<div class="pt-16 md:pt-[6.25rem]">
    @await Html.PartialAsync("_LP2FAQ")
</div>

@await Html.PartialAsync("~/Views/Shared/_Footer.cshtml")
