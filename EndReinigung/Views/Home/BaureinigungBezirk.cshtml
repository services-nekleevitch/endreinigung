@section Scripts {
    <script>
        (function () {
            const tabs = document.querySelectorAll('[data-bezirk-tabs] [data-tab]');
            const panels = document.querySelectorAll('[data-bezirk-pricing]');
            const activeWohnung = ['bg-primary', 'text-primary-foreground'];
            const activeHaus = ['bg-booking-orange', 'text-white'];
            const activeGewerbe = ['bg-muted-foreground', 'text-white'];
            const inactive = ['border', 'border-border', 'bg-background', 'text-foreground'];

            function setTab(name) {
                tabs.forEach(b => {
                    const isActive = b.getAttribute('data-tab') === name;
                    b.classList.remove(...activeWohnung, ...activeHaus, ...activeGewerbe, ...inactive, 'hover:bg-muted', 'hover:bg-booking-orange-dark');
                    if (isActive) {
                        if (name === 'wohnung') b.classList.add(...activeWohnung);
                        else if (name === 'haus') b.classList.add(...activeHaus);
                        else b.classList.add(...activeGewerbe);
                    } else {
                        b.classList.add(...inactive, 'hover:bg-muted');
                    }
                });
                panels.forEach(p => {
                    const show = p.getAttribute('data-bezirk-pricing') === name;
                    p.classList.toggle('hidden', !show);
                    p.classList.toggle('grid', show);
                });
            }

            tabs.forEach(b => b.addEventListener('click', () => setTab(b.getAttribute('data-tab'))));
        })();
    </script>
}
