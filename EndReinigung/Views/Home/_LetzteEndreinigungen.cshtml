@using System.Globalization
@{
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var gallery = new[] {
        new {
            Img = "/img/projects/wohnkueche.jpg",
            Alt = "Umzugsreinigung 5.5 Zimmer Wohnung Wollishofen",
            CaptionDe = "Umzugsreinigung 5.5 Zimmer Wohnung in Wollishofen, ZH. Erfolgreiche Wohnungsabgabe; Kaution ohne Abzüge zurückerhalten.",
            CaptionEn = "Move-out cleaning 5.5-room apartment in Wollishofen, ZH. Successful handover; deposit returned in full."
        },
        new {
            Img = "/img/projects/kueche.jpg",
            Alt = "Endreinigung 3.5 Zimmer Wohnung Oerlikon",
            CaptionDe = "Endreinigung 3.5 Zimmer Wohnung in Oerlikon, Zürich. Kaution erfolgreich zurückerhalten.",
            CaptionEn = "End-of-lease cleaning 3.5-room apartment in Oerlikon, Zürich. Deposit successfully returned."
        },
        new {
            Img = "/img/projects/wohnzimmer.jpg",
            Alt = "Endreinigung 4.5 Zimmer Wohnung Altstetten",
            CaptionDe = "Endreinigung 4.5 Zimmer Wohnung in Altstetten, Zürich. Kaution erfolgreich zurückerhalten.",
            CaptionEn = "End-of-lease cleaning 4.5-room apartment in Altstetten, Zürich. Deposit successfully returned."
        },
        new {
            Img = "/img/projects/bad-dusche.jpg",
            Alt = "Endreinigung 2.5 Zimmer Wohnung Wiedikon",
            CaptionDe = "Endreinigung 2.5 Zimmer Wohnung in Wiedikon, Zürich. Kaution erfolgreich zurückerhalten.",
            CaptionEn = "End-of-lease cleaning 2.5-room apartment in Wiedikon, Zürich. Deposit successfully returned."
        },
        new {
            Img = "/img/projects/bad-wanne.jpg",
            Alt = "Endreinigung 3.5 Zimmer Wohnung Seefeld",
            CaptionDe = "Endreinigung 3.5 Zimmer Wohnung in Seefeld, Zürich. Kaution erfolgreich zurückerhalten.",
            CaptionEn = "End-of-lease cleaning 3.5-room apartment in Seefeld, Zürich. Deposit successfully returned."
        },
        new {
            Img = "/img/projects/balkon.jpg",
            Alt = "Endreinigung 4.5 Zimmer Wohnung Höngg",
            CaptionDe = "Endreinigung 4.5 Zimmer Wohnung in Höngg, Zürich. Kaution erfolgreich zurückerhalten.",
            CaptionEn = "End-of-lease cleaning 4.5-room apartment in Höngg, Zürich. Deposit successfully returned."
        }
    };
}
<!-- Letzte Endreinigungen Gallery -->
<section id="galerie" class="py-12 md:py-24 bg-gradient-to-b from-secondary to-background scroll-mt-16 md:scroll-mt-[6.25rem]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8 md:mb-12">
            <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-foreground mb-4">
                @SharedLocalizer["gallery.title_1"] <span class="text-primary">@SharedLocalizer["gallery.title_2"]</span>
            </h2>
            <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto">
                @SharedLocalizer["gallery.subtitle"]
            </p>
        </div>

        <div id="gallery-carousel" class="relative">
            <div class="overflow-hidden">
                <div class="carousel-track flex" id="gallery-track">
                    @foreach (var item in gallery) {
                        <div class="carousel-slide third px-2 flex-shrink-0">
                            <div class="bg-card border border-border rounded-xl overflow-hidden h-full flex flex-col">
                                <div class="aspect-[4/3] overflow-hidden">
                                    <img src="@item.Img" alt="@item.Alt" class="w-full h-full object-cover" loading="lazy" />
                                </div>
                                <div class="p-3 sm:p-4 flex-1">
                                    <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">@(lang == "en" ? item.CaptionEn : item.CaptionDe)</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <!-- Prev / Next -->
            <button class="carousel-prev absolute top-[40%] -translate-y-1/2 left-1 sm:-left-4 lg:-left-10 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-white border border-border shadow flex items-center justify-center hover:bg-muted transition-colors z-10" aria-label="Previous">
                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-foreground" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="carousel-next absolute top-[40%] -translate-y-1/2 right-1 sm:-right-4 lg:-right-10 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-white border border-border shadow flex items-center justify-center hover:bg-muted transition-colors z-10" aria-label="Next">
                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-foreground" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <!-- Dots -->
            <div class="flex justify-center gap-2 mt-6" id="gallery-dots"></div>
        </div>
    </div>
</section>
