<!-- FAQ Section -->
<section class="py-20" style="background: linear-gradient(180deg, hsl(210 10% 96%) 0%, hsl(210 10% 93%) 60%, hsl(0 0% 100%) 100%)">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-swiss-blue mb-4">@SharedLocalizer["faq.title_1"] <span class="text-booking-orange">@SharedLocalizer["faq.title_2"]</span></h2>
            <p class="text-xl text-swiss-blue/70">@SharedLocalizer["faq.subtitle"]</p>
        </div>

        <div class="space-y-4">
            @{
                var faqs = new[] {
                    new { Q = "Wie viel kostet eine Endreinigung in Zürich?", A = "Eine professionelle Endreinigung in Zürich kostet bei uns CHF 550 für 1–1.5 Zimmer, CHF 650 für 2–2.5 Zimmer und CHF 850 für 3–3.5 Zimmer. Der Fixpreis umfasst die vereinbarten Leistungen inklusive 100% Abnahmegarantie, und wir sind persönlich bei der Wohnungsübergabe vor Ort." },
                    new { Q = "Ist die Abnahmegarantie wirklich sicher?", A = "Unsere 100% Abnahmegarantie gilt für die Reinigungsleistung: Reinigungsbezogene Beanstandungen beheben wir kostenlos und wenn möglich direkt bei der Übergabe. Die Garantie bezieht sich nicht auf Schäden oder andere mietrechtliche Themen." },
                    new { Q = "Muss ich bei der Wohnungsübergabe dabei sein?", A = "Wir sind bei der Wohnungsübergabe persönlich vor Ort und begleiten die Reinigungsabnahme. Ob Sie selbst anwesend sein müssen, hängt von Ihrer Vereinbarung mit Vermieter oder Verwaltung ab." },
                    new { Q = "Wie kurzfristig kann ich einen Termin buchen?", A = "Kurzfristige Termine sind je nach Auslastung möglich. Für Ihren Wunschtermin empfehlen wir eine möglichst frühe Buchung, besonders zum Monatsende." },
                    new { Q = "Was passiert, wenn der Vermieter nicht zufrieden ist?", A = "Bei reinigungsbezogenen Beanstandungen bessern wir im Rahmen unserer Abnahmegarantie kostenlos nach. Wenn möglich, erledigen wir die Nachbesserung direkt während der Wohnungsübergabe." },
                    new { Q = "Sind Sie versichert?", A = "Ja, Zürich Endreinigung verfügt über eine Betriebshaftpflichtversicherung mit einer Deckungssumme von CHF 5 Millionen. Versicherungsschutz und Leistungen gelten gemäss den Bedingungen der Versicherungspolice." },
                    new { Q = "Was ist der Unterschied zwischen Endreinigung und Zügelreinigung?", A = "Endreinigung, Zügelreinigung und Schlussreinigung werden in der Deutschschweiz meist für dieselbe Dienstleistung verwendet: die gründliche Reinigung einer Wohnung vor der Rückgabe. Ziel ist eine reibungslose Reinigungsabnahme durch Vermieter oder Verwaltung." },
                    new { Q = "Wie bekomme ich meine Kaution sicher zurück?", A = "Eine professionelle Endreinigung kann helfen, reinigungsbedingte Abzüge von der Mietkaution zu vermeiden. Die vollständige Rückzahlung der Kaution können wir nicht garantieren, da auch Schäden, offene Forderungen oder andere Faktoren eine Rolle spielen können." },
                    new { Q = "Arbeiten Sie auch in meinem Zürcher Quartier?", A = "Wir führen Endreinigungen in der Stadt Zürich und im gesamten Kanton Zürich durch. Ob Ihr Standort verfügbar ist, können Sie direkt über die Postleitzahl im Preisrechner prüfen." },
                    new { Q = "Mein Objekt ist nicht gelistet — was nun?", A = "Auch für besondere Objekte erstellen wir gerne eine individuelle Offerte. Senden Sie uns die wichtigsten Angaben und Fotos über das Anfrageformular oder kontaktieren Sie uns per E-Mail oder Telefon." },
                    new { Q = "Sprechen Sie Englisch — sind Sie Expat-freundlich?", A = "Ja, wir betreuen Kundinnen und Kunden auf Deutsch und Englisch. Auf Wunsch können wir die gesamte Kommunikation zur Endreinigung und Wohnungsübergabe auf Englisch führen." },
                    new { Q = "Sind Storen im Fixpreis enthalten und was ist mit der Zugänglichkeit?", A = "Die Reinigung zugänglicher Storen oder Rollläden ist bei unseren Standard-Endreinigungen im vereinbarten Fixpreis enthalten. Stark verwitterte, beschädigte oder nicht erreichbare Elemente können nur im technisch möglichen Umfang gereinigt werden." },
                    new { Q = "Muss die Wohnung für die Endreinigung leer und zugänglich sein?", A = "Ja, die Wohnung sollte für die Endreinigung vollständig geräumt und frei zugänglich sein. Möbel, Abfälle und schwere Gegenstände müssen vorher entfernt werden, damit alle vereinbarten Flächen gereinigt werden können." },
                    new { Q = "Sind Teppiche im Fixpreis enthalten?", A = "Normales Staubsaugen von Teppichen ist im Standardumfang enthalten. Eine Tiefenreinigung oder Sprühextraktion von Teppichen ist eine separate Zusatzleistung und kann auf Wunsch angeboten werden." },
                    new { Q = "Muss Wasser und Strom verfügbar sein?", A = "Ja, für eine professionelle Endreinigung müssen fliessendes Wasser, Strom und eine ausreichende Beleuchtung in der Wohnung verfügbar sein. Besonders in den Monaten mit kürzerem Tageslicht ist funktionierende Innenbeleuchtung wichtig, damit alle Flächen sorgfältig kontrolliert und fachgerecht gereinigt werden können." },
                    new { Q = "Muss der Kühlschrank vorbereitet werden?", A = "Kühlschrank und Gefrierfach sollten mindestens 24 Stunden vor der Reinigung ausgeschaltet und vollständig abgetaut sein. So können Innenflächen und Gefrierfach gründlich und sicher gereinigt werden." },
                    new { Q = "Entfernen Sie Schimmel in Silikonfugen?", A = "Oberflächliche Verschmutzungen und oberflächlicher Schimmel werden im Rahmen der Reinigung behandelt. Tief sitzender Schimmel oder dauerhaft verfärbtes Silikon kann eine Erneuerung der Fuge erfordern und ist keine Reinigungsleistung." },
                    new { Q = "Entsorgen Sie Müll oder alte Möbel?", A = "Die Entsorgung von Möbeln, Sperrgut oder grösseren Abfallmengen gehört nicht zur normalen Endreinigung. Eine separate Entsorgung kann je nach Auftrag und Verfügbarkeit individuell organisiert werden." },
                    new { Q = "Was passiert, wenn die Wohnung nicht leer oder zugänglich ist?", A = "Ist die Wohnung zum vereinbarten Reinigungsbeginn nicht vollständig geräumt oder zugänglich, kann sich der Aufwand erhöhen oder der Termin verschieben. Zusätzlicher Aufwand wird vor der Durchführung mit Ihnen abgestimmt." },
                    new { Q = "Was ist der rechtliche Unterschied zwischen «besenrein» und «grundgereinigt»?", A = "«Besenrein» bedeutet in der Regel eine einfache Grobreinigung, während eine Grundreinigung deutlich gründlicher ist und beispielsweise Küche, Bad, Fenster und Oberflächen umfasst. Welche Reinigung bei der Wohnungsrückgabe verlangt wird, richtet sich nach Mietvertrag und Vorgaben der Verwaltung." }
                };
                // English version for /en (same order and meaning as the German list above — keep both in sync).
                if (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en")
                {
                    faqs = new[] {
                        new { Q = "How much does end-of-lease cleaning in Zurich cost?", A = "Professional end-of-lease cleaning in Zurich costs CHF 550 for 1–1.5 rooms, CHF 650 for 2–2.5 rooms and CHF 850 for 3–3.5 rooms. The fixed price covers the agreed services including our 100% handover guarantee, and we attend the apartment handover in person." },
                        new { Q = "Is the handover guarantee really reliable?", A = "Our 100% handover guarantee applies to the cleaning work: we fix cleaning-related complaints free of charge and, where possible, right at the handover. The guarantee does not cover damage or other tenancy-law matters." },
                        new { Q = "Do I have to be present at the apartment handover?", A = "We attend the apartment handover in person and accompany the cleaning inspection. Whether you need to be there yourself depends on your arrangement with the landlord or property management." },
                        new { Q = "How short-notice can I book an appointment?", A = "Short-notice appointments are possible depending on availability. To get your preferred date, we recommend booking as early as possible, especially for the end of the month." },
                        new { Q = "What happens if the landlord is not satisfied?", A = "For cleaning-related complaints we re-clean free of charge under our handover guarantee. Where possible, we do the touch-ups right during the apartment handover." },
                        new { Q = "Are you insured?", A = "Yes, Zürich Endreinigung has business liability insurance with cover of CHF 5 million. Insurance cover and benefits apply according to the terms of the insurance policy." },
                        new { Q = "What is the difference between Endreinigung and Zügelreinigung?", A = "In German-speaking Switzerland, Endreinigung, Zügelreinigung and Schlussreinigung usually mean the same service: the thorough cleaning of an apartment before it is handed back. The aim is a smooth cleaning inspection by the landlord or property management." },
                        new { Q = "How do I get my deposit back safely?", A = "Professional end-of-lease cleaning can help you avoid cleaning-related deductions from your rental deposit. We cannot guarantee that the deposit is repaid in full, because damage, outstanding claims or other factors can also play a role." },
                        new { Q = "Do you also work in my part of Zurich?", A = "We carry out end-of-lease cleaning in the city of Zurich and throughout the Canton of Zurich. You can check whether your location is covered directly by entering your postcode in the price calculator." },
                        new { Q = "My property isn't listed — what now?", A = "We're happy to prepare an individual quote for special properties too. Send us the key details and photos via the enquiry form, or contact us by email or phone." },
                        new { Q = "Do you speak English — are you expat-friendly?", A = "Yes, we look after our customers in German and English. On request, we can handle all communication about the end-of-lease cleaning and the apartment handover in English." },
                        new { Q = "Are blinds included in the fixed price, and what about accessibility?", A = "Cleaning accessible blinds or roller shutters is included in the agreed fixed price for our standard end-of-lease cleaning. Heavily weathered, damaged or unreachable parts can only be cleaned as far as technically possible." },
                        new { Q = "Does the apartment have to be empty and accessible for the cleaning?", A = "Yes, the apartment should be completely cleared and freely accessible for the end-of-lease cleaning. Furniture, rubbish and heavy items must be removed beforehand so that all agreed areas can be cleaned." },
                        new { Q = "Is carpet cleaning included in the fixed price?", A = "Normal vacuuming of carpets is included in the standard scope. Deep cleaning or spray extraction of carpets is a separate extra service and can be offered on request." },
                        new { Q = "Do water and electricity need to be available?", A = "Yes, professional end-of-lease cleaning needs running water, electricity and adequate lighting in the apartment. Especially in the months with less daylight, working indoor lighting is important so that all surfaces can be checked carefully and cleaned properly." },
                        new { Q = "Does the fridge need to be prepared?", A = "The fridge and freezer compartment should be switched off and fully defrosted at least 24 hours before the cleaning. That way the inside surfaces and the freezer compartment can be cleaned thoroughly and safely." },
                        new { Q = "Do you remove mould from silicone joints?", A = "Surface dirt and surface mould are treated as part of the cleaning. Deep-seated mould or permanently discoloured silicone may require the joint to be renewed, which is not a cleaning service." },
                        new { Q = "Do you dispose of rubbish or old furniture?", A = "Disposing of furniture, bulky waste or larger amounts of rubbish is not part of a normal end-of-lease cleaning. Separate disposal can be arranged individually depending on the job and availability." },
                        new { Q = "What happens if the apartment is not empty or accessible?", A = "If the apartment is not completely cleared or accessible at the agreed start of the cleaning, the effort may increase or the appointment may have to be moved. Any extra effort is agreed with you before the work is done." },
                        new { Q = "What is the legal difference between «besenrein» (broom-clean) and «grundgereinigt» (deep-cleaned)?", A = "«Besenrein» usually means a simple rough clean, while a deep clean is much more thorough and covers, for example, the kitchen, bathroom, windows and surfaces. Which cleaning is required when you hand back the apartment depends on your tenancy agreement and the property management's requirements." }
                    };
                }
            }
            @foreach (var faq in faqs) {
                <div class="faq-item bg-swiss-blue rounded-xl px-6 shadow-sm hover:bg-white group transition-colors duration-300">
                    <button type="button" class="faq-trigger w-full flex items-center justify-between text-left font-semibold text-white group-hover:text-gray-700 py-5 transition-colors duration-300">
                        <span>@faq.Q</span>
                        <svg class="faq-chevron w-5 h-5 flex-shrink-0 ml-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="faq-answer text-gray-600 font-medium pb-0">
                        <div class="pb-5">@Html.Raw(faq.A)</div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-12 text-center">
            <p class="text-swiss-blue/70 mb-4">@SharedLocalizer["faq.more_questions"]</p>
            <a href="tel:+41765017738" class="inline-flex items-center text-orange-600 font-semibold hover:text-orange-700">
                @SharedLocalizer["faq.call_us"]
            </a>
        </div>
    </div>
</section>
