@section Scripts {
    <script>
        (function () {
            const buttons = document.querySelectorAll('[data-bau-type]');
            const panels = document.querySelectorAll('[data-bau-panel]');
            const activeWohnung = ['bg-primary', 'text-primary-foreground'];
            const activeHaus = ['bg-booking-orange', 'text-white'];
            const activeGewerbe = ['bg-muted-foreground', 'text-white'];
            const inactive = ['border-2', 'border-border', 'bg-card', 'text-foreground'];

            function setType(type) {
                buttons.forEach(b => {
                    const isActive = b.getAttribute('data-bau-type') === type;
                    b.classList.remove(...activeWohnung, ...activeHaus, ...activeGewerbe, ...inactive);
                    if (isActive) {
                        if (type === 'wohnung') b.classList.add(...activeWohnung);
                        else if (type === 'haus') b.classList.add(...activeHaus);
                        else b.classList.add(...activeGewerbe);
                    } else {
                        b.classList.add(...inactive);
                    }
                });
                panels.forEach(p => {
                    const match = p.getAttribute('data-bau-panel') === type;
                    p.classList.toggle('hidden', !match);
                    if (match && type !== 'gewerbe') p.classList.add('grid');
                    else p.classList.remove('grid');
                });
            }

            buttons.forEach(b => b.addEventListener('click', () => setType(b.getAttribute('data-bau-type'))));
        })();
    </script>
}
