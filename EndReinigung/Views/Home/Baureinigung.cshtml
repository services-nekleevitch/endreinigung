@{
    ViewData["Title"] = "Baureinigung Zürich ✓ Fixpreis & bezugsbereit zur Übergabe";
    ViewData["Description"] = "Professionelle Baureinigung in Zürich nach Umbau oder Renovation. Staubfrei, bezugsbereit, zum Fixpreis. Jetzt Offerte anfordern.";
    ViewData["Canonical"] = "https://zurich-endreinigung.ch/baureinigung";
    ViewData["Keywords"] = "Baureinigung Zürich, Baureinigung Kosten, Baureinigung nach Umbau, Bauendreinigung, Baufeinreinigung Zürich";

    var wohnungPrices = new (string Size, int Price, string Area, bool Popular)[] {
        ("1-1.5 Zimmer", 435, "Bis ca. 50m²", false),
        ("2-2.5 Zimmer", 565, "Bis ca. 75m²", false),
        ("3-3.5 Zimmer", 725, "Bis ca. 100m²", true),
        ("4-4.5 Zimmer", 895, "Bis ca. 125m²", false),
        ("5-5.5 Zimmer", 1095, "Bis ca. 150m²", false),
    };
    var hausPrices = new (string Size, int Price, string Area, bool Popular)[] {
        ("3-3.5 Zimmer", 1289, "Bis ca. 130m²", false),
        ("4-4.5 Zimmer", 1589, "Bis ca. 170m²", false),
        ("5-5.5 Zimmer", 1889, "Bis ca. 210m²", false),
    };
    var includedItems = new[] {
        "Baustaub komplett entfernen",
        "Grobschmutz und Bauschutt beseitigen",
        "Fenster innen & aussen reinigen",
        "Böden schleifen und wischen",
        "Sanitäranlagen reinigen",
        "Feinreinigung aller Oberflächen",
        "Küchengeräte reinigen",
    };
    var faqItems = new (string Q, string A)[] {
        ("Was kostet eine Baureinigung in Zürich?", "Die Kosten hängen von der Objektgrösse und dem Verschmutzungsgrad ab. Für Wohnungen in Zürich und Kanton beginnen unsere Fixpreise ab CHF 435 für 1–1.5 Zimmer. Grössere Objekte wie 3.5-Zimmer-Wohnungen kosten ab CHF 745. Im Preis inbegriffen sind Anfahrt und Material — keine versteckten Kosten. Für Gewerbe- und Grossprojekte erstellen wir eine individuelle Offerte innert 24 Stunden."),
        ("Was umfasst eine professionelle Baureinigung?", "Eine professionelle Baureinigung umfasst die komplette Reinigung nach Bau-, Umbau- oder Renovierungsarbeiten. Dazu gehören: Entfernung von Baustaub auf allen Oberflächen, Beseitigung von Zement-, Mörtel- und Gipsresten, Reinigung aller Böden (Parkett, Plättli, Laminat), Fensterreinigung innen und aussen, Reinigung von Küche und Sanitäranlagen sowie Feinreinigung aller Oberflächen. Ziel ist eine bezugsfertige Übergabe."),
        ("Wie lange dauert eine Baureinigung?", "Für eine Wohnung (1–3.5 Zimmer) dauert eine Baureinigung in der Regel 4–8 Stunden. Grössere Wohnungen und Einfamilienhäuser benötigen 1–2 Arbeitstage. Bei Gewerbe- und Grossprojekten planen wir die Dauer individuell. Wir koordinieren uns direkt mit Ihrer Bauleitung, damit die Reinigung termingerecht zum Bauabschluss stattfindet."),
        ("Baureinigung selber machen oder Profis beauftragen?", "Eine Baureinigung nach Umbau oder Neubau erfordert Spezialgeräte und Fachwissen. Baustaub setzt sich in Fugen und Ritzen fest, Zementreste auf Glas und Parkett müssen fachgerecht entfernt werden — falsche Reinigungsmittel können teure Oberflächen beschädigen. Eine professionelle Baureinigung spart Zeit, vermeidet Schäden und garantiert ein bezugsfertiges Ergebnis. Bei uns sind Sie zudem haftpflichtversichert mit 5 Mio. CHF Deckung."),
        ("Was ist der Unterschied zwischen Baugrobreinigung und Bauendreinigung?", "Die Baugrobreinigung findet während der Bauphase statt — grober Schmutz, Bauschutt und Abfälle werden laufend beseitigt. Die Bauendreinigung (auch Baufeinreinigung) erfolgt nach Abschluss aller Bauarbeiten und umfasst die gründliche Feinreinigung des gesamten Objekts: Staub, Reste, Flecken — alles wird entfernt, bis das Objekt bezugsfertig ist. Wir bieten beide Leistungen an."),
        ("Wann sollte ich die Baureinigung planen?", "Idealerweise kontaktieren Sie uns bereits während der Bauphase, damit wir den Termin auf Ihren Bauzeitplan abstimmen können. Kurzfristige Einsätze sind ebenfalls möglich — wir sind in der Regel innert 48 Stunden verfügbar. Nach Ihrer Anfrage erhalten Sie innerhalb von 24 Stunden eine Offerte oder können direkt online Ihren Fixpreis berechnen."),
    };
    var bezirke = new (string Slug, string Name, string Hauptort)[] {
        ("affoltern", "Bezirk Affoltern", "Affoltern am Albis"),
        ("andelfingen", "Bezirk Andelfingen", "Andelfingen"),
        ("buelach", "Bezirk Bülach", "Bülach"),
        ("dielsdorf", "Bezirk Dielsdorf", "Dielsdorf"),
        ("dietikon", "Bezirk Dietikon", "Dietikon"),
        ("hinwil", "Bezirk Hinwil", "Hinwil"),
        ("horgen", "Bezirk Horgen", "Horgen"),
        ("meilen", "Bezirk Meilen", "Meilen"),
        ("pfaeffikon", "Bezirk Pfäffikon", "Pfäffikon ZH"),
        ("uster", "Bezirk Uster", "Uster"),
        ("winterthur", "Bezirk Winterthur", "Winterthur"),
        ("zuerich", "Bezirk Zürich", "Zürich"),
    };
}

@section Head {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "inLanguage": "de-CH",
        "mainEntity": [
            @for (var i = 0; i < faqItems.Length; i++)
            {
                var (q, a) = faqItems[i];
                @:{ "@@type": "Question", "name": "@q", "acceptedAnswer": { "@@type": "Answer", "text": "@a" } }@(i < faqItems.Length - 1 ? "," : "")
            }
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Service",
        "@@id": "https://zurich-endreinigung.ch/baureinigung#service",
        "url": "https://zurich-endreinigung.ch/baureinigung",
        "inLanguage": "de-CH",
        "serviceType": "Baureinigung",
        "name": "Baureinigung Zürich – Fixpreise nach Objektgrösse",
        "provider": { "@@id": "https://zurich-endreinigung.ch/#business" },
        "areaServed": { "@@type": "State", "name": "Kanton Zürich" },
        "offers": {
            "@@type": "AggregateOffer",
            "priceCurrency": "CHF",
            "lowPrice": 435,
            "highPrice": 1989,
            "offerCount": @(wohnungPrices.Length + hausPrices.Length),
            "offers": [
                @{ var allBauPrices = wohnungPrices.Select(p => (Label: "Wohnung " + p.Size, p.Price)).Concat(hausPrices.Select(p => (Label: "Einfamilienhaus " + p.Size, p.Price))).ToArray(); }
                @for (var i = 0; i < allBauPrices.Length; i++)
                {
                    var bp = allBauPrices[i];
                    @:{ "@@type": "Offer", "name": "@bp.Label", "price": @bp.Price, "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/baureinigung" }@(i < allBauPrices.Length - 1 ? "," : "")
                }
            ]
        }
    }
    </script>
}

