    </section>

    <!-- ═══ TLDR / KURZ ERKLÄRT + TRUST BAR ═══ -->
    <section class="bg-background pt-2 md:pt-3">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-secondary/40 border border-border rounded-2xl p-6 md:p-8 mt-6">
                <div class="flex items-center gap-2 mb-4">
                    <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l2 7h7l-5.5 4 2 7L12 17l-5.5 4 2-7L3 10h7z"/></svg>
                    <span class="text-xs font-semibold uppercase tracking-wider text-primary">Kurz erklärt</span>
                </div>
                <p class="mb-6 text-foreground leading-relaxed">
                    <strong>Professionelle Baureinigung in Zürich – Staubfrei zur Schlüsselübergabe.</strong>
                    Ob Neubau oder Renovation: Wir übernehmen die komplette Baugrobreinigung und Baufeinreinigung,
                    damit Ihr Objekt pünktlich bezugsbereit ist. Unser Team entfernt Baustaub, Farbreste und
                    Zementschleier fachgerecht. Mit 100% Abnahmegarantie und Fixpreisen ab CHF 435 sorgen wir
                    für eine stressfreie Bauabnahme im gesamten Kanton Zürich.
                </p>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 pt-6 mt-6 border-t border-border/60">
                    @{
                        var trustBar = new (string Icon, string Title, string Subtitle)[] {
                            ("shield",   "Haftpflichtversichert",      "5 Mio. CHF Deckung"),
                            ("award",    "Bezugsfertige Übergabe",     "Qualitätskontrolle garantiert"),
                            ("clock",    "Fixpreis sofort berechnen",  "Online in 2 Minuten"),
                            ("file",     "Spezialobjekt?",             "Individuelle Offerte innert 24h"),
                        };
                    }
                    @foreach (var (icon, title, subtitle) in trustBar)
                    {
                        <div class="flex flex-col items-center text-center">
                            <div class="w-9 h-9 md:w-12 md:h-12 bg-primary/10 rounded-full flex items-center justify-center mb-2.5">
                                @switch (icon)
                                {
                                    case "shield":
                                        <svg class="w-[18px] h-[18px] md:w-6 md:h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                        break;
                                    case "award":
                                        <svg class="w-[18px] h-[18px] md:w-6 md:h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                                        break;
                                    case "clock":
                                        <svg class="w-[18px] h-[18px] md:w-6 md:h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                        break;
                                    case "file":
                                        <svg class="w-[18px] h-[18px] md:w-6 md:h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                                        break;
                                }
                            </div>
                            <h3 class="text-xs md:text-sm font-semibold text-foreground">@title</h3>
                            <p class="text-[11px] md:text-xs text-muted-foreground mt-1">@subtitle</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- ═══ PRICING CARDS ═══ -->
    <section id="pakete" class="py-16 px-4 sm:px-6 lg:px-8 scroll-mt-16 md:scroll-mt-[6.25rem] bg-[#e0e0e0]">
        <div class="max-w-5xl mx-auto">
            <div class="text-center mb-8">
                <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">Fixpreise Baureinigung</h2>
                <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
                    Transparente Festpreise für Ihre Baureinigung in Zürich — alles inklusive.
                </p>
            </div>

            <!-- Property type toggle -->
            <div class="flex justify-center gap-3 mb-8" id="bau-type-toggle">
                <button type="button" data-bau-type="wohnung" class="bau-type-btn inline-flex items-center px-5 py-2.5 rounded-lg font-medium transition-colors bg-primary text-primary-foreground">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
                    Wohnung
                </button>
                <button type="button" data-bau-type="haus" class="bau-type-btn inline-flex items-center px-5 py-2.5 rounded-lg font-medium transition-colors border-2 border-border bg-card text-foreground hover:border-booking-orange/50">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    Einfamilienhaus
                </button>
                <button type="button" data-bau-type="gewerbe" class="bau-type-btn inline-flex items-center px-5 py-2.5 rounded-lg font-medium transition-colors border-2 border-border bg-card text-foreground hover:border-muted-foreground">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 18a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v2z"/><path d="M10 15V6.5a3.5 3.5 0 1 1 7 0V15"/><path d="M4 15v-5a8 8 0 0 1 16 0v5"/></svg>
                    Gewerbe
                </button>
            </div>

            <!-- Wohnung cards -->
            <div data-bau-panel="wohnung" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
                @foreach (var (size, price, area, popular) in wohnungPrices)
                {
                    <div class="relative p-4 sm:p-6 bg-white rounded-xl border-2 @(popular ? "border-swiss-blue shadow-lg" : "border-border") hover:shadow-xl transition-all duration-300">
                        @if (popular)
                        {
                            <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
                                <div class="bg-swiss-blue text-white text-xs font-bold px-4 py-1.5 rounded-full">Beliebt</div>
                            </div>
                        }
                        <div class="absolute top-4 right-4">
                            <div class="@(popular ? "bg-cleaning-green" : "bg-trust-gold") text-white text-xs font-bold px-3 py-1 rounded-full">Fixpreis</div>
                        </div>
                        <div class="text-center mb-6">
