<script>
    function switchTab(tab) {
        // Hide all panels
        document.getElementById('panel-wohnung').classList.add('hidden');
        document.getElementById('panel-haus').classList.add('hidden');
        document.getElementById('panel-gewerbe').classList.add('hidden');

        // Reset all tab buttons
        document.querySelectorAll('.tab-btn').forEach(function(btn) {
            btn.classList.remove('bg-card', 'shadow', 'text-foreground');
            btn.classList.add('text-muted-foreground');
            btn.setAttribute('aria-selected', 'false');
        });

        // Show selected panel
        document.getElementById('panel-' + tab).classList.remove('hidden');

        // Activate selected tab button
        var activeBtn = document.getElementById('tab-' + tab);
        activeBtn.classList.add('bg-card', 'shadow', 'text-foreground');
        activeBtn.classList.remove('text-muted-foreground');
        activeBtn.setAttribute('aria-selected', 'true');
    }
</script>

