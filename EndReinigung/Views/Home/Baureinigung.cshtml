                        <div class="flex items-center justify-center w-7 h-7 rounded-full bg-trust-gold/15 ring-1 ring-trust-gold/40">
                            <svg class="w-4 h-4 text-trust-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
