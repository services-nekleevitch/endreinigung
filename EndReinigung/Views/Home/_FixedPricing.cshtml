<!-- Fixed Pricing -->
<section id="pakete" class="py-16 px-4 sm:px-6 lg:px-8 bg-gray-50 scroll-mt-16 md:scroll-mt-[6.25rem]">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">Fixpreise Endreinigung besenrein inkl. Wohnungsabgabe</h2>
            <p class="text-lg text-muted-foreground max-w-2xl mx-auto">Transparente Festpreise für Ihre Endreinigung und Wohnungsübergabe in Zürich — alles inklusive.</p>
        </div>

        <!-- Pricing Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
            @{
                var pricingOptions = new[] {
                    new { Size = "1-1.5 Zimmer", Price = "550 CHF", Popular = false },
                    new { Size = "2-2.5 Zimmer", Price = "650 CHF", Popular = false },
                    new { Size = "3-3.5 Zimmer", Price = "850 CHF", Popular = true },
                    new { Size = "4-4.5 Zimmer", Price = "970 CHF", Popular = false },
                    new { Size = "5-5.5 Zimmer", Price = "1150 CHF", Popular = false },
                    new { Size = "6-6.5 Zimmer", Price = "ab 1350 CHF", Popular = false }
                };
                var features = new[] { "Komplettreinigung", "Wohnungsabgabe-fertig", "Alle Räume & Küche", "Fenster innen & außen", "Rollläden und Storen", "100% Abnahmegarantie" };
                var i = 0;
            }
            @foreach (var option in pricingOptions) {
                <a href="/calculator" class="relative p-4 sm:p-6 bg-white border-2 rounded-lg hover:shadow-xl transition-all duration-300 animate-fade-in block @(option.Popular ? "border-swiss-blue shadow-lg" : "border-gray-200")" style="animation-delay: @(i * 100)ms">
                    @if (option.Popular) {
                        <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
                            <div class="bg-swiss-blue text-white text-xs font-bold px-4 py-1.5 rounded-full">Am beliebtesten</div>
                        </div>
                    }
                    <div class="absolute top-4 right-4">
                        <div class="text-white text-xs font-bold px-3 py-1 rounded-full @(option.Popular ? "bg-cleaning-green" : "bg-trust-gold")">Fixpreis</div>
                    </div>
                    <div class="text-center mb-6">
                        <div class="flex items-center justify-center mb-4">
                            <svg class="w-8 h-8 text-swiss-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                        </div>
                        <h3 class="text-xl font-bold text-foreground mb-1">@option.Size</h3>
                        <p class="text-xs text-muted-foreground mb-2">Endreinigung in Zürich und Kanton</p>
                        <div class="text-3xl font-bold text-swiss-blue mb-1">@option.Price</div>
                        <p class="text-xs text-muted-foreground">alles inkl.</p>
                    </div>
                    <div class="space-y-2 mb-6">
                        @foreach (var feature in features) {
                            <div class="flex items-start">
                                <svg class="w-4 h-4 text-cleaning-green mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                <span class="text-xs text-foreground">@feature</span>
                            </div>
                        }
                        <div class="flex items-start pt-1 border-t border-gray-100">
                            <svg class="w-4 h-4 text-swiss-blue mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4-4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
                            <span class="text-xs font-semibold text-foreground">Persönliche Anwesenheit bei der Abnahme</span>
                        </div>
                    </div>
                    <div class="w-full bg-swiss-blue hover:bg-swiss-blue/90 text-white text-sm font-medium py-2.5 px-4 rounded-md text-center flex items-center justify-center">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        Jetzt Fixpreis berechnen
                    </div>
                </a>
                i++;
            }

            <!-- Custom Package Card -->
            <a href="#contact" class="relative p-4 sm:p-6 bg-white border-2 border-gray-300 rounded-lg hover:shadow-xl transition-all duration-300 animate-fade-in hover:border-swiss-blue sm:col-span-2 lg:col-span-3 block" style="animation-delay: @(pricingOptions.Length * 100)ms">
                <div class="absolute top-4 right-4">
                    <div class="bg-gray-500 text-white text-xs font-bold px-3 py-1 rounded-full">Individuelles Angebot</div>
                </div>
                <div class="text-center mb-6">
                    <div class="flex items-center justify-center mb-4">
                        <svg class="w-8 h-8 text-swiss-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-foreground mb-2 leading-tight">7+ Zimmer / Haus / Spezialobjekt</h3>
                    <div class="text-2xl font-bold text-swiss-blue mb-1">Individueller Preis</div>
                    <p class="text-xs text-muted-foreground mb-1">Individuelle Endreinigung in Zürich und Kanton</p>
                    <p class="text-xs text-muted-foreground">basierend auf Grösse &amp; Zustand</p>
                </div>
                <div class="space-y-2 mb-6">
                    @{
                        var customFeatures = new[] { "Komplette Endreinigung", "Wohnungsabgabe-fertig", "Alle Räume & Küche", "Fenster innen & aussen", "Rollläden und Storen", "Keller, Estrich, Garage (falls vorhanden)", "100% Abnahmegarantie mit persönlicher Anwesenheit" };
                    }
                    @foreach (var feature in customFeatures) {
                        <div class="flex items-start">
                            <svg class="w-4 h-4 text-cleaning-green mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                            <span class="text-xs text-foreground">@feature</span>
                        </div>
                    }
                </div>
                <div class="w-full bg-swiss-blue hover:bg-swiss-blue/90 text-white text-sm font-medium py-2.5 px-4 rounded-md text-center flex items-center justify-center">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"/></svg>
                    Kostenlose Offerte anfordern
                </div>
                <p class="text-center text-[10px] text-muted-foreground mt-2">Antwort innerhalb von 24 Stunden</p>
            </a>
        </div>

        <!-- Additional Info -->
        <div class="mt-12">
            <div class="p-4 sm:p-8 bg-white border-0 shadow-lg rounded-lg">
                <div class="text-center">
                    <h3 class="text-2xl font-bold text-foreground mb-4">Im Preis enthalten — Ihre Endreinigung in Zürich</h3>
                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6 mt-8">
                        @{
                            var includedItems = new[] {
                                new { Title = "Komplettreinigung", Desc = "Alle Räume gründlich gereinigt" },
                                new { Title = "Küche & Badezimmer", Desc = "Tiefenreinigung inklusive" },
                                new { Title = "Fenster", Desc = "Innen & außen streifenfrei" },
                                new { Title = "100% Abnahmegarantie", Desc = "Mit persönlicher Anwesenheit" },
                                new { Title = "Rollläden & Storen", Desc = "Gründliche Reinigung inklusive" },
                                new { Title = "Festpreis", Desc = "Keine versteckten Kosten" }
                            };
                        }
                        @foreach (var item in includedItems) {
                            <div class="text-center">
                                <div class="bg-gray-100 rounded-full p-4 w-16 h-16 mx-auto mb-3 flex items-center justify-center">
                                    <svg class="w-8 h-8 text-cleaning-green" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                </div>
                                <h4 class="font-semibold text-foreground mb-1">@item.Title</h4>
                                <p class="text-sm text-muted-foreground">@item.Desc</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
