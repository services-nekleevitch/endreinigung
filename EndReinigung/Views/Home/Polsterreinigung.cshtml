@{
    ViewData["Title"] = "Polsterreinigung Zürich | Sofa, Sessel & Polstermöbel | Zürich Endreinigung";
    ViewData["Description"] = "Professionelle Polsterreinigung in Zürich. Tiefenreinigung für Sofas, Sessel und Polstermöbel — hygienisch sauber. Jetzt Termin buchen.";
    ViewData["Canonical"] = "https://zuerich-endreinigung.ch/polsterreinigung";
}

<div class="min-h-screen bg-gray-50">

    <!-- Hero Section -->
    <section class="pt-20 md:pt-[7.75rem] pb-8 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-6">
                <a href="/extra-services" class="inline-flex items-center px-3 py-1.5 text-sm border border-swiss-blue text-swiss-blue rounded-md hover:bg-swiss-blue hover:text-white transition-colors">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                    Zurück zu Extra Services
                </a>
            </div>

            <div class="text-center">
                <div class="bg-gradient-hero rounded-2xl p-4 w-20 h-20 mx-auto mb-6 flex items-center justify-center">
                    <!-- Sofa icon -->
                    <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 9V6a2 2 0 00-2-2H6a2 2 0 00-2 2v3"/><path d="M2 11v5a2 2 0 002 2h16a2 2 0 002-2v-5a2 2 0 00-4 0v2H6v-2a2 2 0 00-4 0z"/><path d="M4 18v2"/><path d="M20 18v2"/></svg>
                </div>
                <h1 class="text-3xl md:text-5xl font-bold text-foreground mb-4">Polsterreinigung</h1>
                <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
                    Professionelle Tiefenreinigung für Ihre Polstermöbel — Grundreinigung (Intensive Tiefenreinigung)
                </p>
            </div>
        </div>
    </section>

    <!-- Pricing Table -->
    <section class="py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
            <div class="rounded-lg border bg-card text-card-foreground shadow-xl p-8 border-0 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="bg-gradient-hero text-white">
                                <th class="text-left py-4 px-4 rounded-tl-lg font-semibold">Möbelstück</th>
                                <th class="text-center py-4 px-4 font-semibold">Grundreinigung</th>
                                <th class="text-center py-4 px-4 rounded-tr-lg font-semibold">
                                    <div class="flex items-center justify-center gap-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75"/></svg>
                                        ECO Reinigung
                                    </div>
                                    <span class="text-xs font-normal opacity-80">(+25%)</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors bg-white">
                                <td class="py-4 px-4 text-foreground font-medium">Sessel</td>
                                <td class="py-4 px-4 text-center text-swiss-blue font-bold text-lg">110 CHF</td>
                                <td class="py-4 px-4 text-center text-cleaning-green font-bold text-lg">138 CHF</td>
                            </tr>
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors bg-gray-50/50">
                                <td class="py-4 px-4 text-foreground font-medium">Bürostuhl (Ganze Polsterung)</td>
                                <td class="py-4 px-4 text-center text-swiss-blue font-bold text-lg">75 CHF</td>
                                <td class="py-4 px-4 text-center text-cleaning-green font-bold text-lg">94 CHF</td>
                            </tr>
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors bg-white">
                                <td class="py-4 px-4 text-foreground font-medium">2-Sitzer Sofa (ca. 120–160 cm)</td>
                                <td class="py-4 px-4 text-center text-swiss-blue font-bold text-lg">180 CHF</td>
                                <td class="py-4 px-4 text-center text-cleaning-green font-bold text-lg">225 CHF</td>
                            </tr>
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors bg-gray-50/50">
                                <td class="py-4 px-4 text-foreground font-medium">3-Sitzer Sofa (ca. 180–220 cm)</td>
                                <td class="py-4 px-4 text-center text-swiss-blue font-bold text-lg">240 CHF</td>
                                <td class="py-4 px-4 text-center text-cleaning-green font-bold text-lg">300 CHF</td>
                            </tr>
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors bg-white">
                                <td class="py-4 px-4 text-foreground font-medium">L-Form Sofa (Ecksofa)</td>
                                <td class="py-4 px-4 text-center text-swiss-blue font-bold text-lg">330 CHF</td>
                                <td class="py-4 px-4 text-center text-cleaning-green font-bold text-lg">413 CHF</td>
                            </tr>
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors bg-gray-50/50">
                                <td class="py-4 px-4 text-foreground font-medium">U-Form Sofa (Grosse Wohnlandschaft)</td>
                                <td class="py-4 px-4 text-center text-swiss-blue font-bold text-lg">420 CHF</td>
                                <td class="py-4 px-4 text-center text-cleaning-green font-bold text-lg">525 CHF</td>
                            </tr>
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors bg-white">
                                <td class="py-4 px-4 text-foreground font-medium">Esszimmerstuhl (pro Stuhl, Polsterung)</td>
                                <td class="py-4 px-4 text-center text-swiss-blue font-bold text-lg">55 CHF</td>
                                <td class="py-4 px-4 text-center text-cleaning-green font-bold text-lg">69 CHF</td>
                            </tr>
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors bg-gray-50/50">
                                <td class="py-4 px-4 text-foreground font-medium">Hocker / Ottomane</td>
                                <td class="py-4 px-4 text-center text-swiss-blue font-bold text-lg">70 CHF</td>
                                <td class="py-4 px-4 text-center text-cleaning-green font-bold text-lg">88 CHF</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Add-On Services -->
            <div class="rounded-lg border bg-card text-card-foreground shadow-xl p-8 border-0 overflow-hidden mt-12">
                <div class="text-center mb-6">
                    <h3 class="text-2xl font-bold text-foreground mb-2">Zusatzleistungen</h3>
                    <p class="text-muted-foreground">Diese Leistungen können zu jeder Grundreinigung hinzugebucht werden</p>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="bg-cleaning-green text-white">
                                <th class="text-left py-4 px-4 rounded-tl-lg font-semibold">Zusatzleistung</th>
                                <th class="text-center py-4 px-4 font-semibold">Preis</th>
                                <th class="text-left py-4 px-4 rounded-tr-lg font-semibold">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                                <td class="py-4 px-4 text-foreground font-medium">Faserschutz / Imprägnierung</td>
                                <td class="py-4 px-4 text-center text-cleaning-green font-bold">
                                    + 40%
                                    <span class="block text-xs text-muted-foreground font-normal">(zum Grundpreis)</span>
                                </td>
                                <td class="py-4 px-4 text-sm text-muted-foreground">
                                    Bildung einer Schutzschicht gegen neue Flecken und vorzeitigen Verschleiss. <span class="text-booking-orange font-semibold">Empfohlen!</span>
                                </td>
                            </tr>
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors bg-gray-50/50">
                                <td class="py-4 px-4 text-foreground font-medium">
                                    Matratzen-Tiefenreinigung
                                    <span class="block text-xs text-muted-foreground font-normal">(Einzelmatratze)</span>
                                </td>
                                <td class="py-4 px-4 text-center text-cleaning-green font-bold">120 CHF</td>
                                <td class="py-4 px-4 text-sm text-muted-foreground">Hygienische Reinigung zur Milben- und Allergenentfernung.</td>
                            </tr>
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                                <td class="py-4 px-4 text-foreground font-medium">
                                    Hartnäckige Fleckenentfernung
                                    <span class="block text-xs text-muted-foreground font-normal">(pro Spezialfleck)</span>
                                </td>
                                <td class="py-4 px-4 text-center text-cleaning-green font-bold">35 – 70 CHF</td>
                                <td class="py-4 px-4 text-sm text-muted-foreground">Spezialbehandlung für Flecken wie Tinte, Öl oder stark eingetrocknete Substanzen.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Volume Discount -->
            <div class="mt-12">
                <div class="rounded-lg border bg-card text-card-foreground shadow-xl p-8 border-0">
                    <div class="text-center">
                        <h3 class="text-2xl font-bold text-foreground mb-4">Mengenrabatt</h3>
                        <p class="text-muted-foreground mb-8">Sparen Sie bei mehreren Möbelstücken</p>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-md mx-auto">
                            <div class="bg-gray-50 rounded-xl p-6">
                                <div class="text-3xl font-bold text-swiss-blue mb-2">10%</div>
                                <div class="text-sm font-medium text-foreground">Bei 2 Möbelstücken</div>
                            </div>
                            <div class="bg-gradient-pricing rounded-xl p-6 text-white transform scale-105">
                                <div class="text-3xl font-bold mb-2">20%</div>
                                <div class="text-sm font-medium">Bei 3+ Möbelstücken</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Included in Every Service -->
            <div class="mt-12">
                <div class="rounded-lg border bg-card text-card-foreground shadow-lg p-8 border-0">
                    <div class="text-center">
                        <h3 class="text-2xl font-bold text-foreground mb-6">Im Service enthalten</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="flex items-center justify-center md:justify-start">
                                <svg class="w-5 h-5 text-cleaning-green mr-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                <span class="text-foreground">Tiefenreinigung aller Polstermaterialien</span>
                            </div>
                            <div class="flex items-center justify-center md:justify-start">
                                <svg class="w-5 h-5 text-cleaning-green mr-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                <span class="text-foreground">Professionelle Fleckenentfernung</span>
                            </div>
                            <div class="flex items-center justify-center md:justify-start">
                                <svg class="w-5 h-5 text-cleaning-green mr-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                <span class="text-foreground">Geruchsneutralisierung</span>
                            </div>
                            <div class="flex items-center justify-center md:justify-start">
                                <svg class="w-5 h-5 text-cleaning-green mr-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                <span class="text-foreground">Materialschonende Behandlung</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CTA -->
            <div class="mt-12 text-center">
                <div class="rounded-lg bg-gradient-pricing text-white shadow-xl p-8 border-0">
                    <h3 class="text-2xl font-bold mb-4">Bereit für frische Polster?</h3>
                    <p class="mb-6 opacity-90">Kontaktieren Sie uns für eine individuelle Beratung oder buchen Sie direkt online</p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a href="/booking" class="inline-flex items-center justify-center px-6 py-3 bg-white text-booking-orange hover:bg-gray-100 rounded-md transition-colors">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            Jetzt Buchen
                        </a>
                        <a href="/#contact" class="inline-flex items-center justify-center px-6 py-3 border border-white text-white hover:bg-white hover:text-booking-orange rounded-md transition-colors">
                            Kontakt aufnehmen
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @await Html.PartialAsync("~/Views/Shared/_Footer.cshtml")
</div>
