            { "@@type": "ListItem", "position": 1, "name": "Start", "item": "https://zurich-endreinigung.ch/" },
            { "@@type": "ListItem", "position": 2, "name": "Spezialreinigung", "item": "https://zurich-endreinigung.ch/extra-services" },
            { "@@type": "ListItem", "position": 3, "name": "Polsterreinigung", "item": "https://zurich-endreinigung.ch/polsterreinigung" }
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Service",
        "name": "Polsterreinigung Zürich – Fixpreise",
        "description": "Professionelle Tiefenreinigung von Polstermöbeln — Fleckenentfernung, Geruchsneutralisierung und materialschonende Behandlung.",
        "provider": {
            "@@type": "ProfessionalService",
            "@@id": "https://zurich-endreinigung.ch/#business",
            "name": "Zürich Endreinigung"
        },
        "areaServed": { "@@type": "AdministrativeArea", "name": "Kanton Zürich" },
        "url": "https://zurich-endreinigung.ch/polsterreinigung",
        "hasOfferCatalog": {
            "@@type": "OfferCatalog",
            "name": "Polsterreinigung Fixpreise",
            "itemListElement": [
                { "@@type": "Offer", "name": "Sessel", "price": "110", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Bürostuhl", "price": "75", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "2-Sitzer Sofa", "price": "180", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "3-Sitzer Sofa", "price": "240", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "L-Form Sofa (Ecksofa)", "price": "330", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "U-Form Sofa", "price": "420", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Esszimmerstuhl", "price": "55", "priceCurrency": "CHF" },
                { "@@type": "Offer", "name": "Hocker / Ottomane", "price": "70", "priceCurrency": "CHF" }
            ]
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "Was kostet eine Polsterreinigung in Zürich?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Die Preise beginnen bei CHF 55 für einen Esszimmerstuhl. Ein 2-Sitzer Sofa kostet CHF 180, ein 3-Sitzer CHF 240, ein Sessel CHF 110. Alle Preise sind Fixpreise inkl. Anfahrt und Material, MWST-frei. Mindestauftragswert CHF 220."
                }
            },
            {
                "@@type": "Question",
                "name": "Wie lange dauert eine Polsterreinigung?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Je nach Möbelstück und Verschmutzungsgrad dauert eine professionelle Polsterreinigung zwischen 30 Minuten und 2 Stunden. Die Trocknungszeit beträgt in der Regel 2–4 Stunden."
                }
            },
            {
                "@@type": "Question",
                "name": "Welche Materialien können gereinigt werden?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Wir reinigen alle gängigen Polstermaterialien: Stoff, Mikrofaser, Leder, Kunstleder, Velours und Mischgewebe. Bei Leder empfehlen wir die Lederpflege-Option (+20 %)."
                }
            },
            {
                "@@type": "Question",
                "name": "Gibt es einen Mengenrabatt?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Ja. Bei 2 Möbelstücken gewähren wir 10 % Rabatt, ab 3 Möbelstücken 20 % auf den Gesamtpreis."
                }
            }
        ]
    }
    </script>
}

