@{
    ViewData["Title"] = "Gewerbereinigung Zürich – Büro, Praxis, Bau & Airbnb | Schweizer Anbieter";
    ViewData["Description"] = "Professionelle Gewerbereinigung im Kanton Zürich: Büroreinigung ab CHF 50/Std, Praxisreinigung, Baureinigung ab CHF 435, Airbnb-Turnover. Rechnung ohne MWST.";
    ViewData["Keywords"] = "Gewerbereinigung Zürich, Büroreinigung, Praxisreinigung, Baureinigung, Airbnb Cleaning";
    ViewData["Canonical"] = "https://zurich-endreinigung.ch/gewerbereinigung";
}

@section Head {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@@type": "ListItem",
                "position": 1,
                "name": "Start",
                "item": "https://zurich-endreinigung.ch/"
            },
            {
                "@@type": "ListItem",
                "position": 2,
                "name": "Gewerbereinigung",
                "item": "https://zurich-endreinigung.ch/gewerbereinigung"
            }
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Service",
        "name": "Gewerbereinigung Zürich – Preise pro Service",
        "description": "Gewerbliche Reinigungsservices für Büros, Arztpraxen, Baustellen und Kurzzeitvermietungen — mit flexiblen Verträgen und Rechnung ohne MWST.",
        "provider": {
            "@@type": "ProfessionalService",
            "@@id": "https://zurich-endreinigung.ch/#business",
            "name": "Zürich Endreinigung"
        },
        "areaServed": {
            "@@type": "AdministrativeArea",
            "name": "Kanton Zürich"
        },
        "hasOfferCatalog": {
            "@@type": "OfferCatalog",
            "name": "Gewerbereinigung Services",
            "itemListElement": [
                {
                    "@@type": "Offer",
                    "itemOffered": {
                        "@@type": "Service",
                        "name": "Büroreinigung (pro Stunde)",
                        "url": "https://zurich-endreinigung.ch/bueroreinigung"
                    },
                    "price": "50",
                    "priceCurrency": "CHF"
                },
                {
                    "@@type": "Offer",
                    "itemOffered": {
                        "@@type": "Service",
                        "name": "Airbnb-Turnover ab",
                        "url": "https://zurich-endreinigung.ch/airbnb-reinigung-zuerich"
                    },
                    "price": "89",
                    "priceCurrency": "CHF"
                },
                {
                    "@@type": "Offer",
                    "itemOffered": {
                        "@@type": "Service",
                        "name": "Baureinigung ab",
                        "url": "https://zurich-endreinigung.ch/baureinigung"
                    },
                    "price": "435",
                    "priceCurrency": "CHF"
                }
            ]
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "Stellen Sie eine Rechnung mit MWST aus?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Wir sind Kleinunternehmer im Sinne des MWSTG und stellen ohne MWST Rechnung. Das spart Ihnen 8.1% gegenüber MWST-pflichtigen Anbietern. Die Rechnung ist trotzdem als Geschäftsaufwand voll abziehbar."
                }
            },
            {
                "@@type": "Question",
                "name": "Wie lange läuft ein Wartungsvertrag?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Wir arbeiten mit kurzen Kündigungsfristen (1 Monat). Es gibt keine Langzeitbindung — Sie können den Service jederzeit pausieren oder anpassen, wenn sich Ihre Anforderungen ändern."
                }
            },
            {
                "@@type": "Question",
                "name": "Wie regeln Sie die Schlüsselübergabe?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Wir verwenden ein dokumentiertes Schlüsselprotokoll. Schlüssel werden persönlich übergeben, in einem Safe verwahrt und nur dem zuständigen Reinigungsteam ausgehändigt. Auf Wunsch arbeiten wir auch mit Schlüsseltresoren oder Zutrittscodes."
                }
            },
            {
                "@@type": "Question",
                "name": "Sind gewerbliche Reinigungen versichert?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Ja. Alle Gewerbereinigungen sind durch unsere Betriebshaftpflicht über 5 Mio. CHF abgedeckt. Das umfasst Schäden an Mobiliar, IT-Geräten, Sanitäranlagen und allen Einrichtungsgegenständen."
                }
            }
        ]
    }
    </script>
}

<div class="min-h-screen bg-background">

