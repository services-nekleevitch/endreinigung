@{
    ViewData["Title"] = "Endreinigung Zürich | 100% Abnahmegarantie & Fixpreis";
    ViewData["Description"] = "Endreinigung Zürich zum transparenten Fixpreis mit 100% Abnahmegarantie. Persönlich bei der Wohnungsübergabe vor Ort – kostenlose Nachbesserung inklusive.";
    ViewData["Keywords"] = "Endreinigung Zürich, Abnahmegarantie, Wohnungsreinigung Zürich, Endreinigung Kosten, Wohnungsübergabe Zürich";
    ViewData["HeroPreload"] = "/img/zurich-cityscape.webp";
    ViewData["HeroPreloadMobile"] = "/img/zurich-cityscape-mobile.webp";
}

@section Head {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "inLanguage": "de-CH",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "Wie viel kostet eine Endreinigung in Zürich?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Eine professionelle Endreinigung in Zürich kostet bei uns CHF 550 für 1–1.5 Zimmer, CHF 650 für 2–2.5 Zimmer und CHF 850 für 3–3.5 Zimmer. Der Fixpreis umfasst die vereinbarten Leistungen inklusive 100% Abnahmegarantie, und wir sind persönlich bei der Wohnungsübergabe vor Ort."
                }
            },
            {
                "@@type": "Question",
                "name": "Ist die Abnahmegarantie wirklich sicher?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Unsere 100% Abnahmegarantie gilt für die Reinigungsleistung: Reinigungsbezogene Beanstandungen beheben wir kostenlos und wenn möglich direkt bei der Übergabe. Die Garantie bezieht sich nicht auf Schäden oder andere mietrechtliche Themen."
                }
            },
            {
                "@@type": "Question",
                "name": "Wie kurzfristig kann ich einen Termin buchen?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Kurzfristige Termine sind je nach Auslastung möglich. Für Ihren Wunschtermin empfehlen wir eine möglichst frühe Buchung, besonders zum Monatsende."
                }
            }
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Service",
        "name": "Endreinigung Zürich – Fixpreise",
        "provider": { "@@id": "https://zurich-endreinigung.ch/#business" },
        "areaServed": { "@@type": "AdministrativeArea", "name": "Kanton Zürich" },
        "offers": [
            { "@@type": "Offer", "name": "Endreinigung 1–1.5 Zimmer", "price": "550", "priceCurrency": "CHF", "description": "Fixpreis inkl. Abnahmegarantie", "url": "https://zurich-endreinigung.ch/calculator" },
            { "@@type": "Offer", "name": "Endreinigung 2–2.5 Zimmer", "price": "650", "priceCurrency": "CHF", "description": "Fixpreis inkl. Abnahmegarantie", "url": "https://zurich-endreinigung.ch/calculator" },
            { "@@type": "Offer", "name": "Endreinigung 3–3.5 Zimmer", "price": "850", "priceCurrency": "CHF", "description": "Fixpreis inkl. Abnahmegarantie", "url": "https://zurich-endreinigung.ch/calculator" },
            { "@@type": "Offer", "name": "Endreinigung 4–4.5 Zimmer", "price": "970", "priceCurrency": "CHF", "description": "Fixpreis inkl. Abnahmegarantie", "url": "https://zurich-endreinigung.ch/calculator" },
            { "@@type": "Offer", "name": "Endreinigung 5–5.5 Zimmer", "price": "1150", "priceCurrency": "CHF", "description": "Fixpreis inkl. Abnahmegarantie", "url": "https://zurich-endreinigung.ch/calculator" },
            { "@@type": "Offer", "name": "Endreinigung 6–6.5 Zimmer", "price": "1350", "priceCurrency": "CHF", "description": "Fixpreis inkl. Abnahmegarantie", "url": "https://zurich-endreinigung.ch/calculator" }
        ]
    }
    </script>
}

@await Html.PartialAsync("_HeroH1")
@await Html.PartialAsync("_TrustBar")
@await Html.PartialAsync("_FixedPricing")
<section class="py-6 md:py-12 bg-muted/30">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        @await Html.PartialAsync("~/Views/Shared/_GoogleReviewsCarousel.cshtml", null, new ViewDataDictionary(ViewData) { ["MaxWidth"] = "max-w-5xl" })
    </div>
</section>
@await Html.PartialAsync("_VideoSection")
@await Html.PartialAsync("_HowItWorks")
@await Html.PartialAsync("_WhyChooseUs")
<div id="galerie" class="scroll-mt-16 md:scroll-mt-[6.25rem]">
    @await Html.PartialAsync("_LetzteEndreinigungen")
</div>
<section class="py-12 md:py-24" style="background: linear-gradient(180deg, hsl(210 10% 96%) 0%, hsl(210 10% 93%) 60%, hsl(0 0% 100%) 100%)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        @await Html.PartialAsync("_EndreinigungInfo")
    </div>
</section>
@await Html.PartialAsync("_PersonalPresenceBanner")
@await Html.PartialAsync("_Var2Services")
<div id="faq" class="scroll-mt-16 md:scroll-mt-[6.25rem]">
    @await Html.PartialAsync("_LP2FAQ")
</div>
@await Html.PartialAsync("_Contact")
@await Html.PartialAsync("~/Views/Shared/_Footer.cshtml")
