@{
    // Rendered at "/" (German) and "/en" (English). Language comes from the URL (Program.cs).
    var isEn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    string T(string de, string en) => isEn ? en : de;
    // For JSON-LD: Razor's @T() would HTML-encode (ü -> &#xFC;), JT() emits JSON-safe raw text.
    Microsoft.AspNetCore.Html.HtmlString JT(string de, string en) => new(System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping.Encode(T(de, en)));
    var calcUrl = "https://zurich-endreinigung.ch/calculator";

    ViewData["Title"] = T("Endreinigung Zürich ab CHF 550 | 100% Abnahmegarantie", "End-of-Lease Cleaning Zurich from CHF 550 | 100% Guarantee");
    ViewData["Description"] = T("1–1.5 Zimmer: CHF 550, 2–2.5 Zimmer: CHF 650, 3–3.5 Zimmer: CHF 850. Transparente Fixpreise und persönliche Begleitung bei der Wohnungsübergabe.", "1–1.5 rooms: CHF 550, 2–2.5 rooms: CHF 650, 3–3.5 rooms: CHF 850. Transparent fixed prices, and we attend your apartment handover in person.");
    ViewData["Keywords"] = T("Endreinigung Zürich, Abnahmegarantie, Wohnungsreinigung Zürich, Endreinigung Kosten, Wohnungsübergabe Zürich", "end-of-lease cleaning Zurich, move-out cleaning Zurich, handover guarantee, apartment cleaning Zurich, cleaning company Zurich English");
    ViewData["HeroPreload"] = "/img/zurich-cityscape.webp";
    ViewData["HeroPreloadMobile"] = "/img/zurich-cityscape-mobile.webp";
}

@section Head {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "inLanguage": "@T("de-CH", "en")",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "@JT("Wie viel kostet eine Endreinigung in Zürich?", "How much does end-of-lease cleaning in Zurich cost?")",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "@JT("Eine professionelle Endreinigung in Zürich kostet bei uns CHF 550 für 1–1.5 Zimmer, CHF 650 für 2–2.5 Zimmer und CHF 850 für 3–3.5 Zimmer. Der Fixpreis umfasst die vereinbarten Leistungen inklusive 100% Abnahmegarantie, und wir sind persönlich bei der Wohnungsübergabe vor Ort.", "Professional end-of-lease cleaning in Zurich costs CHF 550 for 1–1.5 rooms, CHF 650 for 2–2.5 rooms and CHF 850 for 3–3.5 rooms. The fixed price covers the agreed services including our 100% handover guarantee, and we attend the apartment handover in person.")"
                }
            },
            {
                "@@type": "Question",
                "name": "@JT("Ist die Abnahmegarantie wirklich sicher?", "Is the handover guarantee really reliable?")",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "@JT("Unsere 100% Abnahmegarantie gilt für die Reinigungsleistung: Reinigungsbezogene Beanstandungen beheben wir kostenlos und wenn möglich direkt bei der Übergabe. Die Garantie bezieht sich nicht auf Schäden oder andere mietrechtliche Themen.", "Our 100% handover guarantee applies to the cleaning work: we fix cleaning-related complaints free of charge and, where possible, right at the handover. The guarantee does not cover damage or other tenancy-law matters.")"
                }
            },
            {
                "@@type": "Question",
                "name": "@JT("Wie kurzfristig kann ich einen Termin buchen?", "How short-notice can I book an appointment?")",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "@JT("Kurzfristige Termine sind je nach Auslastung möglich. Für Ihren Wunschtermin empfehlen wir eine möglichst frühe Buchung, besonders zum Monatsende.", "Short-notice appointments are possible depending on availability. To get your preferred date, we recommend booking as early as possible, especially for the end of the month.")"
                }
            }
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Service",
        "name": "@JT("Endreinigung Zürich – Fixpreise", "End-of-Lease Cleaning Zurich – Fixed Prices")",
        "inLanguage": "@T("de-CH", "en")",
        "provider": { "@@id": "https://zurich-endreinigung.ch/#business" },
        "areaServed": { "@@type": "AdministrativeArea", "name": "@JT("Kanton Zürich", "Canton of Zurich")" },
        "offers": [
            { "@@type": "Offer", "name": "@JT("Endreinigung 1–1.5 Zimmer", "End-of-lease cleaning 1–1.5 rooms")", "price": "550", "priceCurrency": "CHF", "description": "@JT("Fixpreis inkl. Abnahmegarantie", "Fixed price incl. handover guarantee")", "url": "@calcUrl" },
            { "@@type": "Offer", "name": "@JT("Endreinigung 2–2.5 Zimmer", "End-of-lease cleaning 2–2.5 rooms")", "price": "650", "priceCurrency": "CHF", "description": "@JT("Fixpreis inkl. Abnahmegarantie", "Fixed price incl. handover guarantee")", "url": "@calcUrl" },
            { "@@type": "Offer", "name": "@JT("Endreinigung 3–3.5 Zimmer", "End-of-lease cleaning 3–3.5 rooms")", "price": "850", "priceCurrency": "CHF", "description": "@JT("Fixpreis inkl. Abnahmegarantie", "Fixed price incl. handover guarantee")", "url": "@calcUrl" },
            { "@@type": "Offer", "name": "@JT("Endreinigung 4–4.5 Zimmer", "End-of-lease cleaning 4–4.5 rooms")", "price": "970", "priceCurrency": "CHF", "description": "@JT("Fixpreis inkl. Abnahmegarantie", "Fixed price incl. handover guarantee")", "url": "@calcUrl" },
            { "@@type": "Offer", "name": "@JT("Endreinigung 5–5.5 Zimmer", "End-of-lease cleaning 5–5.5 rooms")", "price": "1150", "priceCurrency": "CHF", "description": "@JT("Fixpreis inkl. Abnahmegarantie", "Fixed price incl. handover guarantee")", "url": "@calcUrl" },
            { "@@type": "Offer", "name": "@JT("Endreinigung 6–6.5 Zimmer", "End-of-lease cleaning 6–6.5 rooms")", "price": "1350", "priceCurrency": "CHF", "description": "@JT("Fixpreis inkl. Abnahmegarantie", "Fixed price incl. handover guarantee")", "url": "@calcUrl" }
        ]
    }
    </script>
}

@await Html.PartialAsync("_HeroH1")
@await Html.PartialAsync("_TrustBar")
@await Html.PartialAsync("_FixedPricing")
<section class="py-6 md:py-12 bg-muted/30">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        @await Html.PartialAsync("~/Views/Shared/_GoogleReviewsCarousel.cshtml", null, new ViewDataDictionary(ViewData) { ["MaxWidth"] = "max-w-5xl" })
    </div>
</section>
@await Html.PartialAsync("_VideoSection", null, new ViewDataDictionary(ViewData) { ["VideoPadding"] = "pt-3 pb-12 md:pt-6 md:pb-24" })
@await Html.PartialAsync("_HowItWorks")
@await Html.PartialAsync("_WhyChooseUs")
<div id="galerie" class="scroll-mt-16 md:scroll-mt-[6.25rem]">
    @await Html.PartialAsync("_LetzteEndreinigungen")
</div>
<section class="py-12 md:py-24" style="background: linear-gradient(180deg, hsl(210 10% 96%) 0%, hsl(210 10% 93%) 60%, hsl(0 0% 100%) 100%)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        @await Html.PartialAsync("_EndreinigungInfo")
    </div>
</section>
@await Html.PartialAsync("_PersonalPresenceBanner")
@await Html.PartialAsync("_Var2Services")
<div id="faq" class="scroll-mt-16 md:scroll-mt-[6.25rem]">
    @await Html.PartialAsync("_LP2FAQ")
</div>
@await Html.PartialAsync("_Contact")
@await Html.PartialAsync("~/Views/Shared/_Footer.cshtml")
