<!-- Why Choose Us -->
<section class="py-12 md:py-24 relative overflow-hidden" style="background: linear-gradient(180deg, hsl(210 95% 20%) 0%, hsl(210 92% 25%) 50%, hsl(210 90% 30%) 100%)">
    <div class="absolute inset-0 bg-black/5"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="text-center mb-8 md:mb-16">
            <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4 md:mb-6">
                @SharedLocalizer["why.title"] <span class="text-trust-gold">@SharedLocalizer["why.title_brand"]</span>?
            </h2>
            <p class="text-base md:text-xl text-white/80 max-w-3xl mx-auto">
                @SharedLocalizer["why.subtitle"]
            </p>
        </div>
        <!-- Benefits Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
            <!-- Benefit 1 -->
            <div class="text-center group animate-slide-up">
                <div class="relative mx-auto w-20 h-20 mb-6">
                    <div class="absolute inset-0 bg-white/20 rounded-2xl transform rotate-3 group-hover:rotate-6 transition-transform duration-300"></div>
                    <div class="relative bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl w-full h-full flex items-center justify-center shadow-card group-hover:shadow-hero transition-all duration-300">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </div>
                </div>
                <div class="inline-block bg-gradient-accent text-foreground text-sm font-medium px-3 py-1 rounded-full mb-4">@SharedLocalizer["why.b1_highlight"]</div>
                <h3 class="text-xl font-bold text-white mb-3">@SharedLocalizer["why.b1_title"]</h3>
                <p class="text-white/70 leading-relaxed">@SharedLocalizer["why.b1_desc"]</p>
            </div>
            <!-- Benefit 2 -->
            <div class="text-center group animate-slide-up" style="animation-delay: 150ms">
                <div class="relative mx-auto w-20 h-20 mb-6">
                    <div class="absolute inset-0 bg-white/20 rounded-2xl transform rotate-3 group-hover:rotate-6 transition-transform duration-300"></div>
                    <div class="relative bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl w-full h-full flex items-center justify-center shadow-card group-hover:shadow-hero transition-all duration-300">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </div>
                </div>
                <div class="inline-block bg-gradient-accent text-foreground text-sm font-medium px-3 py-1 rounded-full mb-4">@SharedLocalizer["why.b2_highlight"]</div>
                <h3 class="text-xl font-bold text-white mb-3">@SharedLocalizer["why.b2_title"]</h3>
                <p class="text-white/70 leading-relaxed">@SharedLocalizer["why.b2_desc"]</p>
            </div>
            <!-- Benefit 3 -->
            <div class="text-center group animate-slide-up" style="animation-delay: 300ms">
                <div class="relative mx-auto w-20 h-20 mb-6">
                    <div class="absolute inset-0 bg-white/20 rounded-2xl transform rotate-3 group-hover:rotate-6 transition-transform duration-300"></div>
                    <div class="relative bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl w-full h-full flex items-center justify-center shadow-card group-hover:shadow-hero transition-all duration-300">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                    </div>
                </div>
                <div class="inline-block bg-gradient-accent text-foreground text-sm font-medium px-3 py-1 rounded-full mb-4">@SharedLocalizer["why.b3_highlight"]</div>
                <h3 class="text-xl font-bold text-white mb-3">@SharedLocalizer["why.b3_title"]</h3>
                <p class="text-white/70 leading-relaxed">@SharedLocalizer["why.b3_desc"]</p>
            </div>
            <!-- Benefit 4 -->
            <div class="text-center group animate-slide-up" style="animation-delay: 450ms">
                <div class="relative mx-auto w-20 h-20 mb-6">
                    <div class="absolute inset-0 bg-white/20 rounded-2xl transform rotate-3 group-hover:rotate-6 transition-transform duration-300"></div>
                    <div class="relative bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl w-full h-full flex items-center justify-center shadow-card group-hover:shadow-hero transition-all duration-300">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4-4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                    </div>
                </div>
                <div class="inline-block bg-gradient-accent text-foreground text-sm font-medium px-3 py-1 rounded-full mb-4">@SharedLocalizer["why.b4_highlight"]</div>
                <h3 class="text-xl font-bold text-white mb-3">@SharedLocalizer["why.b4_title"]</h3>
                <p class="text-white/70 leading-relaxed">@SharedLocalizer["why.b4_desc"]</p>
            </div>
        </div>
    </div>
</section>
