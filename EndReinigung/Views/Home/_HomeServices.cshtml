<section class="section-pad">
    <div class="container-xl">
        <div class="text-center mb-5">
            <h2 class="fw-bold display-6 mb-3">Unsere <span class="text-swiss-blue">End-of-Lease</span> Services</h2>
            <p class="text-muted-foreground fs-5 mx-auto" style="max-width: 860px;">
                Professionelle Endreinigung nach Schweizer Standards. Wir übernehmen die komplette Reinigung damit Sie Ihre volle Kaution zurückerhalten.
            </p>
        </div>

        <div class="row g-4 mb-5">
            @{
                var services = new[]
                {
                        new { Title="Komplette Wohnungsreinigung", Desc="Professionelle Tiefenreinigung aller Räume nach Schweizer Mietrecht Standards",
                        Features = new[]{ "Alle Zimmer & Flure","Böden & Wandreinigung","Fenster innen & außen","Heizkörper & Lichtschalter"} },
                        new { Title="Küche & Sanitär Spezial", Desc="Intensive Reinigung von Küche und Badezimmer mit Entfettung und Entkalkung",
                        Features = new[]{ "Backofen & Herdplatten","Kühlschrank innen/außen","Badewanne & Dusche","WC & Armaturen"} },
                        new { Title="Keller & Balkon Service", Desc="Komplette Reinigung aller zur Wohnung gehörigen Bereiche",
                        Features = new[]{ "Keller- & Estrichräume","Balkon & Terrasse","Waschküche","Parkplatz & Garage"} },
                        };
            }
            @foreach (var s in services)
            {
                <div class="col-12 col-md-4">
                    <div class="p-4 p-lg-5 bg-gradient-card border border-token rounded-3 shadow-card h-100">
                        <h3 class="fw-bold h4 mb-3">@s.Title</h3>
                        <p class="text-muted-foreground mb-4">@s.Desc</p>
                        <ul class="list-unstyled mb-0">
                            @foreach (var f in s.Features)
                            {
                                <li class="d-flex align-items-center mb-2">
                                    <span class="me-2" style="color:var(--cleaning-green);">✔</span>
                                    <span>@f</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>

        <div class="bg-muted rounded-3 p-4 p-md-5">
            <div class="row g-4 align-items-center">
                <div class="col-md-8">
                    <h3 class="fw-bold h2 mb-3">Zusätzliche Services auf Anfrage</h3>
                    <div class="row g-2">
                        <div class="col-sm-6"><span style="color:var(--swiss-blue);" class="me-2">✔</span> Teppichreinigung</div>
                        <div class="col-sm-6"><span style="color:var(--swiss-blue);" class="me-2">✔</span> Polsterreinigung</div>
                        <div class="col-sm-6"><span style="color:var(--swiss-blue);" class="me-2">✔</span> Garten/Außenbereich</div>
                        <div class="col-sm-6"><span style="color:var(--swiss-blue);" class="me-2">✔</span> Express Same-Day</div>
                    </div>
                </div>
                <div class="col-md-4 text-center text-md-end">
                    <div class="d-inline-block bg-gradient-accent rounded-3 p-4">
                        <div class="fw-bold" style="font-size:2rem;">100%</div>
                        <div class="fw-semibold">Kautionsgarantie</div>
                        <div class="small text-muted mt-1">oder Geld zurück</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
