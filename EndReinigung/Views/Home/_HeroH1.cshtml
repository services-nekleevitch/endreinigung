<!-- Hero Section -->
<section class="relative h-screen bg-gradient-hero overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0">
        <img src="/img/zurich-cityscape.jpg" alt="Beautiful Zurich cityscape with Lake Zurich and Swiss Alps" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-hero opacity-75"></div>
        <div class="absolute inset-0 bg-black/20"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 flex items-center h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-[20vh] pb-8 sm:pt-[20vh] sm:pb-24">
            <div class="max-w-3xl">
                <!-- Badges -->
                <div class="flex flex-wrap gap-3 mb-3 sm:mb-6">
                    <div class="inline-flex items-center px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full border border-white/20 animate-fade-in">
                        <span class="text-white/90 text-sm font-medium">🌍 Expat Friendly</span>
                    </div>
                    <div class="inline-flex items-center px-4 py-2 bg-booking-orange rounded-full border border-booking-orange shadow-lg animate-fade-in animate-pulse">
                        <span class="text-white text-sm font-bold">✓ Wir sind bei der Abgabe dabei</span>
                    </div>
                    <div class="inline-flex items-center px-4 py-2 bg-cleaning-green rounded-full border border-cleaning-green shadow-lg animate-fade-in">
                        <span class="text-white text-sm font-bold">Fixpreis</span>
                    </div>
                </div>

                <!-- Main Headline -->
                <h1 class="text-3xl md:text-5xl font-bold text-white mb-2 md:mb-6 leading-tight animate-slide-up lg:text-5xl">
                    Endreinigung Zürich ✓
                    <br />
                    <span class="bg-gradient-accent bg-clip-text text-transparent">
                        Umzugsreinigung mit 100% Abnahmegarantie
                    </span>
                </h1>

                <!-- Bulleted Benefits -->
                <ul class="space-y-1.5 sm:space-y-3 mb-8 md:mb-10 animate-slide-up" style="animation-delay: 200ms">
                    <li class="flex items-center text-white/90 text-base md:text-xl">
                        <span class="mr-3 text-lg">✅</span>
                        <span class="font-medium">Schweizer Qualität &amp; faire Preise</span>
                    </li>
                    <li class="flex items-center text-white/90 text-base md:text-xl">
                        <span class="mr-3 text-lg">✅</span>
                        <span class="font-medium">Kaution zurück nach Ihrer Umzugsreinigung — garantiert</span>
                    </li>
                    <li class="flex items-center text-white/90 text-base md:text-xl">
                        <span class="mr-3 text-lg">✅</span>
                        <span class="font-medium">Professionelle Endreinigung in Zürich &amp; Umgebung</span>
                    </li>
                </ul>

                <!-- Service Selection Form -->
                <div class="relative bg-white/40 backdrop-blur-sm rounded-2xl border border-white/20 p-3 sm:p-8 animate-slide-up max-w-5xl mx-auto" style="animation-delay: 600ms">
                    <!-- Animated Badge -->
                    <div class="absolute -top-[50px] -right-[0px] sm:-top-[100px] sm:-right-[30px] z-50">
                        <a href="/calculator" class="relative w-[70px] h-[70px] sm:w-[120px] sm:h-[120px] flex items-center justify-center cursor-pointer">
                            <span class="absolute inset-0 rounded-full bg-booking-orange/75 animate-ping" style="animation-duration: 1.5s"></span>
                            <span class="absolute inset-0 rounded-full bg-booking-orange/50 animate-pulse" style="animation-duration: 2s"></span>
                            <div class="relative w-[70px] h-[70px] sm:w-[120px] sm:h-[120px] rounded-full bg-gradient-to-br from-[hsl(25,95%,53%)] to-[hsl(21,90%,48%)] border-2 sm:border-4 border-white shadow-2xl flex flex-col items-center justify-center hover:scale-110 transition-transform duration-200">
                                <span class="text-xl sm:text-4xl text-yellow-300 animate-pulse mb-0.5 sm:mb-1" style="animation-duration: 2s">⚡</span>
                                <span class="text-[8px] sm:text-xs font-black text-white leading-tight text-center uppercase tracking-wide">SOFORT<br/>PREIS!</span>
                            </div>
                        </a>
                    </div>

                    <form id="hero-form" class="grid grid-cols-1 md:grid-cols-[1.5fr_1fr_1fr] gap-6">
                        <!-- Wohnungsgröße Field -->
                        <div class="relative space-y-2">
                            <label class="text-white/90 text-sm font-medium">Wohnungsgrösse</label>
                            <div class="relative">
                                <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground pointer-events-none z-10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                <select id="hero-room-size" class="w-full h-14 rounded-2xl bg-white text-foreground pl-12 pr-4 focus:ring-2 focus:ring-booking-orange focus:border-booking-orange hover:border-booking-orange/50 transition-all duration-200 outline-none appearance-none text-base cursor-pointer border-2 border-border">
                                    <option value="">Zimmeranzahl wählen</option>
                                    <option value="1.5">1.5 Zimmer</option>
                                    <option value="2">2 Zimmer</option>
                                    <option value="2.5">2.5 Zimmer</option>
                                    <option value="3">3 Zimmer</option>
                                    <option value="3.5">3.5 Zimmer</option>
                                    <option value="4">4 Zimmer</option>
                                    <option value="4.5">4.5 Zimmer</option>
                                    <option value="5">5 Zimmer</option>
                                    <option value="5.5">5.5 Zimmer</option>
                                    <option value="6">6 Zimmer</option>
                                    <option value="6.5+">6.5+ Zimmer</option>
                                </select>
                            </div>
                        </div>

                        <!-- PLZ Field -->
                        <div class="relative space-y-2">
                            <label class="text-white/90 text-sm font-medium">PLZ</label>
                            <div class="relative">
                                <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0116 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                <input type="text" id="hero-zip-code" placeholder="z.B. 8001" maxlength="4" class="w-full h-14 rounded-2xl border-2 bg-white text-foreground pl-12 pr-4 placeholder:text-muted-foreground focus:ring-2 focus:ring-booking-orange focus:border-booking-orange hover:border-booking-orange/50 transition-all duration-200 outline-none text-base border-border" />
                            </div>
                        </div>

                        <!-- Calculate Button -->
                        <div class="space-y-2">
                            <label class="text-white/90 text-sm font-medium opacity-0 hidden md:block">Action</label>
                            <button type="submit" class="w-full h-14 text-base rounded-2xl bg-gradient-to-r from-booking-orange to-booking-orange-dark text-white font-semibold shadow-button hover:shadow-hero transition-all duration-200 hover:scale-105">
                                Jetzt Fixpreis sehen
                            </button>
                        </div>
                    </form>
                    <p id="hero-error" class="text-[13px] font-medium text-booking-orange-dark mt-2"></p>

                    <!-- Spacer -->
                    <div class="mt-4 sm:mt-6 pt-4 sm:pt-6"></div>
                </div>

