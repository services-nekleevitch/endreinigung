<!-- Video Section -->
<section class="py-12 md:py-24 bg-muted/30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-6 md:mb-10">
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-foreground mb-4">
                @SharedLocalizer["video.title_1"] <span class="text-swiss-blue">@SharedLocalizer["video.title_2"]</span>
            </h2>
            <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto">
                @SharedLocalizer["video.subtitle"]
            </p>
        </div>
        <div id="video-container" class="aspect-video rounded-xl md:rounded-2xl overflow-hidden shadow-lg border border-border relative bg-black">
            <button id="video-play-btn" type="button" class="w-full h-full relative group cursor-pointer" aria-label="Video abspielen">
                <img src="https://img.youtube.com/vi/wzJ0-m9MToc/hqdefault.jpg" alt="Endreinigung Video" class="w-full h-full object-cover" loading="lazy" />
                <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition-colors flex items-center justify-center">
                    <div class="w-20 h-20 rounded-full bg-red-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                        <svg class="w-10 h-10 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    </div>
                </div>
            </button>
        </div>
        <script>
            (function() {
                var btn = document.getElementById('video-play-btn');
                var container = document.getElementById('video-container');
                if (btn && container) {
                    btn.addEventListener('click', function() {
                        container.innerHTML = '<iframe class="w-full h-full" src="https://www.youtube.com/embed/wzJ0-m9MToc?hl=de&amp;cc_lang_pref=de&amp;autoplay=1" title="Endreinigung Video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
                    });
                }
            })();
        </script>
    </div>
</section>
