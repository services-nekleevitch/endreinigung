@{
    // Self-contained call-to-action card for a cleaning service, mirrors rich-lease-shine's BookingCard.tsx.
    // Optional overrides via ViewData["Rooms"] / ViewData["Price"], defaults match the React component.
    var rooms = ViewData["Rooms"] as string;
    var price = ViewData["Price"] as string;
    if (string.IsNullOrEmpty(rooms)) { rooms = "3–3.5 Zimmer"; }
    if (string.IsNullOrEmpty(price)) { price = "CHF 850"; }
}
<div class="flex flex-col max-h-[420px] h-[420px] w-full bg-navy text-navy-light border border-navy-border rounded-xl overflow-hidden">
    <div class="flex flex-col flex-1 min-h-0 p-5">
        <!-- Heading -->
        <h3 class="text-lg font-bold text-white leading-tight">
            Keine Zeit zum Putzen?
        </h3>

        <!-- Subline -->
        <p class="text-sm text-navy-text mt-1.5 leading-snug">
            Wir übernehmen die Endreinigung zum Fixpreis — mit 100% Abnahmegarantie.
        </p>

        <!-- Price block + calculator icon in the free space to the right -->
        <div class="mt-3 flex items-start justify-between gap-3">
            <div class="min-w-0">
                <span class="text-xs font-semibold uppercase tracking-wider text-navy-muted">
                    @rooms
                </span>
                <div class="flex items-baseline gap-2 -mt-0.5">
                    <span class="text-3xl font-bold text-white leading-none">
                        @price
                    </span>
                </div>
                <p class="text-xs text-navy-muted mt-1">
                    Anfahrt, Material und MwSt. inbegriffen
                </p>
            </div>

            <!-- Calculator icon — matches the page's blue-accent icon style -->
            <div class="shrink-0 mt-1 flex items-center justify-center w-11 h-11 rounded-full bg-primary/15 text-primary">
                <svg class="w-7 h-7 text-white rotate-45" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="10" y2="10"/><line x1="12" y1="10" x2="14" y2="10"/><line x1="16" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="10" y2="14"/><line x1="12" y1="14" x2="14" y2="14"/><line x1="16" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="10" y2="18"/><line x1="12" y1="18" x2="14" y2="18"/></svg>
            </div>
        </div>

        <!-- Bullets -->
        <ul class="mt-3 space-y-1.5 flex-1 min-h-0">
            <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-booking-orange mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span class="text-sm text-navy-light leading-snug">Abnahmegarantie — wir bessern kostenlos nach</span>
            </li>
            <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-booking-orange mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span class="text-sm text-navy-light leading-snug">Wir sind bei der Übergabe persönlich dabei</span>
            </li>
            <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-booking-orange mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span class="text-sm text-navy-light leading-snug">Fixpreis in 30 Sekunden, ohne Rückruf</span>
            </li>
        </ul>

        <!-- Buttons -->
        <div class="mt-3 flex flex-col gap-2">
            <a href="/calculator" class="w-full inline-flex items-center justify-center gap-2 bg-booking-orange text-navy font-semibold text-sm rounded-lg px-4 py-2.5 hover:bg-booking-orange-dark transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="10" y2="10"/><line x1="12" y1="10" x2="14" y2="10"/><line x1="16" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="10" y2="14"/><line x1="12" y1="14" x2="14" y2="14"/><line x1="16" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="10" y2="18"/><line x1="12" y1="18" x2="14" y2="18"/></svg>
                Fixpreis berechnen
            </a>
            <a href="tel:+41765017738" class="w-full inline-flex items-center justify-center gap-2 border border-navy-light/40 text-navy-light font-semibold text-sm rounded-lg px-4 py-2.5 hover:bg-navy-light/10 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                076 501 77 38
            </a>
        </div>

        <!-- Footer -->
        <p class="mt-2.5 text-center text-xs text-navy-muted">
            5.0 auf Google · Haftpflichtversichert
        </p>
    </div>
</div>
