                        <span class="text-xs text-muted-foreground mb-3">@T("Fixpreis", "Fixed price")</span>
                        <div class="flex items-center gap-3 mb-4">
                            <span class="inline-flex items-center gap-1 bg-secondary rounded-full px-2.5 py-1 text-xs font-medium">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> @T("4-8 Std", "4-8 hrs")
