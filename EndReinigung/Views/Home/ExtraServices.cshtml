                            <li class="flex items-center text-sm text-foreground/80"><svg class="w-4 h-4 mr-2.5 flex-shrink-0" style="color: #22c374;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>@T("Bad, WC & Entkalkung", "Bathroom, WC & descaling")</li>
                            <li class="flex items-center text-sm text-foreground/80"><svg class="w-4 h-4 mr-2.5 flex-shrink-0" style="color: #22c374;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>@T("Küche & alle Geräte", "Kitchen & all appliances")</li>
