                        <div class="aspect-[16/9] overflow-hidden"><img src="/img/services/bueroreinigung.jpg" alt="@T("Büroreinigung", "Office Cleaning")" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" /></div>
