@using System.Globalization
@{
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    string T(string de, string en) => lang == "en" ? en : de;

    ViewData["Title"] = T("Reinigungsservices Zürich ✓ 14 Services zum Fixpreis", "Cleaning Services Zurich ✓ 14 Services at Fixed Prices");
    ViewData["Description"] = T("Professionelle Reinigungsservices in Zürich: Baureinigung, Fensterreinigung, Teppichreinigung, Polsterreinigung, Airbnb und mehr. Jetzt Offerte anfordern.", "Professional cleaning services in Zurich: construction cleaning, window cleaning, carpet cleaning, upholstery cleaning, Airbnb and more. Request a quote now.");
    ViewData["Canonical"] = "https://zurich-endreinigung.ch/extra-services";
    ViewData["Keywords"] = T("Reinigungsservices Zürich, Baureinigung, Fensterreinigung, Teppichreinigung, Polsterreinigung, Zusatzleistungen Reinigung", "Cleaning Services Zurich, Construction Cleaning, Window Cleaning, Carpet Cleaning, Upholstery Cleaning, Additional Services");
}

@section Head {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "Start", "item": "https://zurich-endreinigung.ch/" },
            { "@@type": "ListItem", "position": 2, "name": "Zusatzservices", "item": "https://zurich-endreinigung.ch/extra-services" }
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Service",
        "@@id": "https://zurich-endreinigung.ch/extra-services#service",
        "url": "https://zurich-endreinigung.ch/extra-services",
        "inLanguage": "de-CH",
        "serviceType": "Zusatzservices",
        "name": "Zusatzservices Zürich – Komplettkatalog",
        "provider": { "@@id": "https://zurich-endreinigung.ch/#business" },
        "areaServed": { "@@type": "State", "name": "Kanton Zürich" },
        "offers": {
            "@@type": "AggregateOffer",
            "priceCurrency": "CHF",
            "lowPrice": 18,
            "highPrice": 1190,
            "offerCount": 11,
            "offers": [
                { "@@type": "Offer", "name": "Umzugsreinigung",                          "price": 550, "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/umzugsreinigung-zuerich" },
                { "@@type": "Offer", "name": "Frühlingsreinigung",                       "price": 390, "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/fruehlingsputz-zuerich" },
                { "@@type": "Offer", "name": "Baureinigung",                             "price": 25,  "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/extra-services" },
                { "@@type": "Offer", "name": "Fensterreinigung",                         "price": 249, "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/fensterreinigung" },
                { "@@type": "Offer", "name": "Tapeten entfernen",                        "price": 140, "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/tapeten-entfernen" },
                { "@@type": "Offer", "name": "Airbnb Reinigung",                         "price": 89,  "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/airbnb-reinigung-zuerich" },
                { "@@type": "Offer", "name": "Eventreinigung & Veranstaltungsreinigung", "price": 200, "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/event-reinigung" },
                { "@@type": "Offer", "name": "Boot Reinigung",                           "price": 250, "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/boot-reinigung" },
                { "@@type": "Offer", "name": "Polsterreinigung",                         "price": 120, "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/polsterreinigung" },
                { "@@type": "Offer", "name": "Teppichreinigung",                         "price": 18,  "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/teppichreinigung-zuerich" },
                { "@@type": "Offer", "name": "Matratzenreinigung",                       "price": 150, "priceCurrency": "CHF", "url": "https://zurich-endreinigung.ch/matratzenreinigung-zuerich" }
            ]
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "inLanguage": "de-CH",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "Wie buche ich mehrere Services gleichzeitig?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Über den Online-Preisrechner wählen Sie alle gewünschten Services aus und erhalten in unter 60 Sekunden einen Gesamtpreis. Bei Kombi-Buchungen sparen Sie bis zu 20 %. Alternativ nutzen Sie unser Kontaktformular für eine individuelle Offerte innert 24 h."
                }
            },
            {
                "@@type": "Question",
                "name": "Sind alle Preise inkl. Anfahrt und Material?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Ja. Alle Fixpreise auf dieser Seite enthalten Anfahrt im gesamten Kanton Zürich, alle Reinigungsmittel, Geräte und Verbrauchsmaterial. Es gibt keine versteckten Zuschläge — der Preis im Rechner ist der Preis auf der Rechnung."
                }
            },
            {
                "@@type": "Question",
                "name": "Gibt es Paketrabatte bei Kombi-Buchungen?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Ja: 10 % Rabatt bei einem Extra-Service zusätzlich zur Endreinigung, 15 % bei zwei und 20 % ab drei Extra-Services. Der Rabatt wird automatisch im Preisrechner angezeigt und gilt für alle hier gelisteten Services."
                }
            },
            {
                "@@type": "Question",
                "name": "Sind die Services MWST-frei?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Wir sind Kleinunternehmer im Sinne des MWSTG und stellen Rechnung ohne MWST. Das spart Ihnen 8.1 % gegenüber MWST-pflichtigen Anbietern. Geschäftskunden können die Rechnung trotzdem voll als Aufwand verbuchen."
                }
            },
            {
                "@@type": "Question",
                "name": "Welche Versicherung deckt eventuelle Schäden?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Alle Reinigungsservices sind durch unsere Betriebshaftpflicht über 5 Mio. CHF abgedeckt. Schäden an Mobiliar, Böden, Sanitär, Elektrogeräten oder Inventar werden vollständig ersetzt — unabhängig vom gebuchten Service."
                }
            }
        ]
    }
    </script>
}

<div class="min-h-screen bg-gray-50">

    <!-- Header Section -->
